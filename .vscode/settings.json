{
  "rust-analyzer.showUnlinkedFileNotification": true,
  "editor.formatOnSave": true,
  "rust-analyzer.checkOnSave": true,
  "bazel.lsp.command": "bazel-lsp",
  "testing.coverageToolbarEnabled": true,
  "bazel.buildifierFixOnFormat": true,
  // "rust-analyzer.check.overrideCommand": [
  //   "${workspaceFolder}/tools/rust_analyzer.sh",
  //   "$saved_file",
  //   "${workspaceFolder}"
  // ],
  // "rust-analyzer.cargo.target": "x86_64-linux-android",
  "rust-analyzer.workspace.discoverConfig": {
    "command": [
      "discover_bazel_rust_project.sh",
      "{arg}"
    ],
    "progressLabel": "rust_analyzer",
    "filesToWatch": [
      "BUILD",
      "BUILD.bazel",
      "MODULE.bazel"
    ]
  },
  "rust-analyzer.trace.server": "verbose",
  "rust-analyzer.check.command": "check",
  "rust-analyzer.server.extraEnv": {
    "RA_LOG": "info"
  },
  "rust-analyzer.linkedProjects": [
    "rust-project.json"
  ],
  // "rust-analyzer.workspace.discoverConfig": {
