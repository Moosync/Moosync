{
  // "code_lens": "on", -> enable this in your local zed config
  "format_on_save": "on",
  "languages": {
    "Starlark": {
      "formatter": {
        "external": {
          "arguments": ["-lint=fix", "-mode=fix", "-path", "{buffer_path}"],
          "command": "buildifier",
        },
      },
      "language_servers": ["bazel-lsp"],
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "extraEnv": {},
          "overrideCommand": [
            "bazel",
            "--output_base=/tmp/bazel/ra_output",
            "build",
            "//core/database",
            "//core/extensions",
            "//core/lyrics",
            "//core/mpris",
            "//core/player",
            "//core/plugin_macro",
            "//core/theme_macro",
            "//core/preferences",
            "//core/state_manager",
            "//core/themes",
            "//core/types",
            "//ui/slint:slint_app_lib",
            "--jobs",
            "32",
            "--@rules_rust//:error_format=json",
          ],
        },
        "checkOnSave": true,
        "linkedProjects": ["rust-project.json"],
        "showUnlinkedFileNotification": true,
        // "workspace": {
        //   "discoverConfig": {
        //     "command": ["./discover_bazel_rust_project.sh", "{arg}"],
        //     "filesToWatch": ["BUILD", "BUILD.bazel", "MODULE.bazel"],
        //     "progressLabel": "rust_analyzer",
        //   },
        // },
      },
    },
    "covhl": {
      "settings": {
        "enabled": true,
        "showHover": true,
        "showCodeLens": true,
        "autoRefresh": true,
        "alpha": 0.2,
        "coveragePath": "bazel-out/_coverage/_coverage_report.dat",
        "colors": {
          "covered": "#2ecc71",
          "uncovered": "rgba(231,76,60,0.35)",
          "partial": "hsl(48, 89%, 50%)",
        },
      },
    },
  },
  "file_scan_exclusions": [
    "bazel-out/[!\\_coverage]*",
    "bazel-bin",
    "bazel-Moosync",
    "...",
  ],
}
