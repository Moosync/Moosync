module(
    name = "moosync",
    version = "11.0.2",
)

bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "rules_rust", version = "0.68.1")
bazel_dep(name = "rules_rust_prost", version = "0.68.1")
bazel_dep(name = "protobuf", version = "34.1", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_rust_wasm_bindgen", version = "0.68.1")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "llvm", version = "0.6.1")  # For darwin cross-compile config flags
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
# Use preinstalled build tools instead of bootstrapping (avoids hermetic toolchain sandbox issues)
register_toolchains(
    "@rules_foreign_cc//toolchains:preinstalled_make_toolchain",
    "@rules_foreign_cc//toolchains:preinstalled_cmake_toolchain",
    "@rules_foreign_cc//toolchains:preinstalled_ninja_toolchain",
    "@rules_foreign_cc//toolchains:preinstalled_autoconf_toolchain",
    "@rules_foreign_cc//toolchains:preinstalled_automake_toolchain",
    "@rules_foreign_cc//toolchains:preinstalled_m4_toolchain",
    "@rules_foreign_cc//toolchains:preinstalled_pkgconfig_toolchain",
)
bazel_dep(name = "rules_perl", version = "0.5.0")
bazel_dep(name = "rules_python", version = "1.8.5")
bazel_dep(name = "aspect_rules_js", version = "3.0.3")
bazel_dep(name = "aspect_rules_ts", version = "3.8.1")
bazel_dep(name = "rules_nodejs", version = "6.7.3")
bazel_dep(name = "aspect_rules_rollup", version = "2.0.1")
bazel_dep(name = "gzgz_rules_sass", version = "1.0.4")
single_version_override(
    module_name = "gzgz_rules_sass",
    patch_strip = 1,
    patches = ["//patches:gzgz_rules_sass_bazel9.patch"],
    version = "1.0.4",
)
bazel_dep(name = "nasm", version = "2.16.03.bcr.2")
bazel_dep(name = "rules_cc", version = "0.2.17")
single_version_override(
    module_name = "rules_cc",
    patch_strip = 1,
    patches = ["//patches:rules_cc_apple_force_load.patch"],
    version = "0.2.17",
)
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_appimage", version = "1.19.0")
bazel_dep(name = "bazel_env.bzl", version = "0.5.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rpmpack", version = "0.6.0")
git_override(
    module_name = "rpmpack",
    commit = "2467806670a618497006ff8d8623b0430c7605a9",
    remote = "https://github.com/google/rpmpack.git",
)

# Android build rules
bazel_dep(name = "rules_android", version = "0.7.1")
bazel_dep(name = "rules_android_ndk", version = "0.1.3")

# Apple cross-compilation (Linux -> macOS)
bazel_dep(name = "rules_applecross", version = "0.0.3")
git_override(
    module_name = "rules_applecross",
    commit = "8eccb749a55d695b9669f84634b0d926622e86e7",
    remote = "https://github.com/apple-cross-toolchain/rules_applecross.git",
    patches = [
        "//patches:rules_applecross_cc_wrapper.patch",
        "//patches:rules_applecross_absolute_paths.patch",
        "//patches:rules_applecross_host_check.patch",
    ],
    patch_strip = 1,
)

# rules_applecross dependencies (nested overrides don't propagate)
bazel_dep(name = "xctestrunner", version = "0.0.1")
git_override(
    module_name = "xctestrunner",
    commit = "9548d93f29a2a93315d7a0458622682c0f76e6fe",
    remote = "https://github.com/apple-cross-toolchain/xctestrunner-bash.git",
)

include("//modules:external_deps.MODULE.bazel")
include("//modules:rust_toolchains.MODULE.bazel")
include("//modules:frontend_toolchains.MODULE.bazel")
include("//modules:apple_cross.MODULE.bazel")
include("//modules:crates.MODULE.bazel")
include("//modules:wasm_crates.MODULE.bazel")

rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps(
    ts_version_from = "//ui/gen_dist:package.json",
)
use_repo(rules_ts_ext, "npm_typescript")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "proto_npm",
    pnpm_lock = "//core/types/protos:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "proto_npm")

# Android NDK toolchain (optional - provides stub when NDK not installed)
android_ndk_optional = use_extension(
    "//tools:android_ndk_optional.bzl",
    "android_ndk_optional",
)
android_ndk_optional.configure(
    api_level = 26,  # minSdk from build.gradle.kts
)
use_repo(android_ndk_optional, "androidndk")

register_toolchains("@androidndk//:all")

# Tauri crate discovery - resolves @crates//:tauri to get actual repo name
tauri_ext = use_extension("//tools:tauri_crate.bzl", "tauri_extension")
use_repo(tauri_ext, "tauri_crate")
