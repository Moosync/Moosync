module(
    name = "moosync",
    version = "11.0.2",
)

bazel_dep(name = "rules_rust", version = "0.73.0")
single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = ["//patches:rules_rust_gnu_windows.patch"],
    version = "0.73.0",
)

single_version_override(
    module_name = "rules_android_ndk",
    patch_strip = 1,
    patches = ["//patches:rules_android_ndk_dummy.patch"],
)

bazel_dep(name = "rules_rust_prost", version = "0.73.0")
bazel_dep(name = "protobuf", version = "36.0", repo_name = "com_google_protobuf")
single_version_override(
    module_name = "protobuf",
    version = "36.0",
)

bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "rules_perl", version = "1.1.2")
bazel_dep(name = "rules_python", version = "2.3.2")
bazel_dep(name = "nasm", version = "2.16.03.bcr.3")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_android", version = "0.7.3")
bazel_dep(name = "rules_kotlin", version = "2.4.10")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_appimage", version = "1.20.0")
bazel_dep(name = "bazel_env.bzl", version = "0.8.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3")
bazel_dep(name = "rules_buf", version = "0.5.2")
bazel_dep(name = "rpmpack", version = "0.6.0")
git_override(
    module_name = "rpmpack",
    commit = "2467806670a618497006ff8d8623b0430c7605a9",
    patch_strip = 1,
    patches = ["//patches:rpmpack.patch"],
    remote = "https://github.com/google/rpmpack.git",
)

include("//modules:external_deps.MODULE.bazel")
include("//modules:rust_toolchains.MODULE.bazel")
include("//modules:crates.MODULE.bazel")
include("//modules:android_toolchains.MODULE.bazel")

register_toolchains(
    "//:shell_android_x86_64_toolchain",
    "//:shell_android_arm64_toolchain",
    "@rules_foreign_cc//toolchains:preinstalled_pkgconfig_toolchain",
)

sh_configure = use_extension("@rules_shell//shell/private/extensions:sh_configure.bzl", "sh_configure")
use_repo(sh_configure, "local_config_shell")

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.53.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.0")
use_repo(go_sdk, "go_toolchains")

register_toolchains("@go_toolchains//:all")

buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(version = "v1.72.0")
use_repo(buf, "rules_buf_toolchains")

bazel_dep(name = "moosync_ext", version = "0.0.1")
git_override(
    module_name = "moosync_ext",
    branch = "bazel",
    remote = "https://github.com/Moosync/moosync-exts",
)

bazel_dep(name = "extensions_sdk")
git_override(
    module_name = "extensions_sdk",
    branch = "main",
    remote = "https://github.com/Moosync/extensions-sdk",
)
