<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.moosync.android">

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="34" />

    <uses-feature android:glEsVersion="0x00020000" android:required="true"/>

    <!-- Foreground service permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Network access for streaming thumbnails -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:hasCode="true">

        <!-- NativeActivity hosts the Slint/Rust UI via the slint_app shared library -->
        <activity
            android:name="app.moosync.android.MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|density">

            <meta-data
                android:name="android.app.lib_name"
                android:value="slint_app" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Media foreground service for notification + MediaSession -->
        <service
            android:name="app.moosync.android.services.MoosyncService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Receives hardware media button events and routes them to the MediaSession -->
        <receiver android:name="app.moosync.android.services.MediaButtonIntentReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
