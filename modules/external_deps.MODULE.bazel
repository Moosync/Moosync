http_archive(
    name = "mingw_compiler_files",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load("@moosync//tools/toolchains/mingw:cc_toolchain_config.bzl", "mingw_cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_files",
    srcs = glob(["**"]),
)

mingw_cc_toolchain_config(
    name = "mingw_cc_toolchain_config",
)

cc_toolchain(
    name = "mingw_cc",
    all_files = ":all_files",
    compiler_files = ":all_files",
    dwp_files = ":all_files",
    linker_files = ":all_files",
    objcopy_files = ":all_files",
    strip_files = ":all_files",
    supports_param_files = 0,
    toolchain_config = ":mingw_cc_toolchain_config",
    toolchain_identifier = "mingw-toolchain",
)

toolchain(
    name = "mingw_cc_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":mingw_cc",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)
""",
    patch_cmds = [
        "cp x86_64-w64-mingw32/lib/libunwind.a x86_64-w64-mingw32/lib/libgcc.a",
        "cp x86_64-w64-mingw32/lib/libunwind.a x86_64-w64-mingw32/lib/libgcc_eh.a",
    ],
    sha256 = "9d191203f9768ead60662d3ae53cdf28e0a28b1e6d44b7f329b9202cb2add337",
    strip_prefix = "llvm-mingw-20260602-ucrt-ubuntu-22.04-x86_64",
    urls = ["https://github.com/mstorsjo/llvm-mingw/releases/download/20260602/llvm-mingw-20260602-ucrt-ubuntu-22.04-x86_64.tar.xz"],
)

register_toolchains("@mingw_compiler_files//:mingw_cc_toolchain")

register_toolchains(
    "//tools/toolchains/mingw:custom_make_toolchain",
    "//tools/toolchains/mingw:custom_m4_toolchain",
)
