cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    build_script_env = {
        "CARGO_PKG_NAME": "slint_app",
        "SLINT_EMIT_DEBUG_INFO": "1",
    },
    data = SLINT_DATA,
    deps = ["@crates//:slint-build"],
)

