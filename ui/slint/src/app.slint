import { Sidebar, SidebarItem } from "sidebar/sidebar.slint";
import { TopBar, TopBarProps } from "topbar/top_bar.slint";
import { BottomBar } from "bottombar/bottom_bar.slint";
import { AllSongs, AllSongsPageProps } from "main_content/all_songs.slint";
import { WindowInfo } from "window_info.slint";
import {
    SongModel,
    CoverHelper,
    AlbumModel,
    PlaylistModel,
    ArtistModel,
    GenreModel,
    SearchResult,
    ProviderRecommendations,
    SongSortCriterion,
} from "types/song_view.slint";
import { MenuItem, PopupMenu } from "common/popup_menu.slint";
import { AlbumsPage, AlbumsPageProps } from "main_content/albums.slint";
import { ArtistsPage, ArtistsPageProps } from "main_content/artists.slint";
import {
    PlaylistsPage,
    PlaylistsPageProps,
} from "main_content/playlists.slint";
import { GenresPage, GenresPageProps } from "main_content/genres.slint";
import { ExplorePage, ExplorePageProps } from "main_content/explore.slint";
import { SearchPage, SearchPageProps } from "main_content/search.slint";
import { SongListView } from "common/song_list_view.slint";
import { QueuePage, QueuePageProps } from "main_content/queue_page.slint";
import {
    PlaylistContent,
    PlaylistContentPageProps,
} from "main_content/playlist_content.slint";
import {
    AlbumContent,
    AlbumContentPageProps,
} from "main_content/album_content.slint";
import {
    ArtistContent,
    ArtistContentPageProps,
} from "main_content/artist_content.slint";
import {
    GenreContent,
    GenreContentPageProps,
} from "main_content/genre_content.slint";
import {
    Pages,
    SettingsPages,
    QueuePages,
    Constants,
    Theme,
    ThemeConfig,
    RgbaColor,
    ThemeConstant,
} from "constants.slint";
import {
    AppCallbacks,
    BottomBarCallbacks,
    ContextMenuCallbacks,
    UtilCallbacks,
    PreferenceChange,
    SortDecision,
} from "callbacks.slint";
import { Settings, SettingsState } from "settings/settings.slint";
import {
    SavePlaylistModal,
    SavePlaylistState,
} from "common/save_playlist_modal.slint";
import { SaveThemeModal, SaveThemeState } from "common/save_theme_modal.slint";
import { PageWrapper } from "common/page_wrapper.slint";
import { ContextMenuItem, ContextMenuItems } from "types/context_menu.slint";
import { AccountsProps } from "common/accounts_popup.slint";
import {
    Preferences,
    AppPreferences,
    PreferenceItem,
    RadioItem,
} from "settings/preferences.slint";
import {
    ExtensionItem,
    ExtensionProviderItem,
    AccountItem,
} from "./types/extension_view.slint";
import { ExtensionsPageProps } from "settings/extensions.slint";
import { ThemesPageProps } from "settings/themes.slint";
import { Utils, DefaultIconType } from "utils.slint";
import { OAuthModal, OAuthState } from "common/oauth_modal.slint";
import { PlayerProps, AppProps } from "props.slint";

export {
    PlayerProps,
    AppProps,
    TopBarProps,
    SettingsState,
    ThemesPageProps,
    ExtensionsPageProps,
    OAuthState,
    SavePlaylistState,
    SaveThemeState,
    Utils,
    DefaultIconType,
    CoverHelper,
    Constants,
    Theme,
    SongModel,
    AlbumModel,
    PlaylistModel,
    ArtistModel,
    GenreModel,
    SearchResult,
    ProviderRecommendations,
    Pages,
    AppCallbacks,
    BottomBarCallbacks,
    ContextMenuCallbacks,
    UtilCallbacks,
    Preferences,
    AppPreferences,
    PreferenceChange,
    SortDecision,
    PreferenceItem,
    RadioItem,
    ThemeConfig,
    RgbaColor,
    ExtensionItem,
    ExtensionProviderItem,
    AccountItem,
    ThemeConstant,
    SettingsPages,
    QueuePages,
    PlaylistsPageProps,
    PlaylistContentPageProps,
    ArtistsPageProps,
    ArtistContentPageProps,
    AlbumsPageProps,
    AlbumContentPageProps,
    GenresPageProps,
    GenreContentPageProps,
    AllSongsPageProps,
    SearchPageProps,
    ExplorePageProps,
    QueuePageProps,
    SongSortCriterion,
    MenuItem,
    ContextMenuItem,
    ContextMenuItems,
    AccountsProps,
}
export component MainWindow inherits Window {
    title: "moosync";
    background: Theme.primary; // Sampled Topbar/Main background

    changed width => {
        WindowInfo.window-width = self.width;
        if (self.width < 600px) {
            WindowInfo.window-size = WindowInfo.sm;
        } else if (self.width < 900px) {
            WindowInfo.window-size = WindowInfo.md;
        } else if (self.width < 1200px) {
            WindowInfo.window-size = WindowInfo.lg;
        } else {
            WindowInfo.window-size = WindowInfo.xl;
        }
        AppCallbacks.resize();
    }

    changed height => {
        WindowInfo.window-height = self.height;
        AppCallbacks.resize();
    }

    VerticalLayout {
        spacing: 0px;
        padding: 0px;
        height: 100%;
        width: 100%;

        // Container for upper section and sliding queue overlay
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            // Upper section containing Sidebar and main content area with TopBar
            HorizontalLayout {
                spacing: 0px;
                width: 100%;
                height: 100%;

                Sidebar { }

                VerticalLayout {
                    spacing: 0px;

                    TopBar { }

                    // Main Content Area
                    Rectangle {
                        background: Theme.primary; // Primary
                        clip: true;

                        TouchArea {
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    if (event.button == PointerEventButton.back) {
                                        AppCallbacks.navigate_back();
                                    } else if (event.button == PointerEventButton.forward) {
                                        AppCallbacks.navigate_forward();
                                    }
                                }
                            }
                        }

                        PageWrapper {
                            page-type: Pages.Search;
                            active-page <=> AppProps.active_page;
                            SearchPage { }
                        }

                        PageWrapper {
                            page-type: Pages.AllSongs;
                            active-page <=> AppProps.active_page;
                            AllSongs { }
                        }

                        PageWrapper {
                            page-type: Pages.Playlists;
                            active-page <=> AppProps.active_page;
                            PlaylistsPage { }
                        }

                        PageWrapper {
                            page-type: Pages.PlaylistContent;
                            active-page <=> AppProps.active_page;
                            PlaylistContent { }
                        }

                        PageWrapper {
                            page-type: Pages.Artists;
                            active-page <=> AppProps.active_page;
                            ArtistsPage { }
                        }

                        PageWrapper {
                            page-type: Pages.ArtistContent;
                            active-page <=> AppProps.active_page;
                            ArtistContent { }
                        }

                        PageWrapper {
                            page-type: Pages.Albums;
                            active-page <=> AppProps.active_page;
                            AlbumsPage { }
                        }

                        PageWrapper {
                            page-type: Pages.AlbumContent;
                            active-page <=> AppProps.active_page;
                            AlbumContent { }
                        }

                        PageWrapper {
                            page-type: Pages.Genres;
                            active-page <=> AppProps.active_page;
                            GenresPage { }
                        }

                        PageWrapper {
                            page-type: Pages.GenreContent;
                            active-page <=> AppProps.active_page;
                            GenreContent { }
                        }

                        PageWrapper {
                            page-type: Pages.Explore;
                            active-page <=> AppProps.active_page;
                            ExplorePage { }
                        }
                    }
                }
            }

            // Slide-up queue page overlay
            QueuePage {
                y: QueuePageProps.show_queue ? 0px : parent.height;
                width: 100%;
                height: 100%;

                animate y {
                    duration: 250ms;
                    easing: ease-in-out;
                }
            }
        }

        // Bottom player controller section
        BottomBar { }
    }

    if SettingsState.show_settings: Settings {
        close => {
            SettingsState.show_settings = false;
        }
    }

    if SavePlaylistState.show_modal: SavePlaylistModal {
        close => {
            SavePlaylistState.show_modal = false;
        }
    }

    if OAuthState.show_oauth_modal: OAuthModal {
        oauth_url: OAuthState.oauth_url;
        oauth_code <=> OAuthState.oauth_code;
        submit_code(code) => {
            AppCallbacks.submit_oauth_code(code);
        }
        close => {
            OAuthState.show_oauth_modal = false;
        }
    }
}
