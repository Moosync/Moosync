// Special large circular Play/Pause button
export component PlayButton inherits Rectangle {
    in property <bool> playing: false;

    width: Theme.playbackControlsIconSize * 2;
    height: Theme.playbackControlsIconSize * 2;
    border-radius: Theme.playbackControlsIconSize;
    background: touch.has-hover ? Theme.accent.with-alpha(0.1) : transparent;

    animate background { duration: 150ms; }

    touch := TouchArea { }

    Rectangle {
        width: Theme.playbackControlsIconSize * 2;
        height: Theme.playbackControlsIconSize * 2;

        // Outer green circle (from play_icon.rs)
        Path {
            width: Theme.playbackControlsIconSize * 2;
            height: Theme.playbackControlsIconSize * 2;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 41;
            viewbox-height: 42;
            stroke: Theme.accent;
            stroke-width: 1.3458px;
            commands: "M 20.6869 40.514 C 31.4644 40.514 40.2 31.7784 40.2 21 C 40.2 10.2216 31.4644 1.486 20.6869 1.486 C 9.9094 1.486 1.1729 10.2216 1.1729 21 C 1.1729 31.7784 9.9094 40.514 20.6869 40.514 Z";
        }

        // Pause bars (from play_icon.rs)
        if (playing): Rectangle {
            Path {
                width: Theme.playbackControlsIconSize * 2;
                height: Theme.playbackControlsIconSize * 2;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 41;
                viewbox-height: 42;
                stroke: Theme.accent;
                stroke-width: 3px;
                commands: "M16 13L16 28";
            }

            Path {
                width: Theme.playbackControlsIconSize * 2;
                height: Theme.playbackControlsIconSize * 2;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 41;
                viewbox-height: 42;
                stroke: Theme.accent;
                stroke-width: 3px;
                commands: "M25 13L25 28";
            }
        }

        // Play triangle (from play_icon.rs)
        if (!playing): Path {
            width: Theme.playbackControlsIconSize * 2;
            height: Theme.playbackControlsIconSize * 2;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 41;
            viewbox-height: 42;
            fill: Theme.accent;
            stroke: Theme.accent;
            stroke-width: 1.3458px;
            commands: "M16.2775 14.3421C16.0689 14.2378 15.8212 14.249 15.6228 14.3716C15.4244 14.4942 15.3037 14.7108 15.3037 14.944V27.0561C15.3037 27.2893 15.4244 27.5059 15.6228 27.6285C15.8212 27.7511 16.0689 27.7623 16.2775 27.658L28.3897 21.6017C28.6176 21.4877 28.7616 21.2547 28.7616 20.9998C28.7616 20.745 28.6176 20.512 28.3896 20.398L16.2775 14.3421Z";
        }
    }
}

export component PlaybackControls inherits VerticalLayout {
    spacing: Theme.spacingLg;
    alignment: center;

    HorizontalLayout {
        HorizontalLayout {
            padding-right: Theme.paddingLg;
            Text {
                text: "3:32 / 6:10";
                color: Theme.textSecondary; // Text Secondary
                font-size: Theme.caption;
                vertical-alignment: center;
            }
        }

        alignment: center;
        PlaybackButton {
            icon-name: "prev";
        }

        PlaybackButton {
            icon-name: "loop";
            active: true;
        } // Green repeat active in screenshot

        PlayButton {
            playing: false;
        }

        PlaybackButton {
            icon-name: "next";
        }

        PlaybackButton {
            icon-name: "shuffle";
        }

        PlaybackButton {
            icon-name: "heart";
        }
    }
}
