import { Theme } from "../constants.slint";

export component PlaybackButton inherits Rectangle {
    in property <string> icon-name;
    in property <bool> active: false;

    width: Theme.playbackButtonSize;
    height: Theme.playbackButtonSize;
    border-radius: Theme.playbackButtonSize / 2;
    background: touch.has-hover ? Theme.textPrimary.with-alpha(0.05) : transparent;

    animate background { duration: 150ms; }

    property <color> current-color: active ? Theme.accent : (touch.has-hover ? Theme.textPrimary : Theme.textSecondary);
    animate current-color { duration: 150ms; }

    touch := TouchArea { }

    Rectangle {
        width: Theme.playbackControlsIconSize;
        height: Theme.playbackControlsIconSize;

        // Previous Track (from prev_track_icon.rs)
        if (icon-name == "prev"): Path {
            width: Theme.playbackControlsIconSize;
            height: Theme.playbackControlsIconSize;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 24;
            viewbox-height: 16;
