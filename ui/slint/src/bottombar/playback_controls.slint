import { Theme } from "../constants.slint";
import { BottomBarCallbacks } from "../callbacks.slint";
import { Button } from "../common/button.slint";
import { PlayerProps } from "../props.slint";

export component PlaybackButton inherits Button {
    in property <image> icon_source;
    in property <image> active_icon_source: root.icon_source;
    in property <bool> active: false;

    has_custom_layout: true;
    width: Theme.playbackButtonSize;
    height: Theme.playbackButtonSize;
    border-radius: Theme.playbackButtonSize / 2;
    background: root.has_hover ? Theme.textPrimary.with-alpha(0.05) : transparent;

    property <color> current_color: active ? Theme.accent : (root.has_hover ? Theme.textPrimary : Theme.textSecondary);
    animate current_color { duration: 150ms; }

    Rectangle {
        width: Theme.playbackControlsIconSize;
        height: Theme.playbackControlsIconSize;

        Image {
            width: Theme.playbackControlsIconSize;
            height: Theme.playbackControlsIconSize;
            image-fit: contain;
            source: root.active ? root.active_icon_source : root.icon_source;
            colorize: root.current_color;
        }
    }
}

// Special large circular Play/Pause button
export component PlayButton inherits Button {
    in property <bool> playing: false;

    accessible-label: root.playing ? @tr("Pause") : @tr("Play");
    has_custom_layout: true;
    width: Theme.playbackControlsIconSize * 2;
    height: Theme.playbackControlsIconSize * 2;
    border-radius: Theme.playbackControlsIconSize;
    background: root.has_hover ? Theme.accent.with-alpha(0.1) : transparent;

    Rectangle {
        width: Theme.playbackControlsIconSize * 2;
        height: Theme.playbackControlsIconSize * 2;

        Image {
            width: Theme.playbackControlsIconSize * 2;
            height: Theme.playbackControlsIconSize * 2;
            image-fit: contain;
            source: root.playing ? @image-url("../icons/playback_pause.svg") : @image-url("../icons/playback_play.svg");
            colorize: Theme.accent;
        }
    }
}


export component PlaybackControls inherits VerticalLayout {
    property <int> repeat_mode: PlayerProps.repeat_mode;
    property <bool> playing: PlayerProps.playing;
    property <string> current_pos_str: PlayerProps.current_pos_str;
    property <string> duration_str: PlayerProps.current_song.duration-str;

    spacing: Theme.spacingLg;
    alignment: center;

    HorizontalLayout {
        HorizontalLayout {
            padding-right: Theme.paddingLg;
            Text {
                text: root.current_pos_str + " / " + (root.duration_str != "" ? root.duration_str : "00:00");
                color: Theme.textSecondary; // Text Secondary
                font-size: Theme.caption;
                vertical-alignment: center;
            }
        }

        alignment: center;
        PlaybackButton {
            accessible-label: @tr("Previous");
            icon_source: @image-url("../icons/prev.svg");
            clicked => {
                BottomBarCallbacks.prev-song()
            }
        }

        PlaybackButton {
            accessible-label: @tr("Repeat");
            icon_source: @image-url("../icons/repeat.svg");
            active: root.repeat_mode != 0;
            clicked => {
                BottomBarCallbacks.toggle-repeat();
            }
        }

        PlayButton {
            playing: root.playing;
            clicked => {
                BottomBarCallbacks.play-pause-clicked();
            }
        }

        PlaybackButton {
            accessible-label: @tr("Next");
            icon_source: @image-url("../icons/next.svg");
            clicked => {
                BottomBarCallbacks.next-song()
            }
        }

        PlaybackButton {
            accessible-label: @tr("Shuffle");
            icon_source: @image-url("../icons/shuffle.svg");
            clicked => {
                BottomBarCallbacks.shuffle()
            }
        }

        PlaybackButton {
            accessible-label: @tr("Favorite");
            icon_source: @image-url("../icons/heart.svg");
            active_icon_source: @image-url("../icons/heart_filled.svg");
        }
    }
}
