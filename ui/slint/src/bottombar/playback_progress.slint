import { Theme } from "../constants.slint";

export component PlaybackProgressBar inherits Rectangle {
    in-out property <float> progress: 0.58; // 0.0 to 1.0 representing 3:32 / 6:10 (approx 58%)
    
    height: Theme.progressBarHeight;
    background: transparent;
    
    touch := TouchArea {}
    
    // Background rail (gray)
    Rectangle {
        y: (parent.height - Theme.sliderTrackHeight) / 2;
        height: Theme.sliderTrackHeight;
        background: Theme.textSecondary; // Text Secondary
        border-radius: Theme.borderRadiusSm;
    }
    
    // Active rail (green)
    Rectangle {
        x: 0px;
        y: (parent.height - Theme.sliderTrackHeight) / 2;
        width: parent.width * progress;
        height: Theme.sliderTrackHeight;
        background: Theme.accent; // Accent
        border-radius: Theme.borderRadiusSm;
    }
    
    // Slider thumb (white circle)
    Rectangle {
        x: (parent.width * progress) - Theme.sliderThumbSize / 2;
        y: (parent.height - Theme.sliderThumbSize) / 2;
        width: Theme.sliderThumbSize;
        height: Theme.sliderThumbSize;
        border-radius: Theme.sliderThumbSize / 2;
        background: Theme.textPrimary;
        border-width: 1.5px;
        border-color: Theme.primary; // Matching player bar background
        
        // Slightly enlarge thumb on hover
        animate width, height, x, y { duration: 100ms; }
        
        states [
            hover when touch.has-hover: {
                width: Theme.sliderThumbHoverSize;
                height: Theme.sliderThumbHoverSize;
                x: (parent.width * progress) - Theme.sliderThumbHoverSize / 2;
                y: (parent.height - Theme.sliderThumbHoverSize) / 2;
            }
        ]
    }
}
