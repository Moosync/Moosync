import { Theme } from "../constants_mobile.slint";
import { BottomBarCallbacks } from "../callbacks.slint";
import { PlayerProps } from "playback_props.slint";

export component PlaybackProgressBarMobile inherits VerticalLayout {
    property <int> current_duration: PlayerProps.current_duration;
    property <int> total_duration: PlayerProps.current_song.duration-s;
    property <float> progress: root.current_duration / Math.max(root.total_duration, 1);

    vertical-stretch: 0;
    spacing: Theme.spacingXs;

    // Scrubber track container
    Rectangle {
        vertical-stretch: 0;
        height: Theme.mobileSliderHeight;

        touch := TouchArea {
            accessible-role: slider;
            accessible-label: "Playback Progress";
            width: 100%;
            height: 100%;

            clicked => {
                BottomBarCallbacks.seek(Math.max(0, Math.min(root.total_duration, Math.round((self.mouse-x / self.width) * root.total_duration))));
            }

            moved => {
                if (self.pressed) {
                    BottomBarCallbacks.seek(Math.max(0, Math.min(root.total_duration, Math.round((self.mouse-x / self.width) * root.total_duration))));
                }
            }
        }

        // Rail background
        Rectangle {
            y: (parent.height - Theme.mobilePlaybackSliderTrackHeight) / 2;
            height: Theme.mobilePlaybackSliderTrackHeight;
            width: 100%;
            background: Theme.textSecondary.with-alpha(0.35);
            border-radius: Theme.spacingTiny;
        }

        // Active rail
        Rectangle {
            x: 0px;
            y: (parent.height - Theme.mobilePlaybackSliderTrackHeight) / 2;
            width: parent.width * Math.min(1.0, Math.max(0.0, root.progress));
            height: Theme.mobilePlaybackSliderTrackHeight;
            background: Theme.accent;
            border-radius: Theme.spacingTiny;
        }

        // Thumb
        Rectangle {
            x: (parent.width * Math.min(1.0, Math.max(0.0, root.progress))) - Theme.spacingXs;
            y: (parent.height - Theme.iconSizeMd) / 2;
            width: Theme.iconSizeMd;
            height: Theme.iconSizeMd;
            border-radius: Theme.borderRadiusLg;
            background: Theme.textPrimary;
            border-width: Theme.spacingTiny;
            border-color: Theme.accent;
        }
    }

    // Time labels
    HorizontalLayout {
        Text {
            text: PlayerProps.current_pos_str != "" ? PlayerProps.current_pos_str : "00:00";
            font-size: Theme.caption;
            color: Theme.textSecondary;
            horizontal-stretch: 1;
        }

        Text {
            text: PlayerProps.current_song.duration-str != "" ? PlayerProps.current_song.duration-str : "00:00";
            font-size: Theme.caption;
            color: Theme.textSecondary;
            horizontal-alignment: right;
        }
    }
}
