import { Pages, SettingsPages, Constants } from "constants.slint";
import {
    SongModel,
    SearchResult,
    SongDetailAction,
    SongSortCriterion,
    MenuItem,
} from "./types/song_view.slint";

export struct PreferenceChange {
    id: string,
    value_string: string,
    value_bool: bool,
    value_number: float,
}

export struct SortDecision {
    criterion: SongSortCriterion,
    ascending: bool,
}

export global AppCallbacks {
    callback search_term_changed(string);
    callback resize();
    callback active-page-changed(Pages);
    callback play-song(SongModel);
    callback add-song-to-queue(SongModel);
    callback song_detail_action(SongDetailAction, [SongModel]);
    callback preference_changed(PreferenceChange);
    callback open_directory_picker() -> string;
    callback open_file_picker(string) -> string;
    callback theme_constant_changed(string, string);
    callback save_custom_theme(string, string, string);
    callback select_preset_theme(string);
    callback install_extension(string);
    callback toggle_extension(string);

    // Queue & Drag-and-Drop Callbacks
    callback play-queue-index(int);
    callback remove-from-queue(int);
    callback clear-queue();
    callback move-queue-item(string, int);
    pure callback string-to-transfer(string) -> data-transfer;
    pure callback transfer-to-string(data-transfer) -> string;

    // Page Lifecycle Decoupling Callbacks
    callback settings-active-page-changed(SettingsPages);
    callback settings-toggled(bool);
    callback queue-toggled(bool);

    // Song List Filter & Sort Callbacks and Functions
    pure callback filter_and_sort_songs([SongModel], string, SongSortCriterion, bool) -> [SongModel];

    pure public function decide_sort_criterion(id: string) -> SongSortCriterion {
        if (id == "date") { return SongSortCriterion.Date; }
        if (id == "album") { return SongSortCriterion.Album; }
        if (id == "track") { return SongSortCriterion.TrackNumber; }
        if (id == "artist") { return SongSortCriterion.Artist; }
        return SongSortCriterion.Title;
    }

    pure public function decide_sort_ascending(current_criterion: SongSortCriterion, current_ascending: bool, id: string) -> bool {
        if (id == "title" && current_criterion == SongSortCriterion.Title) { return !current_ascending; }
        if (id == "date" && current_criterion == SongSortCriterion.Date) { return !current_ascending; }
        if (id == "album" && current_criterion == SongSortCriterion.Album) { return !current_ascending; }
        if (id == "track" && current_criterion == SongSortCriterion.TrackNumber) { return !current_ascending; }
        if (id == "artist" && current_criterion == SongSortCriterion.Artist) { return !current_ascending; }
        return true;
    }

    pure public function get_sort_menu_items(active_criterion: SongSortCriterion) -> [MenuItem] {
        return [
            {
                id: "title",
                title: @tr("Title"),
                icon: @image-url(""),
                is-selected: active_criterion == SongSortCriterion.Title,
                is-divider: false,
                is-danger: false,
            },
            {
                id: "date",
                title: @tr("Date"),
                icon: @image-url(""),
                is-selected: active_criterion == SongSortCriterion.Date,
                is-divider: false,
                is-danger: false,
            },
            {
                id: "album",
                title: @tr("Album"),
                icon: @image-url(""),
                is-selected: active_criterion == SongSortCriterion.Album,
                is-divider: false,
                is-danger: false,
            },
            {
                id: "track",
                title: @tr("Track Number"),
                icon: @image-url(""),
                is-selected: active_criterion == SongSortCriterion.TrackNumber,
                is-divider: false,
                is-danger: false,
            },
            {
                id: "artist",
                title: @tr("Artist"),
                icon: @image-url(""),
                is-selected: active_criterion == SongSortCriterion.Artist,
                is-divider: false,
                is-danger: false,
            },
        ];
    }
}

export global BottomBarCallbacks {
    callback play-pause-clicked();
    callback toggle-repeat();
    callback next-song();
    callback prev-song();
    callback shuffle();
    callback set-volume(int);
    callback seek(int);
}
