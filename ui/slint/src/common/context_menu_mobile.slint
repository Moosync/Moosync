import { Theme } from "../constants_mobile.slint";
import { WindowInfo } from "../window_info.slint";
import {
    ContextMenuItem,
    ContextSubMenuItem,
} from "../types/context_menu.slint";
import { IconButton } from "icon_button_mobile.slint";
import { ListView } from "std-widgets.slint";
import { ScrollActivity } from "scroll_activity_mobile.slint";

export component ContextMenuMobile inherits Rectangle {
    in-out property <[ContextMenuItem]> items: [];
    in-out property <length> requested_x: 0px;
    in-out property <length> requested_y: 0px;
    in property <string> selected_id: "";

    callback selected(string);
    callback clicked();

    property <bool> is_open: false;
    property <int> active_submenu_index: -1;
    property <bool> is_expanded: false;
    property <bool> is_dragging: false;
    property <duration> open_start_time: Theme.zeroDuration;
    property <float> open_progress: Math.min(1.0, Math.max(0.0, (animation-tick() - root.open_start_time) / Theme.durationFast));
    property <float> ease_progress: 1.0 - (1.0 - root.open_progress) * (1.0 - root.open_progress);
    property <length> sheet_height: (root.is_expanded || root.active_submenu_index >= 0) ? Math.min(WindowInfo.window-height * 0.75, Theme.modalWidth) : Math.min(WindowInfo.window-height * 0.45, Theme.modalHeightMd);
    animate sheet_height {
        duration: Theme.durationFast;
        easing: ease-out;
    }
    property <length> resting_y: WindowInfo.window-height - (root.sheet_height * root.ease_progress);
    property <length> drag_offset: 0px;
    animate drag_offset {
        duration: root.is_dragging ? Theme.zeroDuration : Theme.durationFast;
        easing: ease-out;
    }
    property <length> current_y: Math.max(0px, Math.min(WindowInfo.window-height, root.resting_y + root.drag_offset));
    property <length> current_height: Math.max(0px, WindowInfo.window-height - root.current_y);

    width: 0px;
    height: 0px;

    public function show() {
        root.active_submenu_index = -1;
        root.is_expanded = false;
        root.drag_offset = 0px;
        root.is_dragging = false;
        root.open_start_time = animation-tick();
        root.is_open = true;
        popup.show();
    }

    public function show_at(x: length, y: length) {
        root.requested_x = x;
        root.requested_y = y;
        root.show();
    }

    public function hide() {
        root.is_open = false;
        popup.close();
    }

    popup := PopupWindow {
        close-policy: PopupClosePolicy.no-auto-close;
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: WindowInfo.window-width;
        height: WindowInfo.window-height;

        // Scrim backdrop with fade animation
        Rectangle {
            background: Theme.modalBackdrop;
            opacity: root.ease_progress;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.hide();
                }
            }
        }

        popup_sheet := Rectangle {
            y: root.current_y;
            height: root.current_height;
            width: 100%;
            background: Theme.secondary;
            border-top-left-radius: Theme.borderRadiusXl;
            border-top-right-radius: Theme.borderRadiusXl;
            clip: true;

            VerticalLayout {
                padding: Theme.paddingMd;
                padding-top: Theme.paddingSm;
                spacing: Theme.borderWidthLg;

                // Visual drag handle
                drag_handle_container := Rectangle {
                    height: Theme.sizeXl;

                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            y: (parent.height - Theme.sizeXxs) / 2;
                            width: Theme.searchBarHeight;
                            height: Theme.sizeXxs;
                            border-radius: Theme.borderWidthLg;
                            background: Theme.textSecondary.with-alpha(0.4);
                        }
                    }
                }

                // Submenu Header (when in submenu)
                if root.active_submenu_index >= 0: HorizontalLayout {
                    alignment: start;
                    spacing: Theme.spacingMd;
                    IconButton {
                        accessible-label: "Back";
                        icon_source: @image-url("../icons/nav_button.svg");
                        icon_size: Theme.iconSizeSm;
                        width: Theme.searchBarHeight;
                        height: Theme.searchBarHeight;
                        clicked => {
                            root.active_submenu_index = -1;
                        }
                    }

                    Text {
                        text: root.items[root.active_submenu_index].title;
                        font-size: Theme.modelTitle;
                        font-weight: 700;
                        color: Theme.textPrimary;
                        vertical-alignment: center;
                    }
                }

                // Main Menu Items in scrollable ListView
                if root.active_submenu_index < 0: Rectangle {
                    vertical-stretch: 1;
                    main_scroll_activity := ScrollActivity {
                        position: main_menu_list.content-y;
                    }

                    main_menu_list := ListView {
                        width: 100%;
                        height: 100%;
                        horizontal-scrollbar-policy: always-off;
                        vertical-scrollbar-policy: main_scroll_activity.active ? as-needed : always-off;
                        for item[idx] in root.items: TouchArea {
                            accessible-role: button;
                            accessible-label: item.title;
                            accessible-action-default => {
                                if (item.has_sub_menu || item.sub_items.length > 0) {
                                    root.active_submenu_index = idx;
                                } else {
                                    root.selected(item.action_id);
                                    root.hide();
                                }
                            }
                            height: Theme.size3Xl;
                            clicked => {
                                if (item.has_sub_menu || item.sub_items.length > 0) {
                                    root.active_submenu_index = idx;
                                } else {
                                    root.selected(item.action_id);
                                    root.hide();
                                }
                            }

                            Rectangle {
                                background: (root.selected_id != "" && item.action_id == root.selected_id) ? Theme.accent.with-alpha(0.12) : (parent.has-hover ? Theme.primary.with-alpha(0.5) : transparent);
                                border-radius: Theme.borderRadiusMd;

                                HorizontalLayout {
                                    padding-left: Theme.paddingMd;
                                    padding-right: Theme.paddingMd;
                                    spacing: Theme.spacingMd;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: Theme.iconSizeMd;
                                            height: Theme.iconSizeMd;
                                            if item.icon.width > 0: Image {
                                                width: 100%;
                                                height: 100%;
                                                source: item.icon;
                                                image-fit: contain;
                                                colorize: (root.selected_id != "" && item.action_id == root.selected_id) ? Theme.accent : Theme.textPrimary;
                                            }
                                        }
                                    }

                                    Text {
                                        text: item.title;
                                        font-size: Theme.body;
                                        font-weight: (root.selected_id != "" && item.action_id == root.selected_id) ? 700 : 500;
                                        color: (root.selected_id != "" && item.action_id == root.selected_id) ? Theme.accent : Theme.textPrimary;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    if (root.selected_id != "" && item.action_id == root.selected_id): VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: Theme.borderWidthXxl;
                                            height: Theme.sizeLg;
                                            border-radius: Theme.borderRadiusSm;
                                            background: Theme.accent;
                                        }
                                    }

                                    if (item.has_sub_menu || item.sub_items.length > 0): VerticalLayout {
                                        alignment: center;
                                        Image {
                                            width: Theme.iconSizeSm;
                                            height: Theme.iconSizeSm;
                                            source: @image-url("../icons/nav_button.svg");
                                            image-fit: contain;
                                            colorize: Theme.textSecondary;
                                            transform-rotation: Theme.angle180;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Submenu Items in scrollable ListView
                if root.active_submenu_index >= 0: Rectangle {
                    vertical-stretch: 1;
                    sub_scroll_activity := ScrollActivity {
                        position: sub_menu_list.content-y;
                    }

                    sub_menu_list := ListView {
                        width: 100%;
                        height: 100%;
                        horizontal-scrollbar-policy: always-off;
                        vertical-scrollbar-policy: sub_scroll_activity.active ? as-needed : always-off;
                        for sub_item in root.items[root.active_submenu_index].sub_items: TouchArea {
                            accessible-role: button;
                            accessible-label: sub_item.title;
                            accessible-action-default => {
                                root.selected(sub_item.action_id);
                                root.hide();
                            }
                            height: Theme.size3Xl;
                            clicked => {
                                root.selected(sub_item.action_id);
                                root.hide();
                            }

                            Rectangle {
                                background: parent.has-hover ? Theme.primary.with-alpha(0.5) : transparent;
                                border-radius: Theme.borderRadiusMd;

                                HorizontalLayout {
                                    padding-left: Theme.paddingMd;
                                    padding-right: Theme.paddingMd;
                                    spacing: Theme.spacingMd;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: Theme.iconSizeMd;
                                            height: Theme.iconSizeMd;
                                            if sub_item.icon.width > 0: Image {
                                                width: 100%;
                                                height: 100%;
                                                source: sub_item.icon;
                                                image-fit: contain;
                                                colorize: Theme.textPrimary;
                                            }
                                        }
                                    }

                                    Text {
                                        text: sub_item.title;
                                        font-size: Theme.body;
                                        color: Theme.textPrimary;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Fixed touch tracking area for context menu drag handle (positioned at resting_y of handle, not moving with drag)
        TouchArea {
            accessible-role: button;
            accessible-label: "Context Menu Drag Handle";
            accessible-value: "\{root.current_y / 1px}";
            x: 0px;
            y: root.resting_y;
            width: 100%;
            height: Theme.sizeXl + Theme.paddingSm * 2;

            clicked => {
                // Do not close context menu when drag handle is tapped
            }

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.is_dragging = true;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.is_dragging = false;
                    if (root.drag_offset < -Theme.size3Xl) {
                        root.is_expanded = true;
                    } else if (root.drag_offset > Theme.size3Xl) {
                        if (root.is_expanded) {
                            root.is_expanded = false;
                        } else {
                            root.hide();
                        }
                    }
                    root.drag_offset = 0px;
                }
            }

            moved => {
                if (self.pressed) {
                    root.is_dragging = true;
                    root.drag_offset = Math.max(-root.resting_y, Math.min(WindowInfo.window-height - root.resting_y, self.mouse-y - self.pressed-y));
                }
            }
        }
    }
}
