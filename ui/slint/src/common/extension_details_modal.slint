import { Modal, ModalSize } from "modal.slint";
import { Theme } from "../constants.slint";
import { IconButton } from "icon_button.slint";
import { ScrollView } from "std-widgets.slint";
import { PreferenceGroup } from "../settings/preference_group.slint";
import { Button } from "button.slint";
import { TextButton } from "text_button.slint";
import { BinaryPermissionWarning } from "binary_permission_warning.slint";
import {
    ExtensionItem,
    ProviderScope,
    ExtensionBinaryPermission,
    ExtensionHostPermission,
    ExtensionPathPermission,
    ExtensionScopePermission,
} from "../types/extension_view.slint";

import { ExtensionDetailsState } from "extension_details_modal_props.slint";

export component ExtensionDetailsModal inherits Modal {
    in property <ExtensionItem> item: ExtensionDetailsState.item.name != "" ? ExtensionDetailsState.item : {
        name: "Sample Extension",
        package_name: "org.moosync.sample",
        version: "1.0.0",
        author: "Moosync Team",
        description: "A sample extension demonstrating required permissions, justifications, and native binary security verification.",
        is_installed: false,
        loading: false,
        icon: @image-url("../icons/extensions.svg"),
        has_started: false,
        icon_url: "",
        registry: "Moosync Extensions",
        network_permissions: [
            {
                host: "api.example.com",
                justification: "Access remote music library catalog and search endpoints."
            },
            {
                host: "*.moosync.app",
                justification: "User authentication and playlist synchronization."
            }
        ],
        filesystem_permissions: [
            {
                source: "{CACHE_DIR}/bin",
                target: "/cache/bin",
                justification: "Store extracted helper tools and temporary audio cache."
            },
            {
                source: "/music",
                target: "/media/music",
                justification: "Read-only access to play local audio files."
            }
        ],
        binaries_permissions: [
            {
                name: "{CACHE_DIR}/bin/yt-dlp",
                hashes: "SHA-256: 7b819280e5...1b2c\nSHA-512: d80214a9b2...4f71\nMD5: 9e107d9d37...2f18",
                justification: "Extract streaming audio URLs for remote playback."
            }
        ],
        scopes: [
            {
                scope: ProviderScope.search,
                justification: "Query track and album search results."
            },
            {
                scope: ProviderScope.playlists,
                justification: "Fetch and manage custom user playlists."
            },
            { scope: ProviderScope.lyrics, justification: "Fetch synchronized LRC track lyrics." }
        ],
        error: ""
    };

    in property <bool> show_install_prompt: ExtensionDetailsState.item.name != "" ? ExtensionDetailsState.show_install_prompt : true;

    pure function scope_to_display_string(scope: ProviderScope) -> string {
        if scope == ProviderScope.search {
            return @tr("Search");
        }
        if scope == ProviderScope.playlists {
            return @tr("Playlists");
        }
        if scope == ProviderScope.playlist_songs {
            return @tr("Playlist Songs");
        }
        if scope == ProviderScope.artist_songs {
            return @tr("Artist Songs");
        }
        if scope == ProviderScope.album_songs {
            return @tr("Album Songs");
        }
        if scope == ProviderScope.recommendations {
            return @tr("Recommendations");
        }
        if scope == ProviderScope.scrobble {
            return @tr("Scrobble");
        }
        if scope == ProviderScope.playback_details {
            return @tr("Playback Details");
        }
        if scope == ProviderScope.lyrics {
            return @tr("Lyrics");
        }
        if scope == ProviderScope.song_context_menu {
            return @tr("Song Context Menu");
        }
        if scope == ProviderScope.playlist_context_menu {
            return @tr("Playlist Context Menu");
        }
        if scope == ProviderScope.accounts {
            return @tr("Accounts");
        }
        if scope == ProviderScope.database_song_events {
            return @tr("Song Database Events");
        }
        if scope == ProviderScope.database_playlist_events {
            return @tr("Playlist Database Events");
        }
        if scope == ProviderScope.player_ui_events {
            return @tr("Player UI Events");
        }
        if scope == ProviderScope.player_data_events {
            return @tr("Player Data Events");
        }
        if scope == ProviderScope.player_provider {
            return @tr("Player Provider");
        }
        return @tr("Unknown Scope");
    }

    pure function display_justification(justification: string) -> string {
        return justification != "" ? justification : @tr("No justification provided");
    }

    modalSize: ModalSize.Lg;

    Rectangle {
        background: Theme.primary;
        border-radius: Theme.borderRadiusXl;
        border-width: Theme.borderWidth;
        border-color: Theme.divider;
        clip: true;

        VerticalLayout {
            padding: Theme.paddingLg;
            spacing: Theme.spacingMd;

            // Optional install prompt banner
            if root.show_install_prompt: Rectangle {
                background: Theme.accent.transparentize(0.9);
                border-radius: Theme.borderRadiusMd;
                border-width: Theme.borderWidth;
                border-color: Theme.accent.transparentize(0.7);

                HorizontalLayout {
                    padding: Theme.paddingSm;
                    spacing: Theme.spacingSm;
                    alignment: start;

                    Image {
                        width: Theme.iconSizeSm;
                        height: Theme.iconSizeSm;
                        source: @image-url("../icons/info.svg");
                        image-fit: contain;
                        colorize: Theme.accent;
                    }

                    Text {
                        text: @tr("Extension Installation Request: Review permissions and justifications below before approving.");
                        font-size: Theme.caption;
                        font-weight: 600;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                }
            }

            // Header with Icon, Name, Version, Author
            HorizontalLayout {
                spacing: Theme.spacingMd;

                Rectangle {
                    width: Theme.extensionIconSize;
                    height: Theme.extensionIconSize;
                    border-radius: Theme.borderRadiusMd;
                    clip: true;

                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.item.icon.width > 0 ? root.item.icon : @image-url("../icons/extensions.svg");
                        image-fit: contain;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.spacingTiny;

                    Text {
                        text: root.item.name;
                        font-size: Theme.modelTitle;
                        font-weight: 700;
                        color: Theme.textPrimary;
                        overflow: elide;
                    }

                    Text {
                        text: root.item.package_name + " • v" + root.item.version;
                        font-size: Theme.caption;
                        color: Theme.textSecondary;
                    }

                    if root.item.author != "": Text {
                        text: @tr("By ") + root.item.author;
                        font-size: Theme.caption;
                        color: Theme.textSecondary;
                    }
                }
            }

            if root.item.description != "": Text {
                text: root.item.description;
                font-size: Theme.caption;
                color: Theme.textSecondary;
                wrap: word-wrap;
            }

            if root.item.error != "": Rectangle {
                background: Theme.danger.transparentize(0.85);
                border-radius: Theme.borderRadiusMd;
                border-width: Theme.borderWidth;
                border-color: Theme.danger;

                HorizontalLayout {
                    padding: Theme.paddingMd;
                    spacing: Theme.spacingMd;
                    alignment: center;

                    Image {
                        width: Theme.iconSizeSm;
                        height: Theme.iconSizeSm;
                        source: @image-url("../icons/warning.svg");
                        image-fit: contain;
                        colorize: Theme.danger;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.spacingTiny;

                        Text {
                            text: @tr("Extension Failed to Load");
                            font-size: Theme.caption;
                            font-weight: 700;
                            color: Theme.danger;
                        }

                        Text {
                            text: root.item.error;
                            font-size: Theme.caption;
                            color: Theme.textSecondary;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: Theme.spacingMd;
                    padding-right: Theme.paddingSm;
                    padding-top: Theme.paddingMd;

                    // BIG RED WARNING: Native Binaries Execution
                    if root.item.binaries_permissions.length > 0: BinaryPermissionWarning {
                        binaries: root.item.binaries_permissions;
                    }

                    // Network Permissions with Justifications
                    PreferenceGroup {
                        Text {
                            text: @tr("Network Permissions");
                            font-size: Theme.body;
                            font-weight: 700;
                            color: Theme.textPrimary;
                        }

                        if root.item.network_permissions.length == 0: Text {
                            accessible-role: text;
                            accessible-label: @tr("No network permissions requested.");
                            text: @tr("No network permissions requested.");
                            font-size: Theme.caption;
                            color: Theme.textSecondary;
                        }

                        if root.item.network_permissions.length > 0: VerticalLayout {
                            spacing: Theme.spacingTiny;

                            for host_item in root.item.network_permissions: Rectangle {
                                height: host_layout.preferred-height;

                                host_layout := HorizontalLayout {
                                    spacing: Theme.spacingSm;
                                    alignment: start;

                                    Text {
                                        horizontal-stretch: 0;
                                        vertical-alignment: center;
                                        accessible-role: text;
                                        accessible-label: @tr("Network Host: ") + host_item.host;
                                        text: "• " + host_item.host;
                                        font-size: Theme.caption;
                                        font-weight: 600;
                                        color: Theme.textPrimary;
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        accessible-role: text;
                                        accessible-label: @tr("Network Justification: ") + root.display_justification(host_item.justification);
                                        text: "— " + root.display_justification(host_item.justification);
                                        font-size: Theme.caption;
                                        color: Theme.textSecondary;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }

                    // Filesystem Permissions with Justifications
                    PreferenceGroup {
                        Text {
                            text: @tr("Filesystem Permissions");
                            font-size: Theme.body;
                            font-weight: 700;
                            color: Theme.textPrimary;
                        }

                        if root.item.filesystem_permissions.length == 0: Text {
                            accessible-role: text;
                            accessible-label: @tr("No filesystem permissions requested.");
                            text: @tr("No filesystem permissions requested.");
                            font-size: Theme.caption;
                            color: Theme.textSecondary;
                        }

                        if root.item.filesystem_permissions.length > 0: VerticalLayout {
                            spacing: Theme.spacingTiny;

                            for path_item in root.item.filesystem_permissions: Rectangle {
                                height: path_layout.preferred-height;

                                path_layout := HorizontalLayout {
                                    spacing: Theme.spacingSm;
                                    alignment: start;

                                    Text {
                                        horizontal-stretch: 0;
                                        vertical-alignment: center;
                                        accessible-role: text;
                                        accessible-label: @tr("Filesystem Path: ") + path_item.source + " -> " + path_item.target;
                                        text: "• " + path_item.source + " -> " + path_item.target;
                                        font-size: Theme.caption;
                                        font-weight: 600;
                                        color: Theme.textPrimary;
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        accessible-role: text;
                                        accessible-label: @tr("Filesystem Justification: ") + root.display_justification(path_item.justification);
                                        text: "— " + root.display_justification(path_item.justification);
                                        font-size: Theme.caption;
                                        color: Theme.textSecondary;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }

                    // Provider Scopes with Justifications
                    PreferenceGroup {
                        Text {
                            text: @tr("Provider Scopes");
                            font-size: Theme.body;
                            font-weight: 700;
                            color: Theme.textPrimary;
                        }

                        if root.item.scopes.length == 0: Text {
                            accessible-role: text;
                            accessible-label: @tr("No provider scopes registered.");
                            text: @tr("No provider scopes registered.");
                            font-size: Theme.caption;
                            color: Theme.textSecondary;
                        }

                        if root.item.scopes.length > 0: VerticalLayout {
                            spacing: Theme.spacingTiny;

                            for scope_item in root.item.scopes: Rectangle {
                                height: scope_layout.preferred-height;

                                scope_layout := HorizontalLayout {
                                    spacing: Theme.spacingSm;
                                    alignment: start;

                                    Rectangle {
                                        border-radius: Theme.borderRadiusSm;
                                        background: Theme.accent.transparentize(0.85);
                                        horizontal-stretch: 0;

                                        HorizontalLayout {
                                            padding-left: Theme.paddingSm;
                                            padding-right: Theme.paddingSm;
                                            padding-top: 2px;
                                            padding-bottom: 2px;

                                            Text {
                                                accessible-role: text;
                                                accessible-label: @tr("Scope: ") + root.scope_to_display_string(scope_item.scope);
                                                text: root.scope_to_display_string(scope_item.scope);
                                                font-size: Theme.caption;
                                                font-weight: 600;
                                                color: Theme.accent;
                                            }
                                        }
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        accessible-role: text;
                                        accessible-label: @tr("Scope Justification: ") + root.display_justification(scope_item.justification);
                                        text: root.display_justification(scope_item.justification);
                                        font-size: Theme.caption;
                                        color: Theme.textSecondary;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Action Buttons
            HorizontalLayout {
                alignment: end;
                spacing: Theme.spacingMd;

                if root.show_install_prompt: TextButton {
                    text: @tr("Reject");
                    accessible-label: @tr("Reject Extension Installation");
                    text_color: Theme.danger;
                    clicked => {
                        ExtensionDetailsState.reject();
                        root.close();
                    }
                }

                if root.show_install_prompt: Button {
                    text: @tr("Approve & Install");
                    accessible-label: @tr("Approve Extension Installation");
                    clicked => {
                        ExtensionDetailsState.approve();
                        root.close();
                    }
                }

                if !root.show_install_prompt: Button {
                    text: @tr("Close");
                    accessible-label: @tr("Close Extension Details");
                    clicked => { root.close(); }
                }
            }
        }
    }
}
