import { Theme } from "../constants_mobile.slint";
import { WindowInfo } from "../window_info.slint";
import { ExtensionProviderItem } from "../types/extension_view.slint";

export component ExtensionProviderMenuMobile inherits Rectangle {
    in-out property <[ExtensionProviderItem]> providers;
    callback toggled(string, bool);

    property <bool> is_open: false;
    property <length> drag_offset: 0px;
    property <bool> is_dragging: false;
    property <duration> open_start_time: Theme.zeroDuration;
    property <float> open_progress: Math.min(1.0, Math.max(0.0, (animation-tick() - root.open_start_time) / Theme.durationMedium));
    property <float> ease_progress: 1.0 - (1.0 - root.open_progress) * (1.0 - root.open_progress);
    property <length> sheet_height: Math.min(WindowInfo.window-height, (root.providers.length * Theme.mobileQueueDragHandleHeight) + Theme.mobileHeaderHeight + Theme.size3Xl);
    property <length> resting_y: parent.height - (root.sheet_height * root.ease_progress);
    property <length> current_y: Math.max(0px, Math.min(parent.height, root.resting_y + root.drag_offset));
    property <length> current_height: Math.max(0px, parent.height - root.current_y);

    public function show() {
        root.drag_offset = 0px;
        root.is_dragging = false;
        root.open_start_time = animation-tick();
        root.is_open = true;
        popup.show();
    }

    public function hide() {
        root.is_open = false;
        popup.close();
    }

    width: 0px;
    height: 0px;

    popup := PopupWindow {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: WindowInfo.window-width;
        height: WindowInfo.window-height;

        Rectangle {
            background: Theme.modalBackdrop;
            opacity: root.ease_progress;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.hide();
                }
            }
        }

        popup_sheet := Rectangle {
            height: root.current_height;
            y: root.current_y;
            width: 100%;
            background: Theme.secondary;
            border-top-left-radius: Theme.borderRadiusXl;
            border-top-right-radius: Theme.borderRadiusXl;
            clip: true;

            VerticalLayout {
                padding: Theme.paddingMd;
                spacing: Theme.spacingMd;

                HorizontalLayout {
                    alignment: center;
                    padding-top: Theme.spacingXs;
                    padding-bottom: Theme.spacingXs;
                    Rectangle {
                        width: Theme.mobileBottomSheetIndicatorWidth;
                        height: Theme.mobileBottomSheetIndicatorHeight;
                        border-radius: Theme.borderWidthLg;
                        background: Theme.textSecondary.with-alpha(0.4);
                    }
                }

                Text {
                    text: @tr("Filter by Extension");
                    font-size: Theme.modelTitle;
                    font-weight: 700;
                    color: Theme.textPrimary;
                }

                for item[idx] in root.providers: TouchArea {
                    height: Theme.mobileQueueDragHandleHeight;
                    clicked => {
                        root.providers[idx].enabled = !root.providers[idx].enabled;
                        root.toggled(root.providers[idx].id, root.providers[idx].enabled);
                    }

                    Rectangle {
                        border-radius: Theme.borderRadiusMd;
                        background: parent.has-hover ? Theme.primary.with-alpha(0.5) : transparent;

                        HorizontalLayout {
                            padding-left: Theme.paddingMd;
                            padding-right: Theme.paddingMd;
                            spacing: Theme.spacingMd;
                            alignment: center;

                            Rectangle {
                                width: Theme.mobileLyricsActiveFontSize;
                                height: Theme.mobileLyricsActiveFontSize;
                                border-radius: Theme.borderRadiusSm;
                                border-width: Theme.borderWidthLg;
                                border-color: item.enabled ? Theme.accent : Theme.textSecondary;
                                background: item.enabled ? Theme.accent : transparent;

                                if (item.enabled): Image {
                                    width: Theme.subtitle;
                                    height: Theme.subtitle;
                                    source: @image-url("../icons/sidebar_toggle.svg");
                                    colorize: Theme.textPrimary;
                                }
                            }

                            Text {
                                text: item.name;
                                font-size: Theme.body;
                                color: Theme.textPrimary;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }
        }

        // Dynamic drag touch area tracking top of sheet
        if root.is_open: TouchArea {
            x: 0px;
            y: root.current_y;
            width: 100%;
            height: Theme.songListItemHeight;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.is_dragging = true;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.is_dragging = false;
                    if (root.drag_offset > Theme.mobileSheetDismissThreshold) {
                        root.hide();
                    }
                    root.drag_offset = 0px;
                }
            }

            moved => {
                if (self.pressed) {
                    root.drag_offset = self.mouse-y - self.pressed-y;
                }
            }
        }
    }
}
