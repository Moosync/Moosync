import { Theme } from "../constants.slint";
import { WindowInfo } from "../window_info.slint";

export component GhostBlock inherits Rectangle {
    in property <float> phase_offset: 0.0;
    property <float> pulse: 0.5 + 0.5 * Math.sin(((animation-tick() / 1.5s) + root.phase_offset) * Theme.angle360);

    background: Theme.textPrimary.with-alpha(0.06 + 0.08 * root.pulse);
    border-radius: Theme.sizeXxs;
}

export component GhostSongListItem inherits Rectangle {
    in property <int> item_index: 0;
    property <float> phase_offset: Math.mod(root.item_index, 6) * 0.08;
    property <length> title_width: root.item_index == 0 || Math.mod(root.item_index, 3) == 0 ? 180px : (Math.mod(root.item_index, 3) == 1 ? 220px : 150px);
    property <length> subtitle_width: root.item_index == 0 || Math.mod(root.item_index, 3) == 0 ? 120px : (Math.mod(root.item_index, 3) == 1 ? 150px : 100px);

    accessible-role: none;
    background: Theme.secondary;
    border-radius: Theme.borderRadiusLg;
    height: Theme.songListItemHeight;

    HorizontalLayout {
        padding: Theme.paddingXs;
        padding-right: Theme.paddingLg;

        GhostBlock {
            width: Theme.songListItemThumbnailSize;
            height: Theme.songListItemThumbnailSize;
            border-radius: Theme.borderRadiusMd;
            phase_offset: root.phase_offset;
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;
            padding-left: Theme.paddingLg;

            VerticalLayout {
                alignment: center;
                spacing: Theme.spacingXs;

                GhostBlock {
                    width: root.title_width;
                    height: Theme.body;
                    phase_offset: root.phase_offset;
                }

                GhostBlock {
                    width: root.subtitle_width;
                    height: Theme.caption;
                    phase_offset: root.phase_offset;
                }
            }
        }

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: Theme.spacingXxl + Theme.paddingLg;
                alignment: end;

                HorizontalLayout {
                    spacing: Theme.spacingXl;
                    alignment: center;

                    VerticalLayout {
                        alignment: center;

                        GhostBlock {
                            width: Theme.sizeXxl;
                            height: Theme.caption;
                            phase_offset: root.phase_offset;
                        }
                    }

                    if (WindowInfo.window-size > WindowInfo.sm): GhostBlock {
                        width: Theme.iconSizeMd;
                        height: Theme.iconSizeMd;
                        border-radius: Theme.borderRadiusFull;
                        phase_offset: root.phase_offset;
                    }
                }

                GhostBlock {
                    width: Theme.iconSizeMd;
                    height: Theme.iconSizeMd;
                    border-radius: Theme.borderRadiusFull;
                    phase_offset: root.phase_offset;
                }
            }
        }
    }
}

export component GhostCardView inherits VerticalLayout {
    in property <int> item_index: 0;
    property <float> phase_offset: Math.mod(root.item_index, 6) * 0.08;

    accessible-role: none;
    padding: Theme.paddingSm;
    spacing: Theme.spacingXs;

    GhostBlock {
        border-radius: Theme.borderRadiusMd;
        height: self.width;
        phase_offset: root.phase_offset;
    }

    VerticalLayout {
        padding-left: Theme.spacingXxs;

        GhostBlock {
            width: 75%;
            height: Theme.modelTitle;
            phase_offset: root.phase_offset;
        }
    }
}
