import { ScrollView } from "std-widgets.slint";
import { Theme } from "../constants.slint";
import { Modal, ModalSize } from "modal.slint";
import { TextInputGroup } from "../settings/text_input.slint";
import { ButtonGroup } from "../settings/button_group.slint";
import { Spinner } from "spinner.slint";

import { OAuthState } from "oauth_modal_props.slint";

export component OAuthModal inherits Modal {
    in property <string> oauth_url: OAuthState.oauth_url;
    in-out property <string> oauth_code <=> OAuthState.oauth_code;

    callback submit_code(string);

    modalSize: ModalSize.Md;

    Rectangle {
        background: Theme.primary;
        border-radius: Theme.borderRadiusLg;
        border-width: Theme.borderWidth;
        border-color: Theme.accent.transparentize(Theme.percent80);

        TouchArea { }

        VerticalLayout {
            padding: Theme.paddingMd;
            spacing: Theme.spacingSm;

            Text {
                text: OAuthState.modal_title;
                font-size: Theme.modelTitle;
                font-weight: 700;
                color: Theme.textPrimary;
                wrap: word-wrap;
            }

            if OAuthState.error_message != "": Rectangle {
                background: Theme.danger.transparentize(0.85);
                border-radius: Theme.borderRadiusMd;
                border-width: Theme.borderWidth;
                border-color: Theme.danger;

                HorizontalLayout {
                    padding: Theme.paddingSm;
                    spacing: Theme.spacingSm;
                    alignment: start;

                    Image {
                        width: Theme.iconSizeSm;
                        height: Theme.iconSizeSm;
                        source: @image-url("../icons/warning.svg");
                        image-fit: contain;
                        colorize: Theme.danger;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.spacingTiny;

                        Text {
                            text: @tr("Authentication Error");
                            font-size: Theme.caption;
                            font-weight: 700;
                            color: Theme.danger;
                        }

                        Text {
                            text: OAuthState.error_message;
                            font-size: Theme.caption;
                            color: Theme.textSecondary;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if OAuthState.has_extra_content: ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: Theme.spacingMd;
                    alignment: start;

                    for part in OAuthState.markdown_parts: VerticalLayout {
                        spacing: Theme.spacingSm;

                        if !part.is_image: StyledText {
                            text: part.text;
                            default-color: Theme.textPrimary;
                            default-font-size: Theme.body;
                            link-color: Theme.accent;
                            link-clicked(url) => {
                                if (url.starts-with("https://")) {
                                    Platform.open-url(url);
                                }
                            }
                        }

                        if part.is_image: HorizontalLayout {
                            alignment: center;

                            Image {
                                source: part.image_src;
                                max-height: 220px;
                                image-fit: contain;
                            }
                        }
                    }
                }
            }

            if OAuthState.has_extra_content: HorizontalLayout {
                alignment: end;

                ButtonGroup {
                    buttons: [{ id: "done", text: @tr("Done"), is-destructive: false, is-neutral: false }];
                    clicked(id) => {
                        if (id == "done") {
                            root.close();
                        }
                    }
                }
            }

            if !OAuthState.has_extra_content && root.oauth_url != "": VerticalLayout {
                spacing: Theme.spacingTiny;

                Text {
                    text: OAuthState.device_code != "" ? @tr("Visit the URL below in your browser and enter the device code:") : @tr("If the browser did not open automatically, copy the URL below:");
                    font-size: Theme.caption;
                    color: Theme.textSecondary;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: Theme.textInputHeight;
                    border-radius: Theme.borderRadiusXl;
                    border-color: Theme.divider;
                    border-width: Theme.borderWidth;
                    background: Theme.secondary;
                    clip: true;

                    url_hover := TouchArea { }

                    HorizontalLayout {
                        padding-left: Theme.paddingMd;
                        padding-right: Theme.paddingSm;
                        spacing: Theme.spacingSm;

                        url_input := TextInput {
                            text: root.oauth_url;
                            read-only: true;
                            color: Theme.accent;
                            font-size: Theme.body;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        if url_hover.has-hover: Rectangle {
                            width: copy_url_text.preferred-width + Theme.paddingMd * 2;
                            height: Theme.textInputHeight - Theme.spacingSm;
                            y: (parent.height - self.height) / 2;
                            border-radius: Theme.borderRadiusMd;
                            background: copy_url_touch.has-hover ? Theme.accent : Theme.tertiary;
                            accessible-role: button;
                            accessible-label: @tr("Copy URL");

                            copy_url_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    url_input.select-all();
                                    url_input.copy();
                                }
                            }

                            copy_url_text := Text {
                                text: @tr("Copy");
                                font-size: Theme.caption;
                                font-weight: 600;
                                color: Theme.textPrimary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            if !OAuthState.has_extra_content && OAuthState.device_code != "": VerticalLayout {
                spacing: Theme.spacingTiny;

                Text {
                    text: @tr("Device Code");
                    font-size: Theme.caption;
                    font-weight: 600;
                    color: Theme.textSecondary;
                }

                Rectangle {
                    height: 52px;
                    border-radius: Theme.borderRadiusLg;
                    border-color: Theme.accent;
                    border-width: Theme.borderWidth;
                    background: Theme.secondary;
                    clip: true;

                    code_hover := TouchArea { }

                    HorizontalLayout {
                        padding-left: Theme.paddingMd;
                        padding-right: Theme.paddingSm;
                        spacing: Theme.spacingSm;

                        device_code_input := TextInput {
                            text: OAuthState.device_code;
                            read-only: true;
                            color: Theme.accent;
                            font-size: Theme.modelTitle;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        if code_hover.has-hover: Rectangle {
                            width: copy_code_text.preferred-width + Theme.paddingMd * 2;
                            height: Theme.textInputHeight - Theme.spacingSm;
                            y: (parent.height - self.height) / 2;
                            border-radius: Theme.borderRadiusMd;
                            background: copy_code_touch.has-hover ? Theme.accent : Theme.tertiary;
                            accessible-role: button;
                            accessible-label: @tr("Copy Code");

                            copy_code_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    device_code_input.select-all();
                                    device_code_input.copy();
                                }
                            }

                            copy_code_text := Text {
                                text: @tr("Copy");
                                font-size: Theme.caption;
                                font-weight: 600;
                                color: Theme.textPrimary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            if !OAuthState.has_extra_content && OAuthState.device_code == "": TextInputGroup {
                title: @tr("Authorization Code / Callback URL");
                subtitle: "";
                placeholder: @tr("Paste the code or redirected URL here");
                value <=> root.oauth_code;
            }

            if !OAuthState.has_extra_content: HorizontalLayout {
                alignment: end;
                spacing: Theme.spacingMd;

                ButtonGroup {
                    buttons: OAuthState.is_submitting ? [{ id: "cancel", text: @tr("Cancel"), is-destructive: false, is-neutral: true }] : (OAuthState.device_code != "" ? [
                        { id: "cancel", text: @tr("Cancel"), is-destructive: false, is-neutral: true },
                        { id: "refresh", text: @tr("Refresh"), is-destructive: false, is-neutral: false }
                    ] : [
                        { id: "cancel", text: @tr("Cancel"), is-destructive: false, is-neutral: true },
                        { id: "submit", text: @tr("Submit"), is-destructive: false, is-neutral: false }
                    ]);
                    clicked(id) => {
                        if (id == "cancel") {
                            root.close();
                        } else if (!OAuthState.is_submitting && id == "submit") {
                            root.submit_code(root.oauth_code);
                        } else if (!OAuthState.is_submitting && id == "refresh") {
                            root.submit_code("");
                        }
                    }
                }

                if OAuthState.is_submitting: VerticalLayout {
                    alignment: center;

                    Spinner {
                        accessible-role: progress-indicator;
                        accessible-label: @tr("Submitting");
                        active: true;
                    }
                }
            }
        }
    }
}
