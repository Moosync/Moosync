import { Theme } from "../constants_mobile.slint";
import { ButtonMobile } from "button_mobile.slint";
import { IconButtonMobile } from "icon_button_mobile.slint";
import { OAuthState } from "oauth_modal_props.slint";

export component OAuthModalMobile inherits Rectangle {
    in property <string> oauth_url: OAuthState.oauth_url;
    in-out property <string> oauth_code <=> OAuthState.oauth_code;
    callback submit_code(string);
    callback close();

    width: 100%;
    height: 100%;
    background: Theme.primary;

    VerticalLayout {
        padding-top: Theme.mobileTopBarPaddingTop;
        padding-left: Theme.paddingMd;
        padding-right: Theme.paddingMd;
        padding-bottom: Theme.paddingMd;
        spacing: Theme.spacingLg;

        // Top App Bar with back navigation
        HorizontalLayout {
            spacing: Theme.spacingSm;
            alignment: start;

            IconButtonMobile {
                accessible-label: @tr("Back");
                icon_source: @image-url("../icons/nav_button.svg");
                icon_size: Theme.playbackControlsIconSize;
                width: Theme.searchBarHeight;
                height: Theme.searchBarHeight;
                clicked => {
                    root.close();
                }
            }

            Text {
                text: @tr("Account Login");
                font-size: Theme.modelTitle;
                font-weight: 700;
                color: Theme.textPrimary;
                vertical-alignment: center;
            }
        }

        // Form Card Container
        Rectangle {
            vertical-stretch: 1;
            background: Theme.secondary;
            border-radius: Theme.borderRadiusXl;
            clip: true;

            VerticalLayout {
                padding: Theme.paddingMd;
                spacing: Theme.spacingMd;
                alignment: start;

                Text {
                    text: @tr("Paste the authorization code or redirected URL below:");
                    font-size: Theme.caption;
                    color: Theme.textSecondary;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: Theme.mobileInputHeight;
                    border-radius: Theme.borderRadiusMd;
                    background: Theme.tertiary;

                    HorizontalLayout {
                        padding-left: Theme.paddingSm;
                        padding-right: Theme.paddingSm;
                        TextInput {
                            text <=> root.oauth_code;
                            font-size: Theme.body;
                            color: Theme.textPrimary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Submit Button at bottom
        HorizontalLayout {
            alignment: center;
            padding-bottom: Theme.paddingMd;

            ButtonMobile {
                text: @tr("Submit");
                width: 100%;
                clicked => {
                    root.submit_code(root.oauth_code);
                    root.close();
                }
            }
        }
    }
}
