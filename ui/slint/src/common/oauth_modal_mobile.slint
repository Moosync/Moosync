import { ScrollView } from "std-widgets.slint";
import { Theme } from "../constants_mobile.slint";
import { ButtonMobile } from "button_mobile.slint";
import { IconButtonMobile } from "icon_button_mobile.slint";
import { OAuthState } from "oauth_modal_props.slint";
import { Spinner } from "spinner.slint";

export component OAuthModalMobile inherits Rectangle {
    in property <string> oauth_url: OAuthState.oauth_url;
    in-out property <string> oauth_code <=> OAuthState.oauth_code;
    callback submit_code(string);
    callback close();

    width: 100%;
    height: 100%;
    background: Theme.primary;

    TouchArea { }

    VerticalLayout {
        padding-top: Theme.mobileTopBarPaddingTop;
        padding-left: Theme.paddingMd;
        padding-right: Theme.paddingMd;
        padding-bottom: Theme.paddingMd;
        spacing: Theme.spacingLg;

        // Top App Bar with back navigation
        HorizontalLayout {
            spacing: Theme.spacingSm;
            alignment: start;

            IconButtonMobile {
                accessible-label: @tr("Back");
                icon_source: @image-url("../icons/nav_button.svg");
                icon_size: Theme.playbackControlsIconSize;
                width: Theme.searchBarHeight;
                height: Theme.searchBarHeight;
                clicked => {
                    root.close();
                }
            }

            Text {
                text: OAuthState.modal_title;
                font-size: Theme.modelTitle;
                font-weight: 700;
                color: Theme.textPrimary;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }

        if OAuthState.error_message != "": Rectangle {
            background: Theme.danger.transparentize(0.85);
            border-radius: Theme.borderRadiusMd;
            border-width: Theme.borderWidth;
            border-color: Theme.danger;

            HorizontalLayout {
                padding: Theme.paddingSm;
                spacing: Theme.spacingSm;
                alignment: start;

                Image {
                    width: Theme.iconSizeSm;
                    height: Theme.iconSizeSm;
                    source: @image-url("../icons/warning.svg");
                    image-fit: contain;
                    colorize: Theme.danger;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.spacingTiny;

                    Text {
                        text: @tr("Authentication Error");
                        font-size: Theme.caption;
                        font-weight: 700;
                        color: Theme.danger;
                    }

                    Text {
                        text: OAuthState.error_message;
                        font-size: Theme.caption;
                        color: Theme.textSecondary;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // Content Card Container
        Rectangle {
            vertical-stretch: 1;
            background: Theme.secondary;
            border-radius: Theme.borderRadiusXl;
            clip: true;

            if OAuthState.has_extra_content: ScrollView {
                VerticalLayout {
                    padding: Theme.paddingMd;
                    spacing: Theme.spacingMd;
                    alignment: start;

                    for part in OAuthState.markdown_parts: VerticalLayout {
                        spacing: Theme.spacingSm;

                        if !part.is_image: StyledText {
                            text: part.text;
                            default-color: Theme.textPrimary;
                            default-font-size: Theme.body;
                            link-color: Theme.accent;
                            link-clicked(url) => {
                                if (url.starts-with("https://")) {
                                    Platform.open-url(url);
                                }
                            }
                        }

                        if part.is_image: HorizontalLayout {
                            alignment: center;

                            Image {
                                source: part.image_src;
                                max-height: 220px;
                                image-fit: contain;
                            }
                        }
                    }
                }
            }

            if !OAuthState.has_extra_content: VerticalLayout {
                padding: Theme.paddingMd;
                spacing: Theme.spacingMd;
                alignment: start;

                if root.oauth_url != "": VerticalLayout {
                    spacing: Theme.spacingTiny;

                    Text {
                        text: OAuthState.device_code != "" ? @tr("Visit the URL below in your browser and enter the device code:") : @tr("Authorization URL:");
                        font-size: Theme.caption;
                        color: Theme.textSecondary;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        height: Theme.mobileInputHeight;
                        border-radius: Theme.borderRadiusMd;
                        background: Theme.tertiary;
                        clip: true;

                        HorizontalLayout {
                            padding-left: Theme.paddingSm;
                            padding-right: Theme.paddingSm;
                            spacing: Theme.spacingSm;
                            min-width: 0px;

                            Rectangle {
                                clip: true;
                                horizontal-stretch: 1;
                                min-width: 0px;

                                url_input := TextInput {
                                    width: 100%;
                                    height: 100%;
                                    text: root.oauth_url;
                                    read-only: true;
                                    single-line: true;
                                    font-size: Theme.body;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                            }

                            ButtonMobile {
                                text: @tr("Copy");
                                clicked => {
                                    url_input.select-all();
                                    url_input.copy();
                                }
                            }
                        }
                    }
                }

                if OAuthState.device_code != "": VerticalLayout {
                    spacing: Theme.spacingTiny;

                    Text {
                        text: @tr("Device Code");
                        font-size: Theme.caption;
                        font-weight: 600;
                        color: Theme.textSecondary;
                    }

                    Rectangle {
                        height: Theme.mobileInputHeight;
                        border-radius: Theme.borderRadiusMd;
                        border-color: Theme.accent;
                        border-width: Theme.borderWidth;
                        background: Theme.tertiary;
                        clip: true;

                        HorizontalLayout {
                            padding-left: Theme.paddingSm;
                            padding-right: Theme.paddingSm;
                            spacing: Theme.spacingSm;
                            min-width: 0px;

                            Rectangle {
                                clip: true;
                                horizontal-stretch: 1;
                                min-width: 0px;

                                device_code_input := TextInput {
                                    width: 100%;
                                    height: 100%;
                                    text: OAuthState.device_code;
                                    read-only: true;
                                    single-line: true;
                                    font-size: Theme.modelTitle;
                                    font-weight: 700;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                            }

                            ButtonMobile {
                                text: @tr("Copy");
                                clicked => {
                                    device_code_input.select-all();
                                    device_code_input.copy();
                                }
                            }
                        }
                    }
                }

                if OAuthState.device_code == "": VerticalLayout {
                    spacing: Theme.spacingTiny;

                    Text {
                        text: @tr("Paste the authorization code or redirected URL below:");
                        font-size: Theme.caption;
                        color: Theme.textSecondary;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        height: Theme.mobileInputHeight;
                        border-radius: Theme.borderRadiusMd;
                        background: Theme.tertiary;
                        clip: true;

                        HorizontalLayout {
                            padding-left: Theme.paddingSm;
                            padding-right: Theme.paddingSm;
                            min-width: 0px;

                            Rectangle {
                                clip: true;
                                horizontal-stretch: 1;
                                min-width: 0px;

                                TextInput {
                                    accessible-label: @tr("Authorization code input");
                                    width: 100%;
                                    height: 100%;
                                    text <=> root.oauth_code;
                                    single-line: true;
                                    font-size: Theme.body;
                                    color: Theme.textPrimary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Bottom Action Button / Loading Spinner
        HorizontalLayout {
            alignment: center;
            padding-bottom: Theme.paddingMd;

            if (!OAuthState.has_extra_content && OAuthState.is_submitting): Spinner {
                accessible-role: progress-indicator;
                accessible-label: @tr("Submitting");
                active: true;
            }

            if (OAuthState.has_extra_content || !OAuthState.is_submitting): ButtonMobile {
                text: OAuthState.has_extra_content ? @tr("Done") : (OAuthState.device_code != "" ? @tr("Refresh") : @tr("Submit"));
                width: 100%;
                clicked => {
                    if (OAuthState.has_extra_content) {
                        root.close();
                    } else if (OAuthState.device_code != "") {
                        root.submit_code("");
                    } else {
                        root.submit_code(root.oauth_code);
                    }
                }
            }
        }
    }
}
