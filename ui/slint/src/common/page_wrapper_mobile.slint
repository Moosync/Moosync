import {
    Pages,
    SettingsPages,
    Constants,
    Theme,
} from "../constants_mobile.slint";

export component PageWrapperMobile inherits Rectangle {
    in property <Pages> page-type;
    in-out property <Pages> active-page;

    pure function page-index(p: Pages) -> int {
        if (p == Pages.AllSongs) { return 0; }
        if (p == Pages.Playlists) { return 1; }
        if (p == Pages.Artists) { return 2; }
        if (p == Pages.Albums) { return 3; }
        if (p == Pages.Genres) { return 4; }
        if (p == Pages.Explore) { return 5; }
        if (p == Pages.PlaylistContent) { return 6; }
        if (p == Pages.ArtistContent) { return 7; }
        if (p == Pages.AlbumContent) { return 8; }
        if (p == Pages.GenreContent) { return 9; }
        return 0;
    }

    opacity: active-page == page-type ? 1 : 0;
    visible: active-page == page-type || self.opacity > 0;
    width: 100%;
    height: 100%;

    property <length> slide-x: (active-page == page-type) ? 0px : (page-index(active-page) > page-index(page-type) ? -Theme.size3Xl : Theme.size3Xl);

    animate opacity {
        duration: Constants.page-transition-duration;
        easing: ease-in-out;
    }

    animate slide-x {
        duration: Constants.page-transition-duration;
        easing: ease-in-out;
    }

    HorizontalLayout {
        x: root.slide-x;
        padding-left: Theme.paddingSm;
        padding-right: Theme.paddingSm;
        width: 100%;
        height: 100%;
        @children
    }
}

export component SettingsPageWrapperMobile inherits Rectangle {
    in property <SettingsPages> page-type;
    in-out property <SettingsPages> active-page;

    pure function page-index(p: SettingsPages) -> int {
        if (p == SettingsPages.Paths) { return 0; }
        if (p == SettingsPages.System) { return 1; }
        if (p == SettingsPages.Extensions) { return 2; }
        if (p == SettingsPages.Themes) { return 3; }
        if (p == SettingsPages.Cache) { return 4; }
        if (p == SettingsPages.Logs) { return 5; }
        return 0;
    }

    opacity: active-page == page-type ? 1 : 0;
    visible: active-page == page-type || self.opacity > 0;
    width: 100%;
    height: 100%;

    property <length> slide-x: (active-page == page-type) ? 0px : (page-index(active-page) > page-index(page-type) ? -Theme.size3Xl : Theme.size3Xl);

    animate opacity {
        duration: Constants.page-transition-duration;
        easing: ease-in-out;
    }

    animate slide-x {
        duration: Constants.page-transition-duration;
        easing: ease-in-out;
    }

    HorizontalLayout {
        x: root.slide-x;
        padding-left: Theme.paddingSm;
        padding-right: Theme.paddingSm;
        width: 100%;
        height: 100%;
        @children
    }
}
