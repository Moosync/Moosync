import { Theme } from "../constants.slint";
import { AppCallbacks } from "../callbacks.slint";
import { Modal, ModalSize } from "modal.slint";
import { TextInputGroup } from "../settings/text_input.slint";
import { ButtonGroup } from "../settings/button_group.slint";

export component SaveThemeModal inherits Modal {
    in-out property <string> theme_name: "";
    in-out property <string> theme_desc: "";
    in-out property <string> theme_author: "";

    modalSize: ModalSize.Md;

    Rectangle {
        background: Theme.secondary;
        border-radius: Theme.borderRadiusXl;
        border-width: 1px;
        border-color: Theme.textSecondary;
        clip: true;

        VerticalLayout {
            padding: Theme.paddingLg;
            spacing: Theme.spacingMd;

            VerticalLayout {
                spacing: Theme.spacingXs;
                Text {
                    text: @tr("Save Custom Theme");
                    font-size: Theme.modelTitle;
                    color: Theme.textPrimary;
                }

                Text {
                    text: @tr("Your current accent and advanced styling variables will be saved.");
                    font-size: Theme.caption;
                    color: Theme.textSecondary;
                    wrap: word-wrap;
                }
            }

            TextInputGroup {
                title: @tr("Theme Name");
                subtitle: @tr("A short, distinct name");
                placeholder: @tr("e.g., Midnight Blue");
                value <=> root.theme_name;
                inputType: InputType.text;
            }

            TextInputGroup {
                title: @tr("Author");
                subtitle: @tr("Who created this theme?");
                placeholder: @tr("Your name");
                value <=> root.theme_author;
                inputType: InputType.text;
            }

            TextInputGroup {
                title: @tr("Description");
                subtitle: @tr("A brief summary of the aesthetics");
                placeholder: @tr("High contrast dark theme...");
                value <=> root.theme_desc;
                inputType: InputType.text;
            }

            HorizontalLayout {
                alignment: end;
                ButtonGroup {
                    title: "";
                    subtitle: "";
                    buttons: [
                        { id: "cancel", text: @tr("Cancel"), is-destructive: false },
                        { id: "confirm", text: @tr("Save Theme"), is-destructive: false }
                    ];
                    clicked(id) => {
                        if (id == "confirm") {
                            AppCallbacks.save_custom_theme(root.theme_name, root.theme_author, root.theme_desc);
                            root.theme_name = "";
                            root.theme_author = "";
                            root.theme_desc = "";
                        }
                        root.close();
                    }
                }
            }
        }
    }
}
