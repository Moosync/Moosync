import { SongModel, CoverHelper } from "../types/song_view.slint";
import { Theme } from "../constants.slint";
import { WindowInfo } from "../window_info.slint";
import { ScrollView } from "std-widgets.slint";
import { Utils, DefaultIconType } from "../utils.slint";
import { SongItemExtensionIcon } from "song_item_components.slint";

export component SongDetails inherits HorizontalLayout {

    in property <SongModel> song: {
        id: "",
        title: "",
        coverPathHigh: @image-url("../icons/song_default.svg"),
        coverPathLow: @image-url("../icons/song_default.svg"),
        extension-icon: @image-url("../icons/song_default.svg"),
    };

    // High res cover image needs to be dynamically fetched with default fallback
    property <image> cover-image: Utils.load_image_or_default(
        song.coverPathHigh.width > 0 ? song.coverPathHigh : (song.id != "" ? CoverHelper.fetch_cover_high(song) : song.coverPathLow),
        DefaultIconType.Song,
    );

    alignment: start;
    spacing: Theme.spacingMd;
    width: WindowInfo.window-size > WindowInfo.md ? Theme.songDetailsThumbnailSize : 0px;
    visible: WindowInfo.window-size > WindowInfo.md;

    ScrollView {
        height: 100%;
        width: 100%;

        VerticalLayout {
            alignment: start;

            Rectangle {
                width: Theme.songDetailsThumbnailSize;
                height: Theme.songDetailsThumbnailSize;
                border-radius: Theme.borderRadiusLg;
                background: Theme.secondary;
                clip: true;

                Image {
                    height: parent.height;
                    width: parent.width;
                    source: cover-image;
                    image-fit: cover;
                }
            }

            VerticalLayout {
                spacing: Theme.spacingXxs;

                HorizontalLayout {
                    spacing: Theme.spacingXs;
                    alignment: start;

                    Text {
                        text: song.title;
                        color: Theme.textPrimary;
                        font-size: Theme.modelTitle;
                        font-weight: 600;
                        overflow: elide;
                    }

                    if song.extension != "": SongItemExtensionIcon {
                        song: root.song;
                    }
                }

                Text {
                    accessible-role: none;
                    text: song.artists_str;
                    color: Theme.textSecondary;
                    font-size: Theme.subtitle;
                    overflow: elide;
                }

                Text {
                    accessible-role: none;
                    text: song.duration_str;
                    color: Theme.textSecondary;
                    font-size: Theme.subtitle;
                    overflow: elide;
                }

                @children
            }
        }
    }
}
