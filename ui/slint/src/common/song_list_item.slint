import { WindowInfo } from "../window_info.slint";
import { SongModel } from "../types/song_view.slint";
import { Constants, Theme } from "../constants.slint";
import {
    AppCallbacks,
    ContextMenuCallbacks,
} from "../callbacks.slint";
import { ContextMenu } from "context_menu.slint";
import { IconButton } from "icon_button.slint";
import {
    SongItemThumbnail,
    SongItemInfo,
    SongItemTitle,
    SongItemExtensionIcon,
    SongArtistsList,
    SongItemTitleRow,
    SongThumbnail,
    SongTitle,
    SongExtensionIcon,
    SongArtistList,
    SongInfo,
} from "song_item_components.slint";

export {
    SongItemThumbnail,
    SongItemInfo,
    SongItemTitle,
    SongItemExtensionIcon,
    SongArtistsList,
    SongItemTitleRow,
    SongThumbnail,
    SongTitle,
    SongExtensionIcon,
    SongArtistList,
    SongInfo,
}
export component SongListItem inherits Rectangle {
    in property <SongModel> song: Constants.defaultSong;

    callback clicked <=> context_menu.clicked;
    callback item_pressed <=> context_menu.handle_pointer_event;
    pure callback get_selected_songs() -> [SongModel];
    out property <bool> has-hover: context_menu.has-hover;

    accessible-role: list-item;
    accessible-label: root.song.title;
    background: Theme.secondary;
    border-radius: Theme.borderRadiusLg;
    height: Theme.songListItemHeight;

    context_menu := ContextMenu {
        items: ContextMenuCallbacks.get_song_menu_items(root.get_selected_songs().length > 0 ? root.get_selected_songs() : [song]);
        selected(id) => {
            ContextMenuCallbacks.song_action(root.get_selected_songs().length > 0 ? root.get_selected_songs() : [song], id);
        }
    }

    HorizontalLayout {
        padding: Theme.paddingXs;
        padding-right: Theme.paddingLg;

        SongItemThumbnail {
            song: root.song;
            show_play_overlay: true;
            play_clicked => {
                AppCallbacks.play-song(root.song);
            }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;
            padding-left: Theme.paddingLg;

            SongItemInfo {
                song: root.song;
            }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: Theme.spacingXxl + Theme.paddingLg;
                alignment: end;

                HorizontalLayout {
                    spacing: Theme.spacingXl;
                    Text {
                        accessible-role: none;
                        text: song.duration_str;
                        color: Theme.textSecondary;
                        font-size: Theme.caption;
                        vertical-alignment: center;
                    }

                    if (WindowInfo.window-size > WindowInfo.sm): IconButton {
                        accessible-label: @tr("Add to Queue");
                        icon_source: @image-url("../icons/add_to_queue.svg");
                        icon_size: Theme.iconSizeMd;
                        width: Theme.iconSizeMd;
                        height: Theme.iconSizeMd;
                        icon_color: Theme.accent;
                        clicked => {
                            AppCallbacks.add-song-to-queue(song);
                        }
                    }
                }

                IconButton {
                    icon_source: @image-url("../icons/ellipsis.svg");
                    icon_size: Theme.iconSizeMd;
                    width: Theme.iconSizeMd;
                    height: Theme.iconSizeMd;
                    clicked => {
                        context_menu.show_at(root.width - Theme.cardWidth, root.height);
                    }
                }
            }
        }
    }
}
