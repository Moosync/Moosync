import { SongModel } from "../types/song_view.slint";
import { Constants, Theme } from "../constants_mobile.slint";
import { AppCallbacks } from "../callbacks.slint";
import {
    SongItemThumbnail,
    SongItemInfo,
} from "song_item_components_mobile.slint";

export component SongListItemMobile inherits Rectangle {
    in property <SongModel> song: Constants.defaultSong;
    in property <bool> is_selected: false;
    in property <bool> selection_mode: false;
    callback clicked();
    callback long_pressed();
    callback item_pressed(PointerEvent);

    property <bool> is_long_press: false;

    long_press_timer := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            self.running = false;
            root.is_long_press = true;
            root.long_pressed();
        }
    }

    accessible-role: list-item;
    accessible-label: root.song.title;
    background: root.is_selected ? Theme.accent.transparentize(0.85) : Theme.secondary;
    border-radius: Theme.borderRadiusMd;
    border-width: root.is_selected ? Theme.borderWidth * 2 : 0px;
    border-color: root.is_selected ? Theme.accent : transparent;
    height: Theme.mobileSongListItemHeight;

    TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.is_long_press = false;
                long_press_timer.running = true;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                long_press_timer.running = false;
            }
            root.item_pressed(event);
        }
        moved => {
            if (self.pressed) {
                if (Math.abs(self.mouse-x - self.pressed-x) > 10px || Math.abs(self.mouse-y - self.pressed-y) > 10px) {
                    long_press_timer.running = false;
                }
            }
        }
        clicked => {
            if (!root.is_long_press) {
                root.clicked();
            }
            root.is_long_press = false;
        }
    }

    HorizontalLayout {
        padding: Theme.paddingXs;
        padding-right: Theme.paddingLg;

        SongItemThumbnail {
            song: root.song;
            show_play_overlay: !root.selection_mode;
            play_clicked => {
                if (!root.selection_mode) {
                    AppCallbacks.play-song(root.song);
                }
            }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;
            padding-left: Theme.paddingLg;

            SongItemInfo {
                song: root.song;
            }
        }

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: Theme.spacingLg;
                alignment: end;

                Text {
                    accessible-role: none;
                    text: root.song.duration_str;
                    font-size: Theme.caption;
                    color: Theme.textSecondary;
                    vertical-alignment: center;
                }
            }
        }
    }
}
