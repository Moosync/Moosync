import { SongModel } from "../types/song_view.slint";
import { Constants, Theme } from "../constants_mobile.slint";
import { AppCallbacks, ContextMenuCallbacks } from "../callbacks.slint";
import { ContextMenuMobile } from "context_menu_mobile.slint";
import { IconButton } from "icon_button_mobile.slint";
import {
    SongItemThumbnail,
    SongItemInfo,
} from "song_item_components_mobile.slint";

export component SongListItemMobile inherits Rectangle {
    in property <SongModel> song: Constants.defaultSong;
    callback clicked();
    callback item_pressed(PointerEvent);
    pure callback get_selected_songs() -> [SongModel];

    accessible-role: list-item;
    accessible-label: root.song.title;
    background: Theme.secondary;
    border-radius: Theme.borderRadiusMd;
    height: Theme.mobileSongListItemHeight;

    TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            root.item_pressed(event);
        }
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding: Theme.paddingXs;
        padding-right: Theme.paddingLg;

        SongItemThumbnail {
            song: root.song;
            show_play_overlay: true;
            play_clicked => {
                AppCallbacks.play-song(root.song);
            }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;
            padding-left: Theme.paddingLg;

            SongItemInfo {
                song: root.song;
            }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: Theme.spacingLg;
                alignment: end;

                Text {
                    accessible-role: none;
                    text: root.song.duration_str;
                    font-size: Theme.caption;
                    color: Theme.textSecondary;
                    vertical-alignment: center;
                }

                IconButton {
                    accessible-label: @tr("More options");
                    icon_source: @image-url("../icons/ellipsis.svg");
                    icon_size: Theme.iconSizeMd;
                    width: Theme.mobileButtonSize;
                    height: Theme.mobileButtonSize;
                    clicked => {
                        context_menu.show();
                    }
                }
            }
        }
    }

    context_menu := ContextMenuMobile {
        items: ContextMenuCallbacks.get_song_menu_items(root.get_selected_songs().length > 0 ? root.get_selected_songs() : [root.song]);
        selected(id) => {
            ContextMenuCallbacks.song_action(root.get_selected_songs().length > 0 ? root.get_selected_songs() : [root.song], id);
        }
    }
}
