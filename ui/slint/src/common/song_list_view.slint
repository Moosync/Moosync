import { ListView } from "std-widgets.slint";
import {
    SongModel,
    SongSortCriterion,
} from "../types/song_view.slint";
import { ExtensionProviderItem } from "../types/extension_view.slint";
import { ExtensionProviderMenu } from "extension_provider_menu.slint";
import { SongListItem } from "song_list_item.slint";
import { Theme, Constants } from "../constants.slint";
import {
    AppCallbacks,
    UtilCallbacks,
} from "../callbacks.slint";
import { SearchBar } from "../topbar/search_bar.slint";
import { PopupMenu } from "popup_menu.slint";
import { IconButton } from "icon_button.slint";

export component SongListView inherits Rectangle {
    in property <[SongModel]> songs: Constants.testSongs;
    in-out property <[ExtensionProviderItem]> extension_providers: [];
    callback provider_toggled(string, bool);
    in-out property <int> active-idx: -1;
    in-out property <[int]> selected-indices: [];
    property <int> anchor-idx: 0;
    in property <bool> show-controls: true;

    out property <[SongModel]> display-songs: (root.search-text == "" && root.sort-criterion == SongSortCriterion.Title && root.sort-ascending) ? root.songs : AppCallbacks.filter_and_sort_songs(
        root.songs,
        root.search-text,
        root.sort-criterion,
        root.sort-ascending);

    out property <[SongModel]> selected-songs: UtilCallbacks.get_selected_songs(root.display-songs, root.selected-indices);

    property <bool> search-open: false;
    property <string> search-text: "";
    property <SongSortCriterion> sort-criterion: SongSortCriterion.Title;
    property <bool> sort-ascending: true;

    background: transparent;

    VerticalLayout {
        spacing: root.show-controls ? Theme.spacingSm : 0px;

        HorizontalLayout {
            visible: root.show-controls;
            alignment: end;
            spacing: Theme.spacingSm;
            padding-right: Theme.spacingXl;
            height: root.show-controls ? Theme.searchBarHeight : 0px;

            // Expandable Search Bar container
            Rectangle {
                width: root.search-open ? 220px : 0px;
                opacity: root.search-open ? 1.0 : 0.0;
                clip: true;

                animate width {
                    duration: 200ms;
                    easing: ease-in-out;
                }
                animate opacity {
                    duration: 150ms;
                    easing: ease-in-out;
                }

                SearchBar {
                    width: 220px;
                    text <=> root.search-text;
                    custom-background: Theme.tertiary;
                    placeholder-text: @tr("Filter songs...");
                }
            }

            // Search Icon Button
            IconButton {
                icon_source: @image-url("../icons/search.svg");
                active: root.search-open;
                clicked => {
                    root.search-open = !root.search-open;
                    if (!root.search-open) {
                        root.search-text = "";
                    }
                }
            }

            // Sort Icon Button
            sort_btn := IconButton {
                icon_source: @image-url("../icons/sort.svg");
                active: root.sort-criterion != SongSortCriterion.Title || !root.sort-ascending;
                icon_rotation: !root.sort-ascending ? 180deg : 0deg;
                clicked => {
                    sort-popup.show();
                }

                sort-popup := PopupMenu {
                    x: sort_btn.width - self.width;
                    y: sort_btn.height + 4px;
                    items: AppCallbacks.get_sort_menu_items(root.sort-criterion);

                    selected(id) => {
                        root.sort-ascending = AppCallbacks.decide_sort_ascending(root.sort-criterion, root.sort-ascending, id);
                        root.sort-criterion = AppCallbacks.decide_sort_criterion(id);
                    }
                }
            }

            // Extension Providers Icon Button (extreme right)
            if (root.extension_providers.length > 0): ext_btn := IconButton {
                icon_source: @image-url("../icons/extensions.svg");
                active: UtilCallbacks.has_active_extension_providers(root.extension_providers);
                clicked => {
                    ext_popup.show();
                }

                ext_popup := ExtensionProviderMenu {
                    x: ext_btn.width - self.width;
                    y: ext_btn.height + 4px;
                    providers <=> root.extension_providers;

                    toggled(id, enabled) => {
                        root.provider_toggled(id, enabled);
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;

            ListView {
                width: 100%;
                height: 100%;
                vertical-scrollbar-policy: always-on;

                for song[index] in root.display-songs: VerticalLayout {
                    HorizontalLayout {
                        padding-bottom: Theme.paddingSm;
                        padding-right: Theme.spacingXl;

                        Rectangle {
                            SongListItem {
                                song: song;
                                border-width: (UtilCallbacks.is_index_selected(root.selected-indices, index) || root.active-idx == index || self.has-hover) ? Theme.borderWidth * 2 : 0px;
                                border-color: (UtilCallbacks.is_index_selected(root.selected-indices, index) || root.active-idx == index) ? Theme.accent : Theme.accent.darker(0.2);

                                get_selected_songs => {
                                    return root.selected-songs.length > 0 ? root.selected-songs : [song];
                                }

                                item_pressed(event) => {
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                        root.selected-indices = UtilCallbacks.update_selection(
                                            root.selected-indices,
                                            index,
                                            root.anchor-idx,
                                            event.modifiers.control || event.modifiers.meta,
                                            event.modifiers.shift,
                                            false,
                                            root.display-songs.length);
                                        if (!event.modifiers.shift) {
                                            root.anchor-idx = index;
                                        }
                                        root.active-idx = index;
                                    }
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                        root.selected-indices = UtilCallbacks.update_selection(
                                            root.selected-indices,
                                            index,
                                            root.anchor-idx,
                                            false,
                                            false,
                                            true,
                                            root.display-songs.length);
                                        root.active-idx = index;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
