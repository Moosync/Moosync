import { ListView } from "std-widgets.slint";
import {
    SongModel,
    SongSortCriterion,
} from "../types/song_view.slint";
import { ExtensionProviderItem } from "../types/extension_view.slint";
import { SongListItemMobile } from "song_list_item_mobile.slint";
import { GhostSongListItemMobile } from "ghost_items_mobile.slint";
import { Theme, Constants } from "../constants_mobile.slint";
import {
    AppCallbacks,
    UtilCallbacks,
    ContextMenuCallbacks,
} from "../callbacks.slint";
import { ScrollActivity } from "scroll_activity_mobile.slint";
import { SongSelectionState, SongSortState } from "selection_props.slint";

export component SongListViewMobile inherits Rectangle {
    in property <[SongModel]> songs: Constants.testSongs;
    in-out property <[ExtensionProviderItem]> extension_providers: [];
    callback provider_toggled(string, bool);
    callback load_more();
    callback play_all();
    in-out property <int> active-idx: -1;
    in-out property <[int]> selected-indices: [];
    in-out property <bool> selection_mode <=> SongSelectionState.selection_mode;
    in property <bool> show-controls: true;
    in property <bool> show_play_all: false;
    in property <bool> is_loading: false;
    out property <bool> is_scrollable: list_view.content-height > list_view.height;

    property <bool> select_all_trigger: SongSelectionState.select_all_trigger;
    property <bool> clear_selection_trigger: SongSelectionState.clear_selection_trigger;

    changed select_all_trigger => {
        if (root.selection_mode && root.display-songs.length > 0) {
            if (root.selected-indices.length == root.display-songs.length) {
                root.cancel_selection();
            } else {
                root.selected-indices = UtilCallbacks.select_all(root.display-songs.length);
                SongSelectionState.selected_count = root.selected-indices.length;
                SongSelectionState.selected_songs = root.selected-songs;
            }
        }
    }

    changed clear_selection_trigger => {
        root.selected-indices = [];
    }

    changed selected-indices => {
        if (root.selection_mode && root.display-songs.length > 0) {
            SongSelectionState.selected_count = root.selected-indices.length;
            SongSelectionState.selected_songs = root.selected-songs;
            if (root.selected-indices.length == 0) {
                root.cancel_selection();
            }
        }
    }

    public function cancel_selection() {
        root.selected-indices = [];
        root.selection_mode = false;
        SongSelectionState.selection_mode = false;
        SongSelectionState.selected_count = 0;
        SongSelectionState.total_count = 0;
        SongSelectionState.selected_songs = [];
    }

    public function toggle_selection_mode(idx: int) {
        if (!root.selection_mode) {
            root.selection_mode = true;
            SongSelectionState.selection_mode = true;
            SongSelectionState.total_count = root.display-songs.length;
            root.selected-indices = UtilCallbacks.update_selection(
                [],
                idx,
                0,
                true,
                false,
                false,
                root.display-songs.length);
            SongSelectionState.selected_count = root.selected-indices.length;
            SongSelectionState.selected_songs = root.selected-songs;
        } else {
            root.cancel_selection();
        }
    }

    changed display-songs => {
        if (!root.is_scrollable) {
            root.load_more();
        }
    }

    out property <[SongModel]> display-songs: (root.sort-criterion == SongSortCriterion.Title && root.sort-ascending) ? root.songs : AppCallbacks.filter_and_sort_songs(
        root.songs,
        "",
        root.sort-criterion,
        root.sort-ascending);

    out property <[SongModel]> selected-songs: UtilCallbacks.get_selected_songs(root.display-songs, root.selected-indices);

    in-out property <SongSortCriterion> sort-criterion <=> SongSortState.sort_criterion;
    in-out property <bool> sort-ascending <=> SongSortState.sort_ascending;

    scroll_activity := ScrollActivity {
        position: list_view.content-y;
    }

    list_view := ListView {
        width: 100%;
        height: 100%;
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: scroll_activity.active ? as-needed : always-off;
        for idx in (root.display-songs.length + (root.is_loading ? 6 : 0)): VerticalLayout {
            padding-bottom: Theme.spacingXs;
            padding-left: Theme.paddingSm;
            padding-right: Theme.paddingSm;

            if (idx < root.display-songs.length): SongListItemMobile {
                song: root.display-songs[idx];
                is_selected: UtilCallbacks.is_index_selected(root.selected-indices, idx);
                selection_mode: root.selection_mode;
                long_pressed => {
                    root.toggle_selection_mode(idx);
                }
                clicked => {
                    if (root.selection_mode) {
                        root.selected-indices = UtilCallbacks.update_selection(
                            root.selected-indices,
                            idx,
                            0,
                            true,
                            false,
                            false,
                            root.display-songs.length);
                        SongSelectionState.selected_count = root.selected-indices.length;
                        SongSelectionState.selected_songs = root.selected-songs;
                    } else {
                        AppCallbacks.play-song(root.display-songs[idx]);
                    }
                }
                item_pressed(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                        root.toggle_selection_mode(idx);
                    }
                }
            }

            if (idx >= root.display-songs.length): GhostSongListItemMobile {
                item_index: idx - root.display-songs.length;
            }
        }
    }
}
