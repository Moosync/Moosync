import { ListView, VerticalBox } from "std-widgets.slint";
import { SongModel, SongDetailAction } from "../types/song_view.slint";
import { SongListItem } from "song_list_item.slint";
import { SongDetails } from "song_details.slint";
import { Constants, Theme } from "../constants.slint";
import { AppCallbacks } from "../callbacks.slint";

export component SongsPageLayout inherits Rectangle {
    in-out property <int> active-idx: -1;
    property <SongModel> active: active-idx >= 0 ? songs[active-idx] : default-song;

    in property <[SongModel]> songs: Constants.testSongs;
    in property <SongModel> default-song: Constants.defaultSong;

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            active-idx = -1;
        }
    }

    HorizontalLayout {
        height: 100%;
        HorizontalLayout {
            horizontal-stretch: 2;
            SongDetails {
                song: active;

                HorizontalLayout {
                    spacing: Theme.spacingMd;
                    alignment: start;
                    padding-top: Theme.spacingSm;

                    // Play Now button
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: Theme.borderRadiusMd;
                        background: play-touch.has-hover ? Theme.secondary : transparent;

                        play-touch := TouchArea {
                            clicked => {
                                AppCallbacks.song_detail_action(
                                    SongDetailAction.Play,
                                    root.active-idx >= 0 ? [root.active] : root.songs);
                            }
                        }

                        Image {
                            width: 20px;
                            height: 20px;
                            source: @image-url("../icons/plain_play.svg");
                            colorize: play-touch.has-hover ? Theme.accent.brighter(0.2) : Theme.accent;
                        }
                    }

                    // Add to Queue button
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: Theme.borderRadiusMd;
                        background: queue-touch.has-hover ? Theme.secondary : transparent;

                        queue-touch := TouchArea {
                            clicked => {
                                AppCallbacks.song_detail_action(
                                    SongDetailAction.AddToQueue,
                                    root.active-idx >= 0 ? [root.active] : root.songs);
                            }
                        }

                        Image {
                            width: 20px;
                            height: 20px;
                            source: @image-url("../icons/add_to_queue.svg");
                            colorize: queue-touch.has-hover ? Theme.accent.brighter(0.2) : Theme.accent;
                        }
                    }
                }
            }
        }

        VerticalBox {
            horizontal-stretch: 3;

            ListView {
                vertical-scrollbar-policy: always-on;
                preferred-height: songs.length * Theme.songListItemHeight;

                for song[index] in songs: VerticalLayout {

                    HorizontalLayout {
                        padding-bottom: Theme.paddingSm;
                        padding-right: Theme.spacingXl;

                        Rectangle {
                            SongListItem {
                                song: song;
                                border-width: (active-idx == index || self.has-hover) ? Theme.borderWidth * 2 : 0px;
                                border-color: active-idx == index ? Theme.accent : Theme.accent.darker(0.2);

                                changed pressed => {
                                    if self.pressed {
                                        active-idx = index;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
