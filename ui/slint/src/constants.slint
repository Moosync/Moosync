export enum Pages {
    AllSongs,
    Albums,
    Artists,
    Playlists,
    Genres,
    Explore,
    Search,
    PlaylistContent,
    AlbumContent,
    ArtistContent,
    GenreContent }

export enum SettingsPages { Paths, System, Extensions, Themes }

export enum QueuePages { Queue }

export enum VolumeScale { Linear, Logarithmic }

export struct RgbaColor {
        r: float,
        g: float,
        b: float,
        a: float,
    }

export struct ThemeConfig {
        id: string,
        name: string,
        description: string,
        author: string,
        preview_bg: RgbaColor,
        accent_color: RgbaColor,
        primary_color: RgbaColor,
        secondary_color: RgbaColor,
        border_radius: float,
        border_width: float,
    }

export struct ThemeConstant {
        name: string,
        value: string,
        is_color: bool,
        color_value: RgbaColor,
    }

export global Theme {
    // Colors
    in-out property <color> primary: #212121;
        in-out property <color> secondary: #282828;
        in-out property <color> tertiary: #151515;
        in-out property <color> textPrimary: #ffffff;
        in-out property <color> textSecondary: #565656;
        in-out property <color> textInverse: #000000;
        in-out property <color> accent: #65cb88;
        in-out property <color> divider: rgba(0, 0, 0, 0.0);

        // Font Sizes
    in-out property <length> pageHeader: 32px;
        in-out property <length> modelTitle: 16px;
        in-out property <length> subtitle: 14px;
        in-out property <length> body: 13px;
        in-out property <length> caption: 11px;
        in-out property <length> extraSmall: 10px;

        // Spacing
    in-out property <length> spacingXxl: 30px;
        in-out property <length> spacingXl: 20px;
        in-out property <length> spacingLg: 16px;
        in-out property <length> spacingMd: 12px;
        in-out property <length> spacingSm: 10px;
        in-out property <length> spacingXs: 8px;
        in-out property <length> spacingXxs: 4px;
        in-out property <length> spacingTiny: 2px;

        // Paddings
    in-out property <length> paddingLg: 16px;
        in-out property <length> paddingMd: 14px;
        in-out property <length> paddingSm: 10px;
        in-out property <length> paddingXs: 8px;

        // Border Radius
    in-out property <length> borderRadiusXl: 16px;
        in-out property <length> borderRadiusLg: 8px;
        in-out property <length> borderRadiusMd: 6px;
        in-out property <length> borderRadiusSm: 1.5px;

        // Border
    in-out property <length> borderWidth: 1px;

        // Icon Sizes
    in-out property <length> iconSizeXl: 24px;
        in-out property <length> iconSizeLg: 20px;
        in-out property <length> iconSizeMd: 16px;
        in-out property <length> iconSizeSm: 13px;

        // Component Dimensions
    in-out property <length> cardWidth: 200px;
        in-out property <length> cardHeight: Theme.cardWidth + Theme.modelTitle + Theme.spacingXl;
        in-out property <length> sidebarWidth: 261px;
        in-out property <length> bottombarHeight: 72px;
        in-out property <length> topbarHeight: 48px;
        in-out property <length> sidebarButtonHeight: 48px;
