import { AlbumModel } from "../types/song_view.slint";
import { GridListView } from "../common/grid_list_view.slint";
import { Constants, Theme } from "../constants.slint";
import { WindowInfo } from "../window_info.slint";

export component AlbumsPage inherits Rectangle {
    in property <[AlbumModel]> albums: Constants.testAlbums;

    property <int> maxColumns: Math.max(1, Math.floor((WindowInfo.window-width - WindowInfo.sidebar-width) / 216px));
    changed maxColumns => {
        debug("maxColumns: ", maxColumns)
    }

    background: transparent;

    VerticalLayout {
        spacing: 30px;
        alignment: start;

        text := Text {
            height: Theme.pageHeader + 15px;
            text: "Albums";
            font-size: Theme.pageHeader;
            color: Theme.textPrimary;
        }

        GridListView {
            height: root.height - text.height - 45px;
            max-columns: root.maxColumns;
            total-items: root.albums.length;
            item-title(idx) => {
                root.albums[idx].title
            }
            item-cover(idx) => {
                root.albums[idx].coverPath
            }
        }
    }
}
