import { AlbumModel } from "../types/song_view.slint";
import { GridListView } from "../common/grid_list_view.slint";
import { Constants, Theme, Pages, SelectedEntity } from "../constants.slint";

export component AlbumsPage inherits Rectangle {
    in property <[AlbumModel]> albums: Constants.testAlbums;
    in-out property <Pages> active-page;
    in-out property <SelectedEntity> selected-entity;

    background: transparent;

    VerticalLayout {
        spacing: Theme.spacingXxl;
        alignment: start;

        text := Text {
            height: Theme.pageHeader + Theme.paddingLg;
            text: "Albums";
            font-size: Theme.pageHeader;
            color: Theme.textPrimary;
        }

        GridListView {
            height: root.height - text.height - (Theme.spacingXxl + Theme.paddingLg);
            item-width: Theme.cardWidth;
            total-items: root.albums.length;
            item-title(idx) => {
                root.albums[idx].title
            }
            item-cover(idx) => {
                root.albums[idx].coverPath
            }
            item-clicked(idx) => {
                root.selected-entity = {
                    id: root.albums[idx].id,
                    title: root.albums[idx].title,
                    cover-path: root.albums[idx].coverPath,
                };
                root.active-page = Pages.AlbumContent;
            }
        }
    }
}
