import { AlbumModel } from "../types/song_view.slint";
import { GridPageLayoutMobile } from "../common/grid_page_layout_mobile.slint";
import { Pages } from "../constants_mobile.slint";
import { AppProps } from "../app_props.slint";
import { AlbumsPageProps } from "albums_props.slint";

export component AlbumsPageMobile inherits Rectangle {
    GridPageLayoutMobile {
        total_items: AlbumsPageProps.albums.length;
        item_title(idx) => { AlbumsPageProps.albums[idx].title }
        item_cover(idx) => { AlbumsPageProps.albums[idx].coverPath }
        item_extension(idx) => { AlbumsPageProps.albums[idx].extension }
        item_extension_icon(idx) => { AlbumsPageProps.albums[idx].extension_icon }
        item_clicked(idx) => {
            AlbumsPageProps.selected-album = AlbumsPageProps.albums[idx];
            AppProps.active_page = Pages.AlbumContent;
        }
    }
}
