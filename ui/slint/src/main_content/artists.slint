import { ArtistModel } from "../types/song_view.slint";
import { GridPageLayout } from "../common/grid_page_layout.slint";
import { Constants, Pages } from "../constants.slint";
import { AppProps } from "../props.slint";

export global ArtistsPageProps {
    in-out property <[ArtistModel]> artists: Constants.testArtists;
    in-out property <ArtistModel> selected-artist;
}

export component ArtistsPage inherits Rectangle {
    background: transparent;

    GridPageLayout {
        title: @tr("Artists");
        total_items: ArtistsPageProps.artists.length;
        item_title(idx) => {
            ArtistsPageProps.artists[idx].title
        }
        item_cover(idx) => {
            ArtistsPageProps.artists[idx].coverPath
        }
        item_extension(idx) => {
            ArtistsPageProps.artists[idx].extension
        }
        item_extension_icon(idx) => {
            ArtistsPageProps.artists[idx].extension_icon
        }
        item_clicked(idx) => {
            ArtistsPageProps.selected-artist = ArtistsPageProps.artists[idx];
            AppProps.active_page = Pages.ArtistContent;
        }
    }
}
