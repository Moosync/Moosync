import { Theme } from "../constants.slint";

export component ExplorePage inherits Rectangle {
    background: transparent;
    width: 100%;
    height: 100%;

    VerticalLayout {
        spacing: Theme.spacingSm;
        padding: Theme.spacingXl;

        Text {
            text: "Explore";
            height: Theme.pageHeader + Theme.paddingLg;
            font-size: Theme.pageHeader;
            color: Theme.textPrimary;
        }

        // Placeholder for explore content
        Rectangle {
            background: Theme.tertiary;
            border-radius: Theme.borderRadiusLg;
            width: 100%;
            height: Theme.exploreThumbnailSize;

            Text {
                text: "Explore content goes here";
                color: Theme.textSecondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }
}
