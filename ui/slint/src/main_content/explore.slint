import { Theme } from "../constants.slint";

export component ExplorePage inherits Rectangle {
    background: transparent;
    width: 100%;
    height: 100%;

    VerticalLayout {
        spacing: 10px;
        padding: 20px;

        Text {
            text: "Explore";
            height: Theme.pageHeader + 15px;
            font-size: Theme.pageHeader;
            color: Theme.textPrimary;
        }

        // Placeholder for explore content
        Rectangle {
            background: Theme.tertiary;
            border-radius: 8px;
            width: 100%;
            height: 200px;

            Text {
                text: "Explore content goes here";
                color: Theme.textSecondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }
}
