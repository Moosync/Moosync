import { GenreModel } from "../types/song_view.slint";
import { GridPageLayout } from "../common/grid_page_layout.slint";
import { Constants, Pages } from "../constants.slint";
import { AppProps } from "../props.slint";

export global GenresPageProps {
    in-out property <[GenreModel]> genres: Constants.testGenres;
    in-out property <GenreModel> selected-genre;
}

export component GenresPage inherits Rectangle {
    background: transparent;

    GridPageLayout {
        title: @tr("Genres");
        total_items: GenresPageProps.genres.length;
        item_title(idx) => {
            GenresPageProps.genres[idx].title
        }
        item_cover(idx) => {
            GenresPageProps.genres[idx].coverPath
        }
        item_clicked(idx) => {
            GenresPageProps.selected-genre = GenresPageProps.genres[idx];
            AppProps.active_page = Pages.GenreContent;
        }
    }
}
