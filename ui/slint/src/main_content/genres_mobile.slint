import { GenreModel } from "../types/song_view.slint";
import { GridPageLayoutMobile } from "../common/grid_page_layout_mobile.slint";
import { Pages } from "../constants_mobile.slint";
import { AppProps } from "../app_props.slint";
import { ContextMenuCallbacks } from "../callbacks.slint";
import { GenresPageProps } from "genres_props.slint";

export component GenresPageMobile inherits Rectangle {
    GridPageLayoutMobile {
        total_items: GenresPageProps.genres.length;
        enable_context_menu: true;
        item_title(idx) => { GenresPageProps.genres[idx].title }
        item_cover(idx) => { GenresPageProps.genres[idx].coverPath }
        item_clicked(idx) => {
            GenresPageProps.selected-genre = GenresPageProps.genres[idx];
            AppProps.active_page = Pages.GenreContent;
        }
        get_context_menu_items(idx) => {
            ContextMenuCallbacks.get_genre_menu_items([GenresPageProps.genres[idx]])
        }
        context_menu_action(idx, action_id) => {
            ContextMenuCallbacks.genre_action([GenresPageProps.genres[idx]], action_id)
        }
    }
}
