import { LyricLineModel } from "../types/song_view.slint";
import { Theme } from "../constants.slint";
import { WindowInfo } from "../window_info.slint";
import { QueuePageProps } from "queue_props.slint";
import { PlayerProps } from "../bottombar/playback_props.slint";
import { AppCallbacks } from "../callbacks.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { TextButton } from "../common/text_button.slint";

export component LyricsView inherits HorizontalLayout {
    in property <[LyricLineModel]> lyrics_lines: QueuePageProps.lyrics_lines;
    in property <bool> is_synced: QueuePageProps.is_synced;
    in property <bool> lyrics_loading: QueuePageProps.lyrics_loading;
    in property <bool> has_lyrics: QueuePageProps.has_lyrics;

    alignment: start;
    spacing: Theme.spacingMd;
    width: WindowInfo.window-size > WindowInfo.md ? Theme.songDetailsThumbnailSize : 0px;
    visible: WindowInfo.window-size > WindowInfo.md;

    pure function get_line_opacity(idx: int, active_idx: int) -> float {
        if (active_idx == -1) {
            return 0.75;
        }
        let d = Math.abs(idx - active_idx);
        if (d == 0) {
            return 1.0;
        }
        if (d == 1) {
            return 0.70;
        }
        if (d == 2) {
            return 0.50;
        }
        if (d == 3) {
            return 0.35;
        }
        return 0.20;
    }

    property <int> active_index: (root.is_synced && root.lyrics_lines.length > 0)
        ? AppCallbacks.get_active_lyric_index(root.lyrics_lines, PlayerProps.current_duration_ms + QueuePageProps.lyrics_offset_ms)
        : -1;

    function scroll_to_active_lyric() {
        if (root.active_index >= 0 && root.is_synced && !root.lyrics_loading && root.has_lyrics && lyrics_scroll.height > 0px) {
            let max_scroll = Math.max(0px, lyrics_scroll.content-height - lyrics_scroll.height);
            let line_y = Theme.size3Xl + root.active_index * (Theme.size3Xl + Theme.spacingXs);
            let target_y = -line_y + (lyrics_scroll.height / 2) - (Theme.size3Xl / 2);
            lyrics_scroll.content-y = Math.max(-max_scroll, Math.min(0px, target_y));
        }
    }

    changed active_index => {
        root.scroll_to_active_lyric();
    }

    changed has_lyrics => {
        root.scroll_to_active_lyric();
    }

    changed lyrics_loading => {
        root.scroll_to_active_lyric();
    }

    property <bool> is_lyrics_visible: QueuePageProps.show_lyrics && QueuePageProps.show_queue;
    changed is_lyrics_visible => {
        if (self.is_lyrics_visible) {
            root.scroll_to_active_lyric();
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: Theme.spacingSm;

        // Top Header
        HorizontalLayout {
            alignment: space-between;
            padding-bottom: Theme.spacingXs;

            HorizontalLayout {
                spacing: Theme.spacingSm;
                alignment: start;

                Text {
                    text: @tr("Lyrics");
                    color: Theme.textPrimary;
                    font-size: Theme.modelTitle;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                if (root.has_lyrics): Rectangle {
                    background: Theme.accent.transparentize(0.85);
                    border-radius: Theme.borderRadiusSm;
                    border-width: Theme.borderWidth;
                    border-color: Theme.accent.transparentize(0.5);
                    clip: true;
                    height: Theme.sizeLg;

                    HorizontalLayout {
                        padding-left: Theme.borderRadiusMd;
                        padding-right: Theme.borderRadiusMd;
                        alignment: center;

                        Text {
                            text: root.is_synced ? @tr("Synced") : @tr("Plain");
                            color: Theme.accent;
                            font-size: Theme.caption;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.spacingSm;
                alignment: end;

                TextButton {
                    text: @tr("Show Details");
                    font_size: Theme.subtitle;
                    clicked => {
                        QueuePageProps.show_lyrics = false;
                    }
                }
            }
        }

        if (root.has_lyrics && root.is_synced): HorizontalLayout {
            spacing: Theme.spacingXs;
            alignment: start;

            TextButton {
                text: "-100ms";
                font_size: Theme.caption;
                clicked => {
                    AppCallbacks.set_lyrics_offset(QueuePageProps.lyrics_offset_ms - 100);
                }
            }

            TextButton {
                text: (QueuePageProps.lyrics_offset_ms > 0 ? "+" : "") + QueuePageProps.lyrics_offset_ms + "ms";
                font_size: Theme.caption;
                clicked => {
                    AppCallbacks.set_lyrics_offset(0);
                }
            }

            TextButton {
                text: "+100ms";
                font_size: Theme.caption;
                clicked => {
                    AppCallbacks.set_lyrics_offset(QueuePageProps.lyrics_offset_ms + 100);
                }
            }
        }

        // Lyrics Content Area
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            if (root.lyrics_loading): HorizontalLayout {
                alignment: center;

                Text {
                    text: @tr("Loading lyrics...");
                    color: Theme.textSecondary;
                    font-size: Theme.body;
                    vertical-alignment: center;
                }
            }

            if (!root.lyrics_loading && !root.has_lyrics): HorizontalLayout {
                alignment: center;

                Text {
                    text: @tr("No lyrics available");
                    color: Theme.textSecondary;
                    font-size: Theme.body;
                    vertical-alignment: center;
                }
            }

            lyrics_scroll := ScrollView {
                visible: !root.lyrics_loading && root.has_lyrics && root.is_synced;
                width: 100%;
                height: 100%;
                horizontal-scrollbar-policy: always-off;

                changed height => {
                    root.scroll_to_active_lyric();
                }

                changed content-height => {
                    root.scroll_to_active_lyric();
                }

                animate content-y {
                    duration: Theme.durationMedium;
                    easing: ease-out;
                }

                VerticalLayout {
                    width: parent.visible-width;
                    alignment: start;
                    padding-top: Theme.size3Xl;
                    padding-bottom: Theme.size3Xl;
                    spacing: Theme.spacingXs;

                    for line[idx] in root.lyrics_lines: Rectangle {
                        min-height: Theme.size3Xl;
                        width: 100%;

                        Text {
                            width: 100%;
                            text: line.text;
                            color: (idx == root.active_index) ? Theme.accent : Theme.textPrimary;
                            font-size: (idx == root.active_index) ? Theme.modelTitle : Theme.body;
                            font-weight: (idx == root.active_index) ? 700 : 500;
                            opacity: root.get_line_opacity(idx, root.active_index);
                            vertical-alignment: center;
                            wrap: word-wrap;

                            animate opacity {
                                duration: Theme.durationMedium;
                                easing: ease-in-out;
                            }
                        }
                    }
                }
            }

            if (!root.lyrics_loading && root.has_lyrics && !root.is_synced): ScrollView {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    alignment: start;
                    spacing: Theme.spacingXs;
                    padding-right: Theme.paddingSm;

                    for line[idx] in root.lyrics_lines: Text {
                        text: line.text;
                        color: Theme.textPrimary;
                        font-size: Theme.body;
                        opacity: 0.85;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
