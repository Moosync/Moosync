import { LyricLineModel } from "../types/song_view.slint";
import { Theme } from "../constants_mobile.slint";
import { QueuePageProps } from "queue_props.slint";
import { PlayerProps } from "../bottombar/playback_props.slint";
import { AppCallbacks } from "../callbacks.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { ScrollActivity } from "../common/scroll_activity_mobile.slint";
import { TextButton } from "../common/text_button.slint";

export component LyricsViewMobile inherits Rectangle {
    in property <[LyricLineModel]> lyrics_lines: QueuePageProps.lyrics_lines;
    in property <bool> is_synced: QueuePageProps.is_synced;
    in property <bool> lyrics_loading: QueuePageProps.lyrics_loading;
    in property <bool> has_lyrics: QueuePageProps.has_lyrics;

    property <int> active_index: (root.is_synced && root.lyrics_lines.length > 0)
        ? AppCallbacks.get_active_lyric_index(root.lyrics_lines, PlayerProps.current_duration_ms + QueuePageProps.lyrics_offset_ms)
        : -1;

    function scroll_to_active_lyric() {
        if (root.active_index >= 0 && root.is_synced && !root.lyrics_loading && root.has_lyrics && lyrics_list.height > 0px) {
            let item_height = Theme.mobileLyricsActiveFontSize + Theme.spacingSm * 2;
            let max_scroll = Math.max(0px, lyrics_list.content-height - lyrics_list.height);
            let line_y = Theme.size3Xl + root.active_index * item_height;
            let target_y = -line_y + (lyrics_list.height / 2) - (item_height / 2);
            lyrics_list.content-y = Math.max(-max_scroll, Math.min(0px, target_y));
        }
    }

    changed active_index => {
        root.scroll_to_active_lyric();
    }

    changed has_lyrics => {
        root.scroll_to_active_lyric();
    }

    changed lyrics_loading => {
        root.scroll_to_active_lyric();
    }

    property <bool> is_tab_active: QueuePageProps.active_tab == 2 && QueuePageProps.show_queue;
    changed is_tab_active => {
        if (self.is_tab_active) {
            root.scroll_to_active_lyric();
        }
    }

    pure function get_line_opacity(idx: int, active_idx: int) -> float {
        if (active_idx == -1) { return 0.75; }
        let d = Math.abs(idx - active_idx);
        if (d == 0) { return 1.0; }
        if (d == 1) { return 0.65; }
        if (d == 2) { return 0.45; }
        return 0.25;
    }

    scroll_activity := ScrollActivity {
        position: lyrics_list.content-y;
    }

    VerticalLayout {
        padding: Theme.paddingMd;
        spacing: Theme.spacingMd;

        if (!root.lyrics_loading && root.has_lyrics && root.is_synced): HorizontalLayout {
            alignment: center;
            spacing: Theme.spacingSm;

            TextButton {
                text: "-100ms";
                font_size: Theme.caption;
                clicked => {
                    AppCallbacks.set_lyrics_offset(QueuePageProps.lyrics_offset_ms - 100);
                }
            }

            TextButton {
                text: (QueuePageProps.lyrics_offset_ms > 0 ? "+" : "") + QueuePageProps.lyrics_offset_ms + "ms";
                font_size: Theme.caption;
                clicked => {
                    AppCallbacks.set_lyrics_offset(0);
                }
            }

            TextButton {
                text: "+100ms";
                font_size: Theme.caption;
                clicked => {
                    AppCallbacks.set_lyrics_offset(QueuePageProps.lyrics_offset_ms + 100);
                }
            }
        }

        if (root.lyrics_loading): Rectangle {
            vertical-stretch: 1;

            Text {
                text: @tr("Loading lyrics...");
                color: Theme.textSecondary;
                font-size: Theme.body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if (!root.lyrics_loading && !root.has_lyrics): Rectangle {
            vertical-stretch: 1;

            Text {
                text: @tr("No lyrics available");
                color: Theme.textSecondary;
                font-size: Theme.body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        lyrics_list := ScrollView {
            visible: !root.lyrics_loading && root.has_lyrics;
            width: 100%;
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy: scroll_activity.active ? as-needed : always-off;

            changed height => {
                root.scroll_to_active_lyric();
            }

            changed content-height => {
                root.scroll_to_active_lyric();
            }

            animate content-y {
                duration: Theme.durationMedium;
                easing: ease-out;
            }

            VerticalLayout {
                width: parent.visible-width;
                alignment: start;
                padding-top: Theme.size3Xl;
                padding-bottom: Theme.size3Xl;

                for line[idx] in root.lyrics_lines: Rectangle {
                    min-height: Theme.mobileLyricsActiveFontSize + Theme.spacingSm * 2;
                    width: 100%;

                    Text {
                        accessible-role: text;
                        accessible-label: line.text;
                        width: 100%;
                        text: line.text;
                        font-size: (idx == root.active_index) ? Theme.mobileLyricsActiveFontSize : Theme.mobileLyricsInactiveFontSize;
                        font-weight: (idx == root.active_index) ? 700 : 500;
                        color: (idx == root.active_index) ? Theme.accent : Theme.textPrimary;
                        opacity: root.get_line_opacity(idx, root.active_index);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
