import { SongModel, CoverHelper } from "../types/song_view.slint";
import { Theme, Constants, QueuePages } from "../constants.slint";
import { ListView } from "std-widgets.slint";
import { AppCallbacks } from "../callbacks.slint";
import { Button } from "../common/button.slint";
import { SongDetails } from "../common/song_details.slint";

// QueueListItem displays one song item within the list and processes drag and drop events.
component QueueListItem inherits Rectangle {
    in property <SongModel> song;
    in property <int> item-idx; // Visual index of the item slot
    in property <int> model-idx; // Source index of the song in the queue model
    in property <bool> is-active: false;
    in property <bool> is-ghost: false; // Displays the card as a semi-transparent placeholder card
    in-out property <int> drag-source-idx: -1;
    in-out property <int> drag-target-idx: -1;
    in-out property <length> drag-mouse-y: -1px;
    in property <length> list-viewport-y: 0px;
    callback clicked();
    callback remove-clicked();

    background: transparent;
    height: 60px + Theme.paddingSm; // Item height including spacing offset

    DragArea {
        width: 100%;
        height: 100%;
        allow-move: true;
        preferred-action: DragAction.move;
        data: AppCallbacks.string-to-transfer(root.model-idx); // Passes model-idx to string serializer

        DropArea {
            width: 100%;
            height: 100%;

            // Updates drag source, target, and mouse Y coordinate when the cursor drags over this area.
            can-drop(event) => {
                if (event.allow-move) {
                    root.drag-source-idx = AppCallbacks.transfer-to-string(event.data).to-float();
                    root.drag-target-idx = root.item-idx;
                    // Computes y coordinate of mouse relative to visible list viewport
                    root.drag-mouse-y = root.item-idx * (60px + Theme.paddingSm) + event.position.y + root.list-viewport-y;
                    return DragAction.move;
                }
                return DragAction.none;
            }

            // Calls AppCallbacks.move-queue-item and resets indices on drop completion.
            dropped(event) => {
                AppCallbacks.move-queue-item(AppCallbacks.transfer-to-string(event.data), root.item-idx);
                root.drag-source-idx = -1;
                root.drag-target-idx = -1;
                root.drag-mouse-y = -1px;
                return event.proposed-action;
            }

            VerticalLayout {
                width: 100%;
                height: 100%;

                // Card container rendering backgrounds, borders, and hover states.
                Rectangle {
                    height: 60px;
                    background: root.is-ghost ? Theme.accent.transparentize(0.9) : (touch.has-hover ? rgba(255, 255, 255, 0.05) : transparent);
                    border-radius: Theme.borderRadiusMd;
                    border-width: root.is-ghost ? 1px : 0px;
                    border-color: root.is-ghost ? Theme.accent.transparentize(0.7) : transparent;
                    opacity: root.is-ghost ? 0.4 : 1.0;

                    touch := TouchArea {
                        // Resets drag indices and mouse Y coordinates on release or cancel.
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                root.drag-source-idx = -1;
                                root.drag-target-idx = -1;
                                root.drag-mouse-y = -1px;
                            }
                        }
                        clicked => { root.clicked(); }
                    }

                    HorizontalLayout {
                        padding-left: Theme.paddingXs;
                        padding-right: Theme.paddingXs;
                        padding-top: Theme.paddingXs;
                        padding-bottom: Theme.paddingXs;
                        spacing: Theme.spacingMd;

                        // Thumbnail
                        Rectangle {
                            width: Theme.songListItemThumbnailSize;
                            height: Theme.songListItemThumbnailSize;
                            border-radius: Theme.borderRadiusMd;
                            clip: true;

                            Image {
                                width: 100%;
                                height: 100%;
                                source: song.coverPathLow;
                                image-fit: cover;
                            }
                        }

                        // Details
                        VerticalLayout {
                            alignment: center;
                            spacing: Theme.spacingTiny;
                            horizontal-stretch: 1;

                            HorizontalLayout {
                                spacing: Theme.spacingSm;
                                alignment: start;

                                Text {
                                    text: song.title;
                                    color: root.is-active ? Theme.accent : Theme.textPrimary;
                                    font-size: Theme.body;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                if song.extensionIcon.height > 0 || song.extensionIcon.width > 0: Image {
                                    width: Theme.iconSizeSm;
                                    source: song.extensionIcon;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 0px;
                                for artist[i] in song.artists: HorizontalLayout {
                                    spacing: 0px;
                                    Text {
                                        text: (i > 0 ? ", " : "") + artist.title;
                                        color: Theme.textSecondary;
                                        font-size: Theme.caption;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        // Delete button
                        if touch.has-hover || root.is-active: VerticalLayout {
                            alignment: center;

                            TouchArea {
                                width: Theme.iconSizeLg;
                                height: Theme.iconSizeLg;
                                clicked => { root.remove-clicked(); }

                                Image {
                                    width: Theme.iconSizeMd;
                                    height: Theme.iconSizeMd;
                                    source: @image-url("../icons/cross.svg");
                                    colorize: #ff5555; // Red color for delete
                                }
                            }
                        }
                    }
                }

                // Transparent bottom gap (vertical spacer)
                Rectangle {
                    height: Theme.paddingSm;
                }
            }
        }
    }
}

export component QueuePage inherits Rectangle {
    in property <QueuePages> page-type: QueuePages.Queue;
    in property <[SongModel]> queue: Constants.testSongs;
    in property <SongModel> current-song: Constants.defaultSong;
    in-out property <int> active-idx: -1;

    in-out property <int> drag-source-idx: -1;
    in-out property <int> drag-target-idx: -1;
    in-out property <length> drag-mouse-y: -1px;

    // Resets drag source, target, and mouse Y coordinates when the queue list changes.
    changed queue => {
        root.drag-source-idx = -1;
        root.drag-target-idx = -1;
        root.drag-mouse-y = -1px;
    }

    // Scroll the viewport and update the active drop target index dynamically when drag-mouse-y changes.
    changed drag-mouse-y => {
        if (root.drag-source-idx != -1 && root.drag-mouse-y >= 0px) {
            // Scroll up near the top boundary (top 50px)
            if (root.drag-mouse-y < 50px) {
                list-view.viewport-y = Math.min(0px, list-view.viewport-y + (50px - root.drag-mouse-y) * 0.5);
                root.drag-target-idx = Math.max(0, Math.min(root.queue.length - 1, (root.drag-mouse-y - list-view.viewport-y) / (60px + Theme.paddingSm)));
            }
            // Scroll down near the bottom boundary (bottom 50px)
            if (root.drag-mouse-y > list-view.height - 50px) {
                list-view.viewport-y = Math.max(-(list-view.viewport-height - list-view.height), list-view.viewport-y - (root.drag-mouse-y - (list-view.height - 50px)) * 0.5);
                root.drag-target-idx = Math.max(0, Math.min(root.queue.length - 1, (root.drag-mouse-y - list-view.viewport-y) / (60px + Theme.paddingSm)));
            }
        }
    }

    // Returns the model index corresponding to a visual position during a drag operation.
    pure function get-mapped-idx(visual-idx: int, F: int, T: int) -> int {
        if (F == -1 || T == -1 || F == T) {
            return visual-idx;
        }
        if (visual-idx == T) {
            return F;
        }
        if (F < T) {
            if (visual-idx >= F && visual-idx < T) {
                return visual-idx + 1;
            }
        } else {
            if (visual-idx > T && visual-idx <= F) {
                return visual-idx - 1;
            }
        }
        return visual-idx;
    }

    // Blurred cover image passed from MainWindow
    in property <image> blurred-cover;

    background: Theme.primary;

    // Background blurred artwork effect
    Image {
        width: 100%;
        height: 100%;
        source: root.blurred-cover;
        image-fit: cover;
        opacity: 0.85;
    }

    // Semi-transparent overlay to make text highly readable and premium
    Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(15, 15, 15, 0.65);
    }

    HorizontalLayout {
        padding: Theme.paddingLg * 2;
        spacing: Theme.spacingXl * 2;

        // Left section: Stretched cover and song info reusing SongDetails
        SongDetails {
            song: root.current-song;

            // Show lyrics button placed below duration via the @children slot
            HorizontalLayout {
                alignment: end;
                padding-top: Theme.spacingSm;
                TouchArea {
                    Text {
                        text: "Show Lyrics";
                        color: Theme.accent;
                        font-size: Theme.subtitle;
                        font-weight: 600;
                    }
                }
            }
        }

        // Right section: Queue controls & list
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.spacingXl;

            // Header Controls: Buttons
            HorizontalLayout {
                height: Theme.searchBarHeight;
                spacing: Theme.spacingMd;

                // Save as playlist button
                Button {
                    text: "Save as playlist";
                    clicked => {
                        // Not implemented but visually clickable
                    }
                }

                // Clear button
                Button {
                    text: "Clear";
                    clicked => {
                        AppCallbacks.clear-queue();
                    }
                }

                // Spacer
                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            // Queue List View
            Rectangle {
                vertical-stretch: 1;
                border-radius: Theme.borderRadiusLg;
                clip: true;

                list-view := ListView {
                    width: 100%;
                    height: 100%;

                    for song[idx] in root.queue: VerticalLayout {
                        padding-right: Theme.paddingSm;

                        property <int> mapped-idx: root.get-mapped-idx(idx, root.drag-source-idx, root.drag-target-idx);
                        property <SongModel> mapped-song: root.queue[mapped-idx];

                        QueueListItem {
                            song: mapped-song;
                            item-idx: idx;
                            model-idx: mapped-idx;
                            is-active: root.current-song.id == mapped-song.id;
                            is-ghost: mapped-idx == root.drag-source-idx && idx == root.drag-target-idx;
                            drag-source-idx <=> root.drag-source-idx;
                            drag-target-idx <=> root.drag-target-idx;
                            drag-mouse-y <=> root.drag-mouse-y;
                            list-viewport-y: list-view.viewport-y;

                            clicked => {
                                AppCallbacks.play-queue-index(mapped-idx);
                            }
                            remove-clicked => {
                                AppCallbacks.remove-from-queue(mapped-idx);
                            }
                        }
                    }
                }
            }
        }
    }
}
