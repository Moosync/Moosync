import { Theme, Constants, Pages } from "../constants.slint";
import {
    SongModel,
    AlbumModel,
    ArtistModel,
    PlaylistModel,
    GenreModel,
    SearchResult,
} from "../types/song_view.slint";
import { SongListView } from "../common/song_list_view.slint";
import { GridListView } from "../common/grid_list_view.slint";
import { AppCallbacks, ContextMenuCallbacks } from "../callbacks.slint";
import { Button } from "../common/button.slint";
import { Utils, DefaultIconType } from "../utils.slint";
import { AccountsProps } from "../common/accounts_props.slint";
import { StatusTooltip } from "../common/status_tooltip.slint";
import { Spinner } from "../common/spinner.slint";
import { AlbumsPageProps } from "albums_props.slint";
import { ArtistsPageProps } from "artists_props.slint";
import { PlaylistsPageProps } from "playlists_props.slint";
import { AppProps } from "../app_props.slint";
import { SearchPageProps } from "search_props.slint";

export struct Provider {
    name: string,
    icon: image,
    is_local: bool,
}

export component ProviderItem inherits Button {
    in property <Provider> provider;
    in property <bool> active: false;

    text: root.provider.name;
    has_custom_layout: true;
    background: root.has_hover ? Theme.secondary.brighter(0.1) : transparent;
    border-radius: Theme.borderRadiusMd;

    VerticalLayout {
        spacing: Theme.spacingXs;
        alignment: center;
        height: Theme.iconSizeMd + Theme.paddingMd;

        HorizontalLayout {
            spacing: Theme.spacingSm;
            alignment: center;
            padding: Theme.paddingSm;

            Image {
                source: Utils.load_image_or_default(root.provider.icon, root.provider.is_local ? DefaultIconType.Folder : DefaultIconType.Extension);
                width: Theme.iconSizeMd;
                height: Theme.iconSizeMd;
                colorize: root.active ? Theme.accent : Theme.textPrimary;
            }

            Text {
                accessible-role: none;
                text: root.provider.name;
                color: root.active ? Theme.accent : Theme.textPrimary;
                font-size: Theme.subtitle;
                vertical-alignment: center;
            }
        }
    }
}


export component SearchPage inherits Rectangle {
    in-out property <int> active_tab <=> SearchPageProps.active_tab;
    in-out property <int> selected_provider <=> SearchPageProps.selected_provider;

    width: 100%;
    height: 100%;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: Theme.spacingXxl;
        padding: Theme.paddingMd;

        // Title
        Text {
            height: Theme.pageHeader + Theme.paddingLg;
            text: @tr("Search");
            font-size: Theme.pageHeader;
            color: Theme.textPrimary;
            font-weight: 700;
        }

        // Provider Wrapping Grid Rows using FlexboxLayout
        FlexboxLayout {
            for prov[idx] in SearchPageProps.provider_results: ProviderItem {
                provider: {
                    name: prov.extension == "" ? @tr("Local") : (prov.extension_name != "" ? prov.extension_name : prov.extension),
                    icon: prov.extension_icon,
                    is_local: prov.extension == ""
                };
                active: root.selected_provider == idx;
                clicked => { SearchPageProps.selected_provider = idx; }
            }
        }

        HorizontalLayout {
            spacing: Theme.spacingLg;
            alignment: start;

            for tab_item[tab_idx] in [
                { name: @tr("Songs"), label: @tr("Search Songs") },
                { name: @tr("Albums"), label: @tr("Search Albums") },
                { name: @tr("Artists"), label: @tr("Search Artists") },
                { name: @tr("Playlists"), label: @tr("Search Playlists") },
                { name: @tr("Genres"), label: @tr("Search Genres") }
            ]: Rectangle {
                accessible-role: tab;
                accessible-label: tab_item.label;
                background: root.active_tab == tab_idx ? Theme.accent : transparent;
                border-radius: Theme.borderRadiusLg * 2;
                border-width: root.active_tab == tab_idx ? 0px : Theme.borderWidth;
                border-color: root.active_tab == tab_idx ? transparent : Theme.textSecondary.with-alpha(0.3);
                height: Theme.searchBarHeight;

                animate background { duration: Theme.durationFast; }

                HorizontalLayout {
                    padding-left: Theme.paddingLg;
                    padding-right: Theme.paddingLg;
                    alignment: center;

                    Text {
                        accessible-role: none;
                        text: tab_item.name;
                        color: root.active_tab == tab_idx ? Theme.textInverse : Theme.textPrimary;
                        font-size: Theme.subtitle;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                TouchArea {
                    clicked => { SearchPageProps.active_tab = tab_idx; }
                }
            }
        }

        res_container := Rectangle {
            vertical-stretch: 1;
            property <SearchResult> current_res: SearchPageProps.provider_results[root.selected_provider];
            property <bool> has_no_results: res_container.current_res.songs.length == 0 &&
                res_container.current_res.albums.length == 0 &&
                res_container.current_res.artists.length == 0 &&
                res_container.current_res.playlists.length == 0 &&
                res_container.current_res.genres.length == 0;

            if (res_container.current_res.loading): Spinner {
                width: Theme.sizeXxl;
                height: Theme.sizeXxl;
            }

            SongListView {
                songs: res_container.current_res.songs;
                opacity: (!res_container.current_res.loading && root.active_tab == 0) ? 1.0 : 0.0;
                visible: !res_container.current_res.loading && self.opacity > 0.01;
                animate opacity {
                    duration: Theme.durationNormal;
                    easing: ease-in-out;
                }
            }

            GridListView {
                item_width: Theme.cardWidth;
                total_items: res_container.current_res.albums.length;
                enable_context_menu: true;
                item_title(idx) => { res_container.current_res.albums[idx].title }
                item_cover(idx) => { res_container.current_res.albums[idx].coverPath }
                item_extension(idx) => { res_container.current_res.albums[idx].extension }
                item_extension_icon(idx) => { res_container.current_res.albums[idx].extension_icon }
                item_clicked(idx) => {
                    AlbumsPageProps.selected_album = res_container.current_res.albums[idx];
                    AppProps.active_page = Pages.AlbumContent;
                }
                get_context_menu_items(idx) => {
                    ContextMenuCallbacks.get_album_menu_items([res_container.current_res.albums[idx]])
                }
                context_menu_action(idx, action_id) => {
                    ContextMenuCallbacks.album_action([res_container.current_res.albums[idx]], action_id)
                }
                opacity: (!res_container.current_res.loading && root.active_tab == 1) ? 1.0 : 0.0;
                visible: !res_container.current_res.loading && self.opacity > 0.01;
                animate opacity {
                    duration: Theme.durationNormal;
                    easing: ease-in-out;
                }
            }

            GridListView {
                item_width: Theme.cardWidth;
                total_items: res_container.current_res.artists.length;
                enable_context_menu: true;
                item_title(idx) => { res_container.current_res.artists[idx].title }
                item_cover(idx) => { res_container.current_res.artists[idx].coverPath }
                item_extension(idx) => { res_container.current_res.artists[idx].extension }
                item_extension_icon(idx) => { res_container.current_res.artists[idx].extension_icon }
                item_clicked(idx) => {
                    ArtistsPageProps.selected_artist = res_container.current_res.artists[idx];
                    AppProps.active_page = Pages.ArtistContent;
                }
                get_context_menu_items(idx) => {
                    ContextMenuCallbacks.get_artist_menu_items([res_container.current_res.artists[idx]])
                }
                context_menu_action(idx, action_id) => {
                    ContextMenuCallbacks.artist_action([res_container.current_res.artists[idx]], action_id)
                }
                opacity: (!res_container.current_res.loading && root.active_tab == 2) ? 1.0 : 0.0;
                visible: !res_container.current_res.loading && self.opacity > 0.01;
                animate opacity {
                    duration: Theme.durationNormal;
                    easing: ease-in-out;
                }
            }

            GridListView {
                item_width: Theme.cardWidth;
                total_items: res_container.current_res.playlists.length;
                enable_context_menu: true;
                item_title(idx) => { res_container.current_res.playlists[idx].title }
                item_cover(idx) => { res_container.current_res.playlists[idx].coverPath }
                item_extension(idx) => { res_container.current_res.playlists[idx].extension }
                item_extension_icon(idx) => { res_container.current_res.playlists[idx].extension_icon }
                item_clicked(idx) => {
                    PlaylistsPageProps.selected_playlist = res_container.current_res.playlists[idx];
                    AppProps.active_page = Pages.PlaylistContent;
                }
                get_context_menu_items(idx) => {
                    ContextMenuCallbacks.get_playlist_menu_items([res_container.current_res.playlists[idx]])
                }
                context_menu_action(idx, action_id) => {
                    ContextMenuCallbacks.playlist_action([res_container.current_res.playlists[idx]], action_id)
                }
                opacity: (!res_container.current_res.loading && root.active_tab == 3) ? 1.0 : 0.0;
                visible: !res_container.current_res.loading && self.opacity > 0.01;
                animate opacity {
                    duration: Theme.durationNormal;
                    easing: ease-in-out;
                }
            }

            GridListView {
                item_width: Theme.cardWidth;
                total_items: res_container.current_res.genres.length;
                enable_context_menu: true;
                item_title(idx) => { res_container.current_res.genres[idx].title }
                item_cover(idx) => { res_container.current_res.genres[idx].coverPath }
                get_context_menu_items(idx) => {
                    ContextMenuCallbacks.get_genre_menu_items([res_container.current_res.genres[idx]])
                }
                context_menu_action(idx, action_id) => {
                    ContextMenuCallbacks.genre_action([res_container.current_res.genres[idx]], action_id)
                }
                opacity: (!res_container.current_res.loading && root.active_tab == 4) ? 1.0 : 0.0;
                visible: !res_container.current_res.loading && self.opacity > 0.01;
                animate opacity {
                    duration: Theme.durationNormal;
                    easing: ease-in-out;
                }
            }

            for account in AccountsProps.accounts: Rectangle {
                visible: !res_container.current_res.loading && SearchPageProps.search_query != "" && res_container.has_no_results && !account.logged_in && account.package_name == res_container.current_res.extension;

                if (self.visible): StatusTooltip {
                    text: @tr("Not logged in");
                }
            }

            if (SearchPageProps.provider_results.length > 0 && !res_container.current_res.loading && SearchPageProps.search_query != "" && res_container.has_no_results && !res_container.current_res.has_account): StatusTooltip {
                text: @tr("No results found");
            }
        }
    }
}
