import { Theme, Constants } from "../constants.slint";
import {
    SongModel,
    AlbumModel,
    ArtistModel,
    PlaylistModel,
    GenreModel,
    SearchResult,
} from "../types/song_view.slint";
import { SongListView } from "../common/song_list_view.slint";
import { GridListView } from "../common/grid_list_view.slint";
import { AppCallbacks } from "../callbacks.slint";
import { Button } from "../common/button.slint";
import { Utils, DefaultIconType } from "../utils.slint";

export struct Provider {
    name: string,
    icon: image,
    is_local: bool,
}

export component ProviderItem inherits Button {
    in property <Provider> provider;
    in property <bool> active: false;

    has_custom_layout: true;
    background: root.has_hover ? Theme.secondary.brighter(0.1) : transparent;
    border-radius: Theme.borderRadiusMd;

    VerticalLayout {
        spacing: Theme.spacingXs;
        alignment: center;
        height: Theme.iconSizeMd + Theme.paddingMd;

        HorizontalLayout {
            spacing: Theme.spacingSm;
            alignment: center;
            padding: Theme.paddingSm;

            Image {
                source: Utils.load_image_or_default(root.provider.icon, root.provider.is_local ? DefaultIconType.Folder : DefaultIconType.Extension);
                width: Theme.iconSizeMd;
                height: Theme.iconSizeMd;
                colorize: root.active ? Theme.accent : Theme.textPrimary;
            }

            Text {
                text: root.provider.name;
                color: root.active ? Theme.accent : Theme.textPrimary;
                font-size: Theme.subtitle;
                vertical-alignment: center;
            }
        }
    }
}

export global SearchPageProps {
    in-out property <string> search_query: "";
    in-out property <[SearchResult]> provider_results;
    in-out property <int> active_tab: 0;
    in-out property <int> selected_provider: 0;

    changed search_query => {
        AppCallbacks.search_term_changed(self.search_query);
    }
}

export component SearchPage inherits Rectangle {
    in-out property <int> active_tab <=> SearchPageProps.active_tab;
    in-out property <int> selected_provider <=> SearchPageProps.selected_provider;

    background: transparent;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: Theme.spacingXxl;
        padding: Theme.paddingMd;

        // Title
        Text {
            height: Theme.pageHeader + Theme.paddingLg;
            text: @tr("Search");
            font-size: Theme.pageHeader;
            color: Theme.textPrimary;
            font-weight: 700;
        }

        // Provider Wrapping Grid Rows using FlexboxLayout
        FlexboxLayout {
            for prov[idx] in SearchPageProps.provider_results: ProviderItem {
                provider: {
                    name: prov.extension == "" ? @tr("Local") : prov.extension,
                    icon: prov.extension_icon,
                    is_local: prov.extension == ""
                };
                active: root.selected_provider == idx;
                clicked => { SearchPageProps.selected_provider = idx; }
            }
        }

        FlexboxLayout {
            spacing: Theme.spacingLg;
            alignment: start;

            for tab_item[tab_idx] in [
                { name: @tr("Songs"), label: @tr("Search Songs") },
                { name: @tr("Albums"), label: @tr("Search Albums") },
                { name: @tr("Artists"), label: @tr("Search Artists") },
                { name: @tr("Playlists"), label: @tr("Search Playlists") },
                { name: @tr("Genres"), label: @tr("Search Genres") }
            ]: Rectangle {
                accessible-role: tab;
                accessible-label: tab_item.label;
                background: root.active_tab == tab_idx ? Theme.accent : transparent;
                border-radius: Theme.borderRadiusLg * 2;
                border-width: root.active_tab == tab_idx ? 0px : 1px;
                border-color: root.active_tab == tab_idx ? transparent : Theme.textSecondary.with-alpha(0.3);
                height: 36px;

                animate background { duration: 150ms; }

                HorizontalLayout {
                    padding-left: Theme.paddingLg;
                    padding-right: Theme.paddingLg;
                    alignment: center;

                    Text {
                        accessible-role: none;
                        text: tab_item.name;
                        color: root.active_tab == tab_idx ? Theme.textInverse : Theme.textPrimary;
                        font-size: Theme.subtitle;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                TouchArea {
                    clicked => { SearchPageProps.active_tab = tab_idx; }
                }
            }
        }

        res_container := Rectangle {
            vertical-stretch: 1;
            property <SearchResult> current_res: SearchPageProps.provider_results[root.selected_provider];

            SongListView {
                songs: res_container.current_res.songs;
                opacity: root.active_tab == 0 ? 1.0 : 0.0;
                visible: self.opacity > 0.01;
                animate opacity {
                    duration: 200ms;
                    easing: ease-in-out;
                }
            }

            GridListView {
                item_width: Theme.cardWidth;
                total_items: res_container.current_res.albums.length;
                item_title(idx) => { res_container.current_res.albums[idx].title }
                item_cover(idx) => { res_container.current_res.albums[idx].coverPath }
                item_extension(idx) => { res_container.current_res.albums[idx].extension }
                item_extension_icon(idx) => { res_container.current_res.albums[idx].extension_icon }
                opacity: root.active_tab == 1 ? 1.0 : 0.0;
                visible: self.opacity > 0.01;
                animate opacity {
                    duration: 200ms;
                    easing: ease-in-out;
                }
            }

            GridListView {
                item_width: Theme.cardWidth;
                total_items: res_container.current_res.artists.length;
                item_title(idx) => { res_container.current_res.artists[idx].title }
                item_cover(idx) => { res_container.current_res.artists[idx].coverPath }
                item_extension(idx) => { res_container.current_res.artists[idx].extension }
                item_extension_icon(idx) => { res_container.current_res.artists[idx].extension_icon }
                opacity: root.active_tab == 2 ? 1.0 : 0.0;
                visible: self.opacity > 0.01;
                animate opacity {
                    duration: 200ms;
                    easing: ease-in-out;
                }
            }

            GridListView {
                item_width: Theme.cardWidth;
                total_items: res_container.current_res.playlists.length;
                item_title(idx) => { res_container.current_res.playlists[idx].title }
                item_cover(idx) => { res_container.current_res.playlists[idx].coverPath }
                item_extension(idx) => { res_container.current_res.playlists[idx].extension }
                item_extension_icon(idx) => { res_container.current_res.playlists[idx].extension_icon }
                opacity: root.active_tab == 3 ? 1.0 : 0.0;
                visible: self.opacity > 0.01;
                animate opacity {
                    duration: 200ms;
                    easing: ease-in-out;
                }
            }

            GridListView {
                item_width: Theme.cardWidth;
                total_items: res_container.current_res.genres.length;
                item_title(idx) => { res_container.current_res.genres[idx].title }
                item_cover(idx) => { res_container.current_res.genres[idx].coverPath }
                opacity: root.active_tab == 4 ? 1.0 : 0.0;
                visible: self.opacity > 0.01;
                animate opacity {
                    duration: 200ms;
                    easing: ease-in-out;
                }
            }
        }
    }
}
