import { Theme } from "../constants.slint";
import { AppCallbacks } from "../callbacks.slint";
import { PreferenceItem } from "preferences.slint";
import { GroupActionButton } from "button_group.slint";

export component ActionGroup inherits Rectangle {
    in property <PreferenceItem> preference;
    in property <bool> is_destructive: false;
    callback action_clicked(string);

    background: Theme.secondary;
    border-radius: Theme.borderRadiusMd;
    height: main_layout.preferred-height;

    main_layout := HorizontalLayout {
        padding: Theme.paddingMd;
        spacing: Theme.spacingMd;
        alignment: space-between;

        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: Theme.spacingXs;
            alignment: center;

            HorizontalLayout {
                min-width: 0px;
                spacing: Theme.spacingSm;
                alignment: start;

                Text {
                    text: root.preference.title;
                    font-size: Theme.body;
                    font-weight: 600;
                    wrap: word-wrap;
                    color: Theme.textPrimary;
                    vertical-alignment: center;
                }

                if root.preference.value_string != "": Text {
                    text: root.preference.value_string;
                    font-size: Theme.body;
                    font-weight: 700;
                    wrap: word-wrap;
                    color: Theme.accent;
                    vertical-alignment: center;
                }
            }

            if root.preference.subtitle != "": Text {
                text: root.preference.subtitle;
                font-size: Theme.caption;
                color: Theme.textSecondary;
                wrap: word-wrap;
            }

            if root.preference.placeholder != "": Text {
                text: root.preference.placeholder;
                font-size: Theme.extraSmall;
                wrap: word-wrap;
                color: Theme.textSecondary;
            }
        }

        HorizontalLayout {
            spacing: Theme.spacingSm;
            alignment: end;

            for option in root.preference.options: VerticalLayout {
                alignment: center;

                GroupActionButton {
                    width: max(Theme.buttonMinWidth, self.preferred-width + Theme.spacingXl);
                    text: option.label;
                    is_destructive: root.is_destructive;
                    clicked => {
                        if (root.preference.id != "") {
                            AppCallbacks.preference_changed({
                                id: root.preference.id,
                                value_string: option.id,
                                value_bool: false,
                                value_number: 0.0,
                                value_list: []
                            });
                        }
                        root.action_clicked(option.id);
                    }
                }
            }
        }
    }
}
