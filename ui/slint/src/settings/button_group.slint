import { Theme } from "../constants.slint";
import { Button } from "../common/button.slint";

export struct ButtonItem {
    id: string,
    text: string,
    is_destructive: bool,
    is_neutral: bool,
}

export component GroupActionButton inherits Button {
    in property <bool> is_destructive: false;
    in property <bool> is_neutral: false;

    has_custom_layout: true;
    height: Theme.textInputHeight;
    border-radius: Theme.borderRadiusXl;
    border-width: Theme.borderWidth;
    border-color: is_destructive ? (root.has_hover ? Theme.danger : Theme.textSecondary) : is_neutral ? Theme.secondary : Theme.accent;
    background: is_destructive ? (root.pressed ? Theme.danger : transparent) : is_neutral ? Theme.secondary : Theme.accent;
    opacity: root.pressed ? 0.7 : (root.has_hover ? 0.85 : 1.0);

    animate border-color { duration: 150ms; }
    animate background { duration: 150ms; }
    animate opacity { duration: 100ms; }

    Text {
        accessible-role: none;
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: is_destructive ? (root.pressed ? Theme.textInverse : (root.has_hover ? Theme.danger : Theme.textPrimary)) : root.is_neutral ? Theme.textPrimary : Theme.textInverse;
        animate color { duration: 150ms; }
    }
}

export component ModalActionButton inherits Button {
    in property <bool> is_confirm: false;
    in property <bool> is_neutral: false;

    has_custom_layout: true;
    width: Theme.modalActionButtonWidth;
    height: Theme.modalActionButtonHeight;
    border-radius: Theme.borderRadiusLg;
    border-width: is_confirm ? 0px : Theme.borderWidth;
    border-color: root.has_hover ? Theme.accent : Theme.textSecondary;
    background: is_confirm ? (root.has_hover ? Theme.danger.darker(0.15) : Theme.danger) : (is_neutral ? Theme.secondary : transparent);

    Text {
        accessible-role: none;
        text: root.text;
        color: is_confirm ? Theme.textInverse : Theme.textPrimary;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

export component ButtonGroup inherits VerticalLayout {
    in property <[ButtonItem]> buttons;

    callback clicked(string);

    property <string> pending_action_id;
    property <string> pending_action_text;

    spacing: Theme.spacingMd;
    alignment: start;

    HorizontalLayout {
        spacing: Theme.spacingMd;
        alignment: start;

        for btn in buttons: GroupActionButton {
            width: max(Theme.buttonMinWidth, self.preferred-width + Theme.spacingXxl);
            text: btn.text;
            is_destructive: btn.is_destructive;
            is_neutral: btn.is_neutral;

            clicked => {
                if (btn.is_destructive) {
                    root.pending_action_id = btn.id;
                    root.pending_action_text = btn.text;
                    modal_popup.show();
                } else {
                    root.clicked(btn.id);
                }
            }
        }
    }

    modal_popup := PopupWindow {
        x: -2000px + root.width / 2;
        y: -2000px + root.height / 2;
        width: 4000px;
        height: 4000px;

        Rectangle {
            background: Theme.modalBackdrop;

            TouchArea {
                clicked => {
                    modal_popup.close();
                }
            }

            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: Theme.confirmModalWidth;
                        height: Theme.confirmModalHeight;
                        border-radius: Theme.borderRadiusXl;
                        background: Theme.secondary;
                        border-width: Theme.borderWidth;
                        border-color: Theme.textSecondary;

                        TouchArea { }

                        VerticalLayout {
                            padding: Theme.paddingLg;
                            spacing: Theme.spacingMd;
                            alignment: space-between;

                            VerticalLayout {
                                spacing: Theme.spacingSm;
                                Text {
                                    text: @tr("Confirm Action");
                                    font-size: Theme.modelTitle;
                                }

                                Text {
                                    text: @tr("Are you sure you want to {}? This cannot be undone.", root.pending_action_text);
                                    font-size: Theme.caption;
                                    wrap: word-wrap;
                                }
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: Theme.spacingMd;

                                ModalActionButton {
                                    text: @tr("Cancel");
                                    is_neutral: true;
                                    clicked => {
                                        modal_popup.close();
                                    }
                                }

                                ModalActionButton {
                                    text: @tr("Confirm");
                                    is_confirm: true;
                                    clicked => {
                                        root.clicked(root.pending_action_id);
                                        modal_popup.close();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
