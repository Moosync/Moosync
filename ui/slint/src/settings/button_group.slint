import { Theme } from "../constants.slint";
import { Button } from "../common/button.slint";

export struct ButtonItem {
    id: string,
    text: string,
    is-destructive: bool,
}

export component GroupActionButton inherits Button {
    in property <bool> is_destructive: false;

    has_custom_layout: true;
    height: 35px;
    border-radius: Theme.borderRadiusXl;
    border-width: 1px;
    border-color: is_destructive ? (root.has_hover ? #ff4444 : Theme.textSecondary) : Theme.accent;
    background: is_destructive ? (root.pressed ? #ff4444 : transparent) : Theme.accent;
    opacity: root.pressed ? 0.7 : (root.has_hover ? 0.85 : 1.0);

    animate border-color { duration: 150ms; }
    animate background { duration: 150ms; }
    animate opacity { duration: 100ms; }

    Text {
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: is_destructive ? (root.pressed ? Theme.textInverse : (root.has_hover ? #ff4444 : Theme.textPrimary)) : Theme.textInverse;
        animate color { duration: 150ms; }
    }
}

export component ModalActionButton inherits Button {
    in property <bool> is_confirm: false;

    has_custom_layout: true;
    width: 80px;
    height: 30px;
    border-radius: Theme.borderRadiusLg;
    border-width: is_confirm ? 0px : 1px;
    border-color: root.has_hover ? Theme.accent : Theme.textSecondary;
    background: is_confirm ? (root.has_hover ? #cc0000 : #ff4444) : transparent;

    Text {
        text: root.text;
        color: is_confirm ? Theme.textInverse : Theme.textPrimary;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

export component ButtonGroup inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <[ButtonItem]> buttons;

    callback clicked(string);

    property <string> pending-action-id;
    property <string> pending-action-text;

    spacing: Theme.spacingMd;
    alignment: start;

    VerticalLayout {
        Text {
            text: title;
            font-size: Theme.modelTitle;
            color: Theme.textPrimary;
        }

        Text {
            text: subtitle;
            font-size: Theme.caption;
            wrap: word-wrap;
            color: Theme.textSecondary;
        }
    }

    HorizontalLayout {
        spacing: Theme.spacingMd;
        alignment: start;

        for btn in buttons: GroupActionButton {
            width: max(100px, self.preferred-width + 30px);
            text: btn.text;
            is_destructive: btn.is-destructive;

            clicked => {
                if (btn.is-destructive) {
                    root.pending-action-id = btn.id;
                    root.pending-action-text = btn.text;
                    modal_popup.show();
                } else {
                    root.clicked(btn.id);
                }
            }
        }
    }

    modal_popup := PopupWindow {
        x: -2000px + root.width / 2;
        y: -2000px + root.height / 2;
        width: 4000px;
        height: 4000px;

        Rectangle {
            background: rgba(0, 0, 0, 0.5);

            TouchArea {
                clicked => {
                    modal_popup.close();
                }
            }

            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 320px;
                        height: 150px;
                        border-radius: Theme.borderRadiusXl;
                        background: Theme.secondary;
                        border-width: 1px;
                        border-color: Theme.textSecondary;

                        TouchArea { }

                        VerticalLayout {
                            padding: Theme.paddingLg;
                            spacing: Theme.spacingMd;
                            alignment: space-between;

                            VerticalLayout {
                                spacing: Theme.spacingSm;
                                Text {
                                    text: "Confirm Action";
                                    font-size: Theme.modelTitle;
                                }

                                Text {
                                    text: "Are you sure you want to " + root.pending-action-text + "? This cannot be undone.";
                                    font-size: Theme.caption;
                                    wrap: word-wrap;
                                }
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: Theme.spacingMd;

                                ModalActionButton {
                                    text: "Cancel";
                                    clicked => {
                                        modal_popup.close();
                                    }
                                }

                                ModalActionButton {
                                    text: "Confirm";
                                    is_confirm: true;
                                    clicked => {
                                        root.clicked(root.pending-action-id);
                                        modal_popup.close();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
