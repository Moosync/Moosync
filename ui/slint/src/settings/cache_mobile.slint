import { Theme } from "../constants_mobile.slint";
import { SettingsPageLayoutMobile } from "settings_page_layout_mobile.slint";
import { CacheState } from "cache_props.slint";
import { GroupActionButtonMobile } from "button_group_mobile.slint";
import { ActionGroupMobile } from "action_group_mobile.slint";
import { PreferenceType } from "preferences.slint";

export component CachePageMobile inherits SettingsPageLayoutMobile {
    title: @tr("Cache");

    Rectangle {
        background: Theme.secondary;
        border-radius: Theme.borderRadiusMd;

        VerticalLayout {
            padding: Theme.paddingMd;
            spacing: Theme.spacingSm;

            Text {
                text: @tr("Total Tracked & Orphan Cache");
                font-size: Theme.caption;
                color: Theme.textSecondary;
            }

            Text {
                text: CacheState.is_loading ? @tr("Scanning...") : CacheState.total_size_text;
                font-size: Theme.modelTitle;
                font-weight: 700;
                color: Theme.textPrimary;
            }

            HorizontalLayout {
                spacing: Theme.spacingSm;
                alignment: start;

                GroupActionButtonMobile {
                    width: max(Theme.buttonMinWidth, self.preferred-width + Theme.spacingLg);
                    text: @tr("Refresh");
                    is_neutral: true;
                    clicked => {
                        CacheState.refresh_cache();
                    }
                }

                if CacheState.orphan_caches.length > 0: GroupActionButtonMobile {
                    width: max(Theme.buttonMinWidth, self.preferred-width + Theme.spacingLg);
                    text: @tr("Clear Orphans");
                    is_destructive: true;
                    clicked => {
                        CacheState.clear_all_orphans();
                    }
                }

                GroupActionButtonMobile {
                    width: max(Theme.buttonMinWidth, self.preferred-width + Theme.spacingLg);
                    text: @tr("Clear All");
                    is_destructive: true;
                    clicked => {
                        CacheState.clear_all_cache();
                    }
                }
            }
        }
    }

    Text {
        text: @tr("Application Cache");
        font-size: Theme.modelTitle;
        font-weight: 700;
        color: Theme.textPrimary;
    }

    for entry in CacheState.category_caches: ActionGroupMobile {
        is_destructive: true;
        preference: {
            id: "",
            pref_type: PreferenceType.ActionGroup,
            title: CacheState.category_title(entry.category),
            subtitle: CacheState.category_description(entry.category),
            placeholder: @tr("{} files", entry.entry_count),
            value_string: entry.size_text,
            options: [{ id: "clear", label: @tr("Clear") }],
        };
        action_clicked => {
            CacheState.clear_cache_category(entry.category);
        }
    }

    Text {
        text: @tr("Extension Caches");
        font-size: Theme.modelTitle;
        font-weight: 700;
        color: Theme.textPrimary;
    }

    if CacheState.extension_caches.length == 0: Text {
        text: @tr("No installed extensions");
        font-size: Theme.body;
        color: Theme.textSecondary;
    }

    for entry in CacheState.extension_caches: ActionGroupMobile {
        is_destructive: true;
        preference: {
            id: "",
            pref_type: PreferenceType.ActionGroup,
            title: entry.display_name,
            subtitle: @tr("Package: {}", entry.package_name),
            placeholder: @tr("Disk: {} | DB: {} ({} entries)", entry.disk_size_text, entry.db_size_text, entry.db_entries),
            value_string: entry.size_text,
            options: [{ id: "clear", label: @tr("Clear") }],
        };
        action_clicked => {
            CacheState.clear_extension_cache(entry.package_name);
        }
    }

    Text {
        text: @tr("Orphan Cache Entries");
        font-size: Theme.modelTitle;
        font-weight: 700;
        color: Theme.textPrimary;
    }

    if CacheState.orphan_caches.length == 0: Text {
        text: @tr("No orphan cache entries found");
        font-size: Theme.body;
        color: Theme.textSecondary;
    }

    for entry in CacheState.orphan_caches: ActionGroupMobile {
        is_destructive: true;
        preference: {
            id: "",
            pref_type: PreferenceType.ActionGroup,
            title: CacheState.orphan_title(entry.kind, entry.package_name),
            subtitle: CacheState.orphan_description(entry.kind, entry.package_name),
            placeholder: @tr("{} entries", entry.entry_count),
            value_string: entry.size_text,
            options: [{ id: "clear", label: @tr("Clear") }],
        };
        action_clicked => {
            CacheState.clear_orphan_cache(entry.kind, entry.package_name);
        }
    }
}
