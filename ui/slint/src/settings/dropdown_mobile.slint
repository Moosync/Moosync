import { Theme } from "../constants_mobile.slint";
import { PreferenceItem, PreferenceOption } from "preferences.slint";
import { AppCallbacks, UtilCallbacks } from "../callbacks.slint";
import { ContextMenuMobile } from "../common/context_menu_mobile.slint";

export component DropdownGroupMobile inherits Rectangle {
    in property <PreferenceItem> preference;
    in property <string> title: root.preference.title;
    in property <string> subtitle: root.preference.subtitle;
    in property <[PreferenceOption]> options: root.preference.options;
    in-out property <string> selected_id: root.preference.value_string != "" ? root.preference.value_string : (root.options.length > 0 ? root.options[0].id : "");
    callback changed(string);

    height: content_layout.preferred-height;

    content_layout := VerticalLayout {
        spacing: Theme.spacingSm;
        alignment: start;

        VerticalLayout {
            spacing: Theme.borderWidthLg;

            Text {
                text: root.title;
                font-size: Theme.modelTitle;
                font-weight: 600;
                wrap: word-wrap;
                color: Theme.textPrimary;
            }

            if (root.subtitle != ""): Text {
                text: root.subtitle;
                font-size: Theme.caption;
                wrap: word-wrap;
                color: Theme.textSecondary;
            }
        }

        trigger := TouchArea {
            height: Theme.size4Xl;
            accessible-role: combobox;
            accessible-label: root.title;
            clicked => {
                context_menu.show();
            }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: Theme.borderRadiusMd;
                background: Theme.tertiary;

                HorizontalLayout {
                    padding-left: Theme.paddingMd;
                    padding-right: Theme.paddingMd;

                    for option in root.options: HorizontalLayout {
                        visible: option.id == root.selected_id;
                        horizontal-stretch: option.id == root.selected_id ? 1 : 0;
                        if option.id == root.selected_id: Text {
                            accessible-role: none;
                            text: option.label != "" ? option.label : option.id;
                            vertical-alignment: center;
                            color: Theme.textPrimary;
                            font-size: Theme.body;
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        Text {
                            accessible-role: none;
                            text: "▼";
                            font-size: Theme.sizeSm;
                            color: Theme.textSecondary;
                        }
                    }
                }
            }
        }
    }

    context_menu := ContextMenuMobile {
        items: UtilCallbacks.options_to_context_items(root.options);
        selected_id: root.selected_id;
        selected(action_id) => {
            root.selected_id = action_id;
            if (root.preference.id != "") {
                AppCallbacks.preference_changed({
                    id: root.preference.id,
                    value_string: root.selected_id,
                    value_bool: false,
                    value_number: 0.0,
                    value_list: []
                });
            }
            root.changed(root.selected_id);
        }
    }
}
