import { Theme } from "../constants.slint";
import { ListView } from "std-widgets.slint";
import { AppCallbacks } from "../callbacks.slint";
import { PreferenceGroup } from "preference_group.slint";
import { ExtensionItem } from "../types/extension_view.slint";
import { Button } from "../common/button.slint";
import { AppPreferences } from "preferences.slint";
import { PreferenceList } from "preference_list.slint";

component Spinner inherits Rectangle {
    in property <bool> active: true;
    width: Theme.iconSizeMd;
    height: Theme.iconSizeMd;

    Image {
        width: 100%;
        height: 100%;
        source: @image-url("../icons/spinner.svg");
        colorize: Theme.accent;
        transform-rotation: root.active ? (animation-tick() * 360deg / 1s) : 0deg;
    }
}

component ExtensionsManifest inherits VerticalLayout {
    in property <[ExtensionItem]> extensions;

    ListView {
        height: Theme.extensionsListHeight;
        for item in root.extensions: VerticalLayout {
            padding-bottom: Theme.spacingLg;
            padding-right: Theme.paddingLg;

            Rectangle {
                border-radius: Theme.borderRadiusLg;
                border-width: Theme.borderWidth;
                border-color: Theme.textSecondary;

                HorizontalLayout {
                    padding-top: Theme.extensionItemPaddingY;
                    padding-bottom: Theme.extensionItemPaddingY;
                    padding-left: Theme.extensionItemPaddingX;
                    padding-right: Theme.extensionItemPaddingX;
                    spacing: Theme.spacingLg;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: Theme.extensionIconSize;
                            height: Theme.extensionIconSize;
                            border-radius: Theme.borderRadiusMd;
                            clip: true;

                            Image {
                                width: 100%;
                                height: 100%;
                                source: item.icon.width > 0 ? item.icon : @image-url("../icons/extensions.svg");
                                image-fit: contain;
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: Theme.spacingTiny;

                        HorizontalLayout {
                            spacing: Theme.spacingMd;
                            Text {
                                text: item.name;
                                font-size: Theme.body;
                                font-weight: 700;
                                color: Theme.textPrimary;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: "v" + item.version;
                                font-size: Theme.caption;
                                color: Theme.textSecondary;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }

                            if item.registry != "": Rectangle {
                                border-radius: Theme.borderRadiusSm;
                                background: Theme.accent.transparentize(0.85);
                                horizontal-stretch: 0;
                                HorizontalLayout {
                                    padding-left: Theme.paddingXs;
                                    padding-right: Theme.paddingXs;
                                    padding-top: Theme.spacingTiny;
                                    padding-bottom: Theme.spacingTiny;
                                    Text {
                                        text: item.registry;
                                        font-size: Theme.caption;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        if item.description != "": Text {
                            text: item.description;
                            font-size: Theme.caption;
                            color: Theme.textSecondary;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: Theme.spacingMd;

                            if item.loading: Spinner {
                                active: true;
                            }

                            toggle_touch := TouchArea {
                                width: Theme.toggleWidth;
                                height: Theme.toggleHeight;
                                enabled: !item.loading;

                                clicked => {
                                    AppCallbacks.toggle_extension(item.package_name);
                                }

                                Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    border-radius: self.height / 2;
                                    background: item.active ? (toggle_touch.has-hover ? Theme.accent.brighter(0.1) : Theme.accent) : (toggle_touch.has-hover ? Theme.textSecondary.brighter(0.1) : Theme.textSecondary);

                                    animate background { duration: 150ms; }

                                    thumb := Rectangle {
                                        width: Theme.toggleThumbSize;
                                        height: Theme.toggleThumbSize;
                                        border-radius: self.width / 2;
                                        background: Theme.textPrimary;
                                        y: (parent.height - self.height) / 2;

                                        x: item.active ? (Theme.toggleWidth - self.width - Theme.spacingTiny) : Theme.spacingTiny;

                                        animate x {
                                            duration: 150ms;
                                            easing: cubic-bezier(0.25, 0.8, 0.25, 1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component ExtensionsPage inherits VerticalLayout {
    in-out property <[ExtensionItem]> extensions;

    height: 100%;
    padding-top: Theme.extensionItemPaddingX;
    padding-bottom: Theme.extensionItemPaddingX;
    padding-right: Theme.extensionItemPaddingX;
    spacing: Theme.spacingMd;

    alignment: start;
    HorizontalLayout {
        padding-bottom: Theme.paddingSm;
        Text {
            text: @tr("Settings > Extensions");
            font-size: Theme.modelTitle;
            color: Theme.accent;
        }
    }

    PreferenceGroup {
        HorizontalLayout {
            spacing: Theme.spacingLg;
            VerticalLayout {
                alignment: start;
                horizontal-stretch: 1;
                Text {
                    text: @tr("Extensions");
                    font-size: Theme.modelTitle;
                    color: Theme.textPrimary;
                }

                Text {
                    text: @tr("Manage your extensions");
                    font-size: Theme.caption;
                    wrap: word-wrap;
                    color: Theme.textSecondary;
                }
            }

            Button {
                text: @tr("Add Extension");
                icon: @image-url("../icons/plus.svg");
                clicked => {
                    let chosen = AppCallbacks.open_file_picker("msxt");
                    if (chosen != "") {
                        AppCallbacks.install_extension(chosen);
                    }
                }
            }
        }

        if (root.extensions.length == 0): Text {
            text: @tr("No extensions available.");
            font-size: Theme.body;
            color: Theme.textSecondary;
            horizontal-alignment: left;
        }

        ExtensionsManifest {
            extensions <=> root.extensions;
        }
    }

    PreferenceList {
        items: AppPreferences.extensions_items;
    }
}
