import { Theme } from "../constants_mobile.slint";
import { AppCallbacks } from "../callbacks.slint";
import { PreferenceGroupMobile } from "preference_group_mobile.slint";
import { ExtensionItem } from "../types/extension_view.slint";
import { PillButton } from "../common/pill_button_mobile.slint";
import { PreferenceListMobile } from "preference_list_mobile.slint";
import { Spinner } from "../common/spinner.slint";
import { IconButton } from "../common/icon_button_mobile.slint";
import {
    ExtensionDetailsState,
} from "../common/extension_details_modal_props.slint";
import { SettingsPageLayoutMobile } from "settings_page_layout_mobile.slint";
import {
    ExtensionPreferenceGroup,
    ExtensionsPreferenceProps,
    ExtensionsPageProps,
} from "extensions_props.slint";

export component ExtensionItemMobile inherits Rectangle {
    in property <ExtensionItem> item;

    border-radius: Theme.borderRadiusLg;
    border-width: Theme.borderWidth;
    border-color: Theme.textSecondary.transparentize(Theme.percent60);
    background: Theme.secondary.transparentize(Theme.percent50);

    HorizontalLayout {
        padding-top: Theme.paddingMd;
        padding-bottom: Theme.paddingMd;
        padding-left: Theme.paddingMd;
        padding-right: Theme.paddingMd;
        spacing: Theme.spacingMd;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: Theme.mobileButtonSize;
                height: Theme.mobileButtonSize;
                border-radius: Theme.borderRadiusMd;
                clip: true;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.item.icon.width > 0 ? root.item.icon : @image-url("../icons/extensions.svg");
                    image-fit: contain;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Theme.spacingTiny;

            HorizontalLayout {
                spacing: Theme.spacingSm;
                Text {
                    text: root.item.name;
                    font-size: Theme.body;
                    font-weight: 700;
                    color: Theme.textPrimary;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "v" + root.item.version;
                    font-size: Theme.caption;
                    color: Theme.textSecondary;
                    vertical-alignment: center;
                }
            }

            if root.item.error != "": Text {
                text: root.item.error;
                font-size: Theme.caption;
                color: Theme.danger;
                overflow: elide;
            }

            if root.item.description != "": Text {
                text: root.item.description;
                font-size: Theme.caption;
                color: Theme.textSecondary;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: Theme.spacingSm;
                alignment: center;

                IconButton {
                    icon_source: @image-url("../icons/info.svg");
                    icon_size: Theme.mobileSearchBarIconSize;
                    width: Theme.mobileButtonSize;
                    height: Theme.mobileButtonSize;
                    clicked => {
                        ExtensionDetailsState.item = root.item;
                        ExtensionDetailsState.show_modal = true;
                    }
                }

                if root.item.loading: Spinner { }

                toggle_touch := TouchArea {
                    width: Theme.mobileQueueDragHandleHeight;
                    height: Theme.sizeXxl;
                    enabled: !root.item.loading;

                    clicked => {
                        AppCallbacks.toggle_extension(root.item.package_name);
                    }

                    Rectangle {
                        border-radius: Theme.borderRadiusXl;
                        background: root.item.is_installed ? Theme.accent : Theme.textSecondary.transparentize(Theme.percent60);
                        animate background { duration: Theme.durationFast; }

                        Rectangle {
                            width: Theme.sizeXl;
                            height: Theme.sizeXl;
                            border-radius: Theme.sizeSm;
                            background: Theme.textPrimary;
                            y: (parent.height - self.height) / 2;
                            x: root.item.is_installed ? (parent.width - self.width - Theme.sizeXxs) : Theme.sizeXxs;
                            animate x {
                                duration: Theme.durationFast;
                                easing: cubic-bezier(0.25, 0.8, 0.25, 1);
                            }
                        }
                    }
                }
            }
        }
    }
}

export component ExtensionsPageMobile inherits SettingsPageLayoutMobile {
    title: @tr("Extensions");

    PreferenceGroupMobile {
        VerticalLayout {
            spacing: Theme.spacingMd;

            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: @tr("Manage your extensions");
                        font-size: Theme.caption;
                        color: Theme.textSecondary;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: Theme.spacingSm;
                    alignment: end;

                    if ExtensionsPageProps.has_updates: PillButton {
                        text: @tr("Update all");
                        height: Theme.sizeXxl;
                        font_size: Theme.caption;
                        padding_h: Theme.paddingSm;
                        clicked => {
                            ExtensionsPageProps.has_updates = false;
                            AppCallbacks.update_all_extensions();
                        }
                    }

                    PillButton {
                        text: @tr("Add Extension");
                        icon: @image-url("../icons/plus.svg");
                        height: Theme.sizeXxl;
                        font_size: Theme.caption;
                        padding_h: Theme.paddingSm;
                        clicked => {
                            let chosen = AppCallbacks.open_file_picker("msxt");
                            if (chosen != "") {
                                AppCallbacks.install_extension(chosen);
                            }
                        }
                    }
                }
            }

            if (ExtensionsPageProps.extensions.length == 0): Text {
                text: @tr("No extensions available.");
                font-size: Theme.body;
                color: Theme.textSecondary;
            }

            VerticalLayout {
                spacing: Theme.spacingSm;
                for ext in ExtensionsPageProps.extensions: ExtensionItemMobile {
                    item: ext;
                }
            }
        }
    }

    if (ExtensionsPreferenceProps.static_preferences.length > 0): PreferenceListMobile {
        items: ExtensionsPreferenceProps.static_preferences;
    }

    for group in ExtensionsPreferenceProps.extension_preferences: VerticalLayout {
        spacing: Theme.spacingMd;

        Text {
            text: group.display_name;
            font-size: Theme.modelTitle;
            font-weight: 700;
            color: Theme.textPrimary;
        }

        PreferenceListMobile {
            items: group.preferences;
        }
    }
}
