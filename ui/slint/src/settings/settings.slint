import { Modal, ModalSize } from "../common/modal.slint";
import { SettingsSidebar, SettingsSidebarItem } from "../sidebar/sidebar.slint";
import {
    Pages,
    SettingsPages,
    Theme,
    ThemeConfig,
    ThemeConstant,
} from "../constants.slint";
import { SettingsPageWrapper } from "../common/page_wrapper.slint";
import { PathSelector } from "path_selector.slint";
import { PathsPage } from "paths.slint";
import { SystemPage } from "system.slint";
import { ExtensionsPage } from "extensions.slint";
import { ExtensionItem } from "../types/extension_view.slint";
import { ThemesPage } from "themes.slint";
import { TextInputGroup } from "text_input.slint";
import { ButtonGroup, ButtonItem } from "button_group.slint";
import { AppCallbacks } from "../callbacks.slint";

export component Settings inherits Modal {
    modalSize: ModalSize.Xl;
    property <SettingsPages> activePage: SettingsPages.Extensions;
    changed activePage => {
        AppCallbacks.settings-active-page-changed(self.activePage);
    }

    in-out property <[ThemeConfig]> available-themes;
    in-out property <string> active-theme-id;
    in-out property <[ThemeConstant]> theme-constants;
    in-out property <[ExtensionItem]> extensions;

    // Save Theme Modal State
    in-out property <bool> show-save-theme-modal: false;
    property <string> new-theme-name: "";
    property <string> new-theme-desc: "";
    property <string> new-theme-author: "";

    property <[SettingsSidebarItem]> items: [
        {
            text: @tr("Paths"),
            icon: @image-url("../icons/paths.svg"),
            page: SettingsPages.Paths
        },
        {
            text: @tr("System"),
            icon: @image-url("../icons/system.svg"),
            page: SettingsPages.System
        },
        {
            text: @tr("Extensions"),
            icon: @image-url("../icons/extensions.svg"),
            page: SettingsPages.Extensions
        },
        {
            text: @tr("Themes"),
            icon: @image-url("../icons/themes.svg"),
            page: SettingsPages.Themes
        },
    ];

    HorizontalLayout {
        SettingsSidebar {
            sidebarWidth: Theme.settingsSidebarWidth;
            items: items;
            activePage <=> root.activePage;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Theme.primary;

            SettingsPageWrapper {
                active-page <=> root.activePage;
                page-type: SettingsPages.Paths;

                PathsPage { }
            }

            SettingsPageWrapper {
                active-page <=> root.activePage;
                page-type: SettingsPages.System;

                SystemPage { }
            }

            SettingsPageWrapper {
                active-page <=> root.activePage;
                page-type: SettingsPages.Extensions;

                ExtensionsPage {
                    extensions <=> root.extensions;
                }
            }

            SettingsPageWrapper {
                active-page <=> root.activePage;
                page-type: SettingsPages.Themes;

                ThemesPage {
                    available-themes <=> root.available-themes;
                    active-theme-id <=> root.active-theme-id;
                    theme-constants <=> root.theme-constants;
                    show-save-modal <=> root.show-save-theme-modal;
                }
            }

            // Close button at top right
            close_btn := TouchArea {
                x: parent.width - self.width - 15px;
                y: 15px;
                width: 24px;
                height: 24px;
                clicked => {
                    root.close();
                }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 12px;
                    background: close_btn.has-hover ? Theme.secondary : transparent;
                    Image {
                        source: @image-url("../icons/cross.svg");
                        colorize: Theme.textPrimary;
                        width: 10px;
                        height: 10px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
    }

    if root.show-save-theme-modal: Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.6);

        TouchArea {
            clicked => {
                root.show-save-theme-modal = false;
            }
        }

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: Theme.themeSavePopupWidth;
                    border-radius: Theme.borderRadiusXl;
                    background: Theme.secondary;
                    border-width: 1px;
                    border-color: Theme.textSecondary;

                    TouchArea {
                        width: 100%;
                        height: 100%;
                    }

                    VerticalLayout {
                        padding: Theme.paddingLg;
                        spacing: Theme.spacingMd;

                        VerticalLayout {
                            spacing: Theme.spacingXs;
                            Text {
                                text: @tr("Save Custom Theme");
                                font-size: Theme.modelTitle;
                                color: Theme.textPrimary;
                            }

                            Text {
                                text: @tr("Your current accent and advanced styling variables will be saved.");
                                font-size: Theme.caption;
                                color: Theme.textSecondary;
                                wrap: word-wrap;
                            }
                        }

                        TextInputGroup {
                            title: @tr("Theme Name");
                            subtitle: @tr("A short, distinct name");
                            placeholder: @tr("e.g., Midnight Blue");
                            value <=> root.new-theme-name;
                            inputType: InputType.text;
                        }

                        TextInputGroup {
                            title: @tr("Author");
                            subtitle: @tr("Who created this theme?");
                            placeholder: @tr("Your name");
                            value <=> root.new-theme-author;
                            inputType: InputType.text;
                        }

                        TextInputGroup {
                            title: @tr("Description");
                            subtitle: @tr("A brief summary of the aesthetics");
                            placeholder: @tr("High contrast dark theme...");
                            value <=> root.new-theme-desc;
                            inputType: InputType.text;
                        }

                        HorizontalLayout {
                            alignment: end;
                            ButtonGroup {
                                title: "";
                                subtitle: "";
                                buttons: [
                                    { id: "cancel", text: @tr("Cancel"), is-destructive: false },
                                    { id: "confirm", text: @tr("Save Theme"), is-destructive: false }
                                ];
                                clicked(id) => {
                                    if (id == "confirm") {
                                        AppCallbacks.save_custom_theme(root.new-theme-name, root.new-theme-author, root.new-theme-desc);
                                        root.new-theme-name = "";
                                        root.new-theme-author = "";
                                        root.new-theme-desc = "";
                                    }
                                    root.show-save-theme-modal = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
