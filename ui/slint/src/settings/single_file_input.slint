import { Theme } from "../constants.slint";
import { PreferenceItem } from "preferences.slint";
import { AppCallbacks } from "../callbacks.slint";
import { IconButton } from "../common/icon_button.slint";

export component SingleFileInput inherits VerticalLayout {
    in property <PreferenceItem> preference;
    in property <string> title: root.preference.title;
    in property <string> subtitle: root.preference.subtitle;
    in property <string> filter: "";
    in-out property <string> value: root.preference.value_string;

    callback browse_clicked();

    spacing: Theme.spacingMd;
    alignment: start;

    VerticalLayout {
        Text {
            text: root.title;
            font-size: Theme.modelTitle;
            font-weight: 600;
            wrap: word-wrap;
            color: Theme.textPrimary;
        }

        if (root.subtitle != ""): Text {
            text: root.subtitle;
            font-size: Theme.caption;
            wrap: word-wrap;
            color: Theme.textSecondary;
        }
    }

    HorizontalLayout {
        spacing: Theme.spacingMd;

        Rectangle {
            border-radius: Theme.borderRadiusXl;
            border-color: Theme.textSecondary;
            border-width: Theme.borderWidth;
            min-width: 0px;
            height: max(Theme.fileInputHeight, file_layout.preferred-height);
            horizontal-stretch: 1;

            file_layout := HorizontalLayout {
                padding-left: Theme.paddingMd;
                padding-right: Theme.paddingMd;
                padding-top: Theme.paddingXs;
                padding-bottom: Theme.paddingXs;

                Text {
                    text: root.value;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    color: Theme.textPrimary;
                    font-size: Theme.body;
                }

                IconButton {
                    icon_source: @image-url("../icons/folder.svg");
                    icon_color: Theme.textPrimary;
                    clicked => {
                        let chosen = root.filter != "" ? AppCallbacks.open_file_picker(root.filter) : AppCallbacks.open_directory_picker();
                        if (chosen != "") {
                            if (root.preference.id != "") {
                                AppCallbacks.preference_changed({
                                    id: root.preference.id,
                                    value_string: chosen,
                                    value_bool: false,
                                    value_number: 0.0,
                                    value_list: []
                                });
                            }
                            root.value = chosen;
                            root.browse_clicked();
                        }
                    }
                }
            }
        }
    }
}
