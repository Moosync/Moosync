import { Theme } from "../constants_mobile.slint";
import {
    PreferenceItem,
    StatusDotItem,
    StatusDotColor,
} from "preferences.slint";

export component StatusDotMobile inherits HorizontalLayout {
    in property <StatusDotItem> item;

    spacing: Theme.spacingXs;
    alignment: start;

    pure function dot_color(c: StatusDotColor) -> color {
        if (c == StatusDotColor.Info) {
            return Theme.statusInfo;
        }
        if (c == StatusDotColor.Warn) {
            return Theme.statusWarn;
        }
        if (c == StatusDotColor.Error) {
            return Theme.statusError;
        }
        return Theme.statusOff;
    }

    VerticalLayout {
        alignment: center;

        Rectangle {
            width: Theme.statusDotSize;
            height: Theme.statusDotSize;
            border-radius: self.width / 2;
            background: root.dot_color(root.item.color);
        }
    }

    if (root.item.title != ""): Text {
        text: root.item.title;
        font-size: Theme.body;
        font-weight: 700;
        color: Theme.textPrimary;
        wrap: word-wrap;
        vertical-alignment: center;
    }

    if (root.item.subtitle != ""): Text {
        text: root.item.subtitle;
        font-size: Theme.body;
        color: Theme.textSecondary;
        wrap: word-wrap;
        vertical-alignment: center;
    }
}

export component StatusGroupMobile inherits VerticalLayout {
    in property <PreferenceItem> preference;
    in property <string> title: root.preference.title;
    in property <string> subtitle: root.preference.subtitle;
    in property <[StatusDotItem]> dots: root.preference.status_dots;

    spacing: Theme.spacingSm;
    alignment: start;

    if (root.title != "" || root.subtitle != ""): VerticalLayout {
        spacing: Theme.spacingTiny;
        if (root.title != ""): Text {
            text: root.title;
            font-size: Theme.modelTitle;
            font-weight: 600;
            wrap: word-wrap;
            color: Theme.textPrimary;
        }

        if (root.subtitle != ""): Text {
            text: root.subtitle;
            font-size: Theme.caption;
            wrap: word-wrap;
            color: Theme.textSecondary;
        }
    }

    FlexboxLayout {
        width: 100%;
        flex-direction: row;
        flex-wrap: wrap;
        alignment: start;
        spacing-horizontal: Theme.spacingLg;
        spacing-vertical: Theme.spacingSm;

        for dot in root.dots: StatusDotMobile {
            item: dot;
        }
    }
}
