import {
    Theme,
    RgbaColor,
    ThemeConfig,
    ThemeConstant,
} from "../constants.slint";
import { PreferenceGroup } from "preference_group.slint";
import { TextInputGroup } from "text_input.slint";
import { ScrollView, Slider } from "std-widgets.slint";
import { NumberInputGroup } from "number_input.slint";
import { ButtonGroup, ButtonItem } from "button_group.slint";
import { AppCallbacks } from "../callbacks.slint";
import { SaveThemeState } from "../common/save_theme_modal_props.slint";
import { SettingsPageLayout } from "settings_page_layout.slint";
import { ThemesPageProps } from "themes_props.slint";
import { PreferenceList } from "preference_list.slint";


component FullColorPicker inherits VerticalLayout {
    in property <RgbaColor> value;
    callback changed(RgbaColor);

    spacing: Theme.spacingLg;

    // Helper functions for RGB <-> HSV conversion
    pure function rgb_to_hsv(r: float, g: float, b: float) -> { h: float, s: float, v: float } {
        let r_n = r / 255.0;
        let g_n = g / 255.0;
        let b_n = b / 255.0;

        let max_val = Math.max(r_n, Math.max(g_n, b_n));
        let min_val = Math.min(r_n, Math.min(g_n, b_n));
        let delta = max_val - min_val;

        let delta_safe = (delta > 0.0001) ? delta : 1.0;
        let g_b = (g_n - b_n) / delta_safe;
        let g_b_mod = g_b - 6.0 * Math.floor(g_b / 6.0);

        let h = (delta <= 0.0001) ? 0.0 : (max_val == r_n) ? (60.0 * g_b_mod) : (max_val == g_n) ? (60.0 * (((b_n - r_n) / delta_safe) + 2.0)) : (60.0 * (((r_n - g_n) / delta_safe) + 4.0));

        let s = (max_val > 0.0001) ? (delta / max_val) : 0.0;
        let v = max_val;

        return { h: h, s: s, v: v };
    }

    pure function hsv_to_rgb(h: float, s: float, v: float) -> RgbaColor {
        let c = v * s;
        let h_div = h / 60.0;
        let h_mod = h_div - 2.0 * Math.floor(h_div / 2.0);
        let x = c * (1.0 - Math.abs(h_mod - 1.0));
        let m = v - c;

        let r = (h < 60.0) ? c : (h < 120.0) ? x : (h < 180.0) ? 0.0 : (h < 240.0) ? 0.0 : (h < 300.0) ? x : c;

        let g = (h < 60.0) ? x : (h < 120.0) ? c : (h < 180.0) ? c : (h < 240.0) ? x : (h < 300.0) ? 0.0 : 0.0;

        let b = (h < 60.0) ? 0.0 : (h < 120.0) ? 0.0 : (h < 180.0) ? x : (h < 240.0) ? c : (h < 300.0) ? c : x;

        return { r: (r + m) * 255.0, g: (g + m) * 255.0, b: (b + m) * 255.0, a: 1.0 };
    }

    // Local HSV state
    property <float> hsv_h: root.rgb_to_hsv(root.value.r, root.value.g, root.value.b).h;
    property <float> hsv_s: root.rgb_to_hsv(root.value.r, root.value.g, root.value.b).s;
    property <float> hsv_v: root.rgb_to_hsv(root.value.r, root.value.g, root.value.b).v;
    property <float> local_alpha: root.value.a;

    property <bool> is_interacting: sv_touch.pressed || hue_touch.pressed || opacity_touch.pressed;

    changed value => {
        if (!root.is_interacting) {
            let hsv = root.rgb_to_hsv(root.value.r, root.value.g, root.value.b);
            if (hsv.s > 0.01 && hsv.v > 0.01) {
                root.hsv_h = hsv.h;
            }
            root.hsv_s = hsv.s;
            root.hsv_v = hsv.v;
            root.local_alpha = root.value.a;
        }
    }

    property <RgbaColor> hue_rgb: root.hsv_to_rgb(root.hsv_h, 1.0, 1.0);
    property <RgbaColor> local_rgb: root.hsv_to_rgb(root.hsv_h, root.hsv_s, root.hsv_v);

    HorizontalLayout {
        spacing: Theme.spacingLg;
        alignment: center;

        // 2D Saturation-Value box
        Rectangle {
            width: Theme.menuWidth;
            height: Theme.menuWidth;

            // Base active Hue color
            Rectangle {
                background: rgba(root.hue_rgb.r, root.hue_rgb.g, root.hue_rgb.b, 1.0);
                border-radius: Theme.borderRadiusLg;
            }
            // Saturation gradient (white -> transparent)
            Rectangle {
                background: @linear-gradient(Theme.angle90, #ffffff, transparent);
                border-radius: Theme.borderRadiusLg;
            }
            // Value gradient (transparent -> black)
            Rectangle {
                background: @linear-gradient(Theme.angle180, transparent, #000000);
                border-radius: Theme.borderRadiusLg;
            }

            // Interaction TouchArea
            sv_touch := TouchArea {
                clicked => {
                    root.hsv_s = Math.max(0.0, Math.min(1.0, (self.mouse-x / Theme.unitLength) / (self.width / Theme.unitLength)));
                    root.hsv_v = Math.max(0.0, Math.min(1.0, 1.0 - ((self.mouse-y / Theme.unitLength) / (self.height / Theme.unitLength))));
                    let new_rgb = root.hsv_to_rgb(root.hsv_h, root.hsv_s, root.hsv_v);
                    root.changed({ r: new_rgb.r, g: new_rgb.g, b: new_rgb.b, a: root.value.a });
                }
                moved => {
                    if (self.pressed) {
                        root.hsv_s = Math.max(0.0, Math.min(1.0, (self.mouse-x / Theme.unitLength) / (self.width / Theme.unitLength)));
                        root.hsv_v = Math.max(0.0, Math.min(1.0, 1.0 - ((self.mouse-y / Theme.unitLength) / (self.height / Theme.unitLength))));
                        let new_rgb = root.hsv_to_rgb(root.hsv_h, root.hsv_s, root.hsv_v);
                        root.changed({ r: new_rgb.r, g: new_rgb.g, b: new_rgb.b, a: root.value.a });
                    }
                }
            }

            // Handle circle selector
            Rectangle {
                x: root.hsv_s * parent.width - Theme.extraSmall;
                y: (1.0 - root.hsv_v) * parent.height - Theme.extraSmall;
                width: Theme.sizeLg;
                height: Theme.sizeLg;
                border-radius: Theme.extraSmall;
                border-width: Theme.borderWidthXxl;
                border-color: #ffffff;

                Rectangle {
                    border-radius: Theme.extraSmall;
                    border-width: Theme.borderWidth;
                    border-color: #000000.transparentize(Theme.percent50);
                }
            }
        }

        // Vertical Hue slider
        Rectangle {
            width: Theme.sizeXl;
            height: Theme.menuWidth;

            // Hue spectrum background
            Rectangle {
                border-radius: Theme.sizeSm;
                background: @linear-gradient(Theme.angle180, #ff0000 0%, #ffff00 Theme.percent17, #00ff00 Theme.percent33, #00ffff Theme.percent50, #0000ff Theme.percent67, #ff00ff Theme.percent83, #ff0000 100%);
            }

            // Interaction TouchArea
            hue_touch := TouchArea {
                clicked => {
                    root.hsv_h = Math.max(0.0, Math.min(360.0, ((self.mouse-y / Theme.unitLength) / (self.height / Theme.unitLength)) * 360.0));
                    let new_rgb = root.hsv_to_rgb(root.hsv_h, root.hsv_s, root.hsv_v);
                    root.changed({ r: new_rgb.r, g: new_rgb.g, b: new_rgb.b, a: root.value.a });
                }
                moved => {
                    if (self.pressed) {
                        root.hsv_h = Math.max(0.0, Math.min(360.0, ((self.mouse-y / Theme.unitLength) / (self.height / Theme.unitLength)) * 360.0));
                        let new_rgb = root.hsv_to_rgb(root.hsv_h, root.hsv_s, root.hsv_v);
                        root.changed({ r: new_rgb.r, g: new_rgb.g, b: new_rgb.b, a: root.value.a });
                    }
                }
            }

            // Handle circle selector
            Rectangle {
                x: parent.width / 2 - Theme.extraSmall;
                y: (root.hsv_h / 360.0) * parent.height - Theme.extraSmall;
                width: Theme.sizeLg;
                height: Theme.sizeLg;
                border-radius: Theme.extraSmall;
                border-width: Theme.borderWidthXxl;
                border-color: #ffffff;

                Rectangle {
                    border-radius: Theme.extraSmall;
                    border-width: Theme.borderWidth;
                    border-color: #000000.transparentize(Theme.percent50);
                }
            }
        }
    }

    // Alpha Slider + Live RGB display
    VerticalLayout {
        spacing: Theme.spacingSm;

        // Alpha Slider
        HorizontalLayout {
            spacing: Theme.spacingSm;
            Text {
                text: @tr("Opacity");
                color: Theme.textSecondary;
                font-size: Theme.caption;
                vertical-alignment: center;
                width: Theme.size3Xl;
            }

            opacity_touch := TouchArea {
                height: Theme.sizeLg;
                horizontal-stretch: 1;

                clicked => {
                    root.local_alpha = Math.max(0.0, Math.min(1.0, (self.mouse-x / Theme.unitLength) / (self.width / Theme.unitLength)));
                    root.changed({ r: root.value.r, g: root.value.g, b: root.value.b, a: root.local_alpha });
                }
                moved => {
                    if (self.pressed) {
                        root.local_alpha = Math.max(0.0, Math.min(1.0, (self.mouse-x / Theme.unitLength) / (self.width / Theme.unitLength)));
                        root.changed({ r: root.value.r, g: root.value.g, b: root.value.b, a: root.local_alpha });
                    }
                }

                // Custom slider track and handle
                Rectangle {
                    width: 100%;
                    height: Theme.borderRadiusMd;
                    y: (parent.height - self.height) / 2;
                    background: Theme.divider;
                    border-radius: Theme.borderWidthXxl;

                    // Filled track
                    Rectangle {
                        x: 0;
                        width: parent.width * root.local_alpha;
                        height: 100%;
                        background: Theme.accent;
                        border-radius: Theme.borderWidthXxl;
                    }

                    // Handle thumb
                    Rectangle {
                        x: root.local_alpha * parent.width - Theme.sizeXs;
                        y: (parent.height - self.height) / 2;
                        width: Theme.sizeMd;
                        height: Theme.sizeMd;
                        border-radius: Theme.borderRadiusLg;
                        background: Theme.textPrimary;
                        border-width: Theme.borderWidth;
                        border-color: Theme.textSecondary;
                    }
                }
            }

            Text {
                text: "\{round(root.local_alpha * 100)}%";
                color: Theme.textPrimary;
                vertical-alignment: center;
                width: Theme.dropdownHeight;
                horizontal-alignment: right;
                font-size: Theme.caption;
            }
        }
    }
}

export component ColorTabCard inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <RgbaColor> active-val;
    callback changed(RgbaColor);

    in-out property <bool> expanded: false;

    background: Theme.secondary;
    border-radius: Theme.borderRadiusXl;
    border-width: Theme.borderWidth;
    border-color: Theme.divider;

    VerticalLayout {
        padding: Theme.paddingLg;
        spacing: Theme.spacingMd;

        TouchArea {
            clicked => {
                root.expanded = !root.expanded;
            }

            HorizontalLayout {
                spacing: Theme.spacingMd;
                alignment: space-between;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: root.title;
                        font-size: Theme.modelTitle;
                        color: Theme.textPrimary;
                    }

                    Text {
                        text: root.desc;
                        font-size: Theme.caption;
                        color: Theme.textSecondary;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: Theme.spacingMd;
                    alignment: center;

                    Rectangle {
                        width: Theme.size6Xl;
                        height: Theme.size3Xl;
                        border-radius: Theme.sizeSm;
                        background: rgba(root.active-val.r, root.active-val.g, root.active-val.b, root.active-val.a);
                        border-width: Theme.borderWidth;
                        border-color: Theme.textSecondary.transparentize(Theme.percent50);
                    }
                }
            }
        }

        if root.expanded: VerticalLayout {
            spacing: Theme.spacingMd;
            Rectangle {
                height: Theme.borderWidth;
                background: Theme.textSecondary.transparentize(Theme.percent80);
            }

            FullColorPicker {
                value: root.active-val;
                changed(val) => {
                    root.changed(val);
                }
            }
        }
    }
}


export component ThemeCard inherits TouchArea {
    in property <ThemeConfig> config;
    in property <bool> is-active;

    width: Theme.themeCardWidth;

    Rectangle {
        border-radius: Theme.borderRadiusXl;
        background: Theme.secondary;
        border-width: root.is-active ? Theme.borderWidthLg : Theme.borderWidth;
        border-color: root.is-active ? rgba(config.accent_color.r, config.accent_color.g, config.accent_color.b, 1.0) : (root.has-hover ? Theme.textSecondary : Theme.textSecondary.transparentize(Theme.percent50));

        VerticalLayout {
            padding: Theme.paddingMd;
            spacing: Theme.spacingMd;

            Rectangle {
                height: Theme.themeCardPreviewHeight;
                border-radius: Theme.borderRadiusLg;
                background: rgba(config.tertiary.r, config.tertiary.g, config.tertiary.b, config.tertiary.a);
                border-width: Theme.borderWidth;
                border-color: Theme.textSecondary.transparentize(Theme.percent50);
                clip: true;

                VerticalLayout {
                    padding: Theme.extensionItemPaddingY;
                    alignment: space-between;
                    Rectangle {
                        width: Theme.percent30;
                        height: Theme.sizeXs;
                        border-radius: Theme.borderRadiusSm;
                        background: rgba(config.accent_color.r, config.accent_color.g, config.accent_color.b, config.accent_color.a);
                    }

                    HorizontalLayout {
                        spacing: Theme.spacingXs;
                        Rectangle {
                            width: Theme.sizeXl;
                            height: Theme.sizeXl;
                            border-radius: Theme.borderRadiusMd;
                            background: rgba(config.secondary_color.r, config.secondary_color.g, config.secondary_color.b, config.secondary_color.a);
                        }

                        VerticalLayout {
                            spacing: Theme.spacingXxs;
                            alignment: center;
                            Rectangle {
                                width: 100%;
                                height: Theme.borderRadiusMd;
                                border-radius: Theme.borderWidthXxl;
                                background: rgba(config.primary_color.r, config.primary_color.g, config.primary_color.b, config.primary_color.a);
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: config.name;
                        font-size: Theme.modelTitle;
                        color: Theme.textPrimary;
                    }

                    Text {
                        text: config.author;
                        font-size: Theme.caption;
                        color: Theme.textSecondary;
                    }
                }

                if config.registry != "": Rectangle {
                    border-radius: Theme.borderRadiusSm;
                    background: Theme.accent.transparentize(0.85);
                    horizontal-stretch: 0;
                    HorizontalLayout {
                        padding-left: Theme.paddingXs;
                        padding-right: Theme.paddingXs;
                        padding-top: Theme.spacingTiny;
                        padding-bottom: Theme.spacingTiny;
                        Text {
                            text: config.registry;
                            font-size: Theme.caption;
                            color: Theme.accent;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

export component ThemesPage inherits SettingsPageLayout {
    title: @tr("Settings > Themes");

    // Helper function to map a color object to RgbaColor reactively
    pure function color_to_rgba(c: color) -> RgbaColor {
        return { r: c.red, g: c.green, b: c.blue, a: c.alpha / 255.0 };
    }

    property <RgbaColor> active-accent: root.color_to_rgba(Theme.accent);

    property <[RgbaColor]> quick-accents: [
        { r: 129, g: 232, b: 162, a: 1.0 }, // Green
        { r: 96, g: 165, b: 250, a: 1.0 },  // Blue
        { r: 192, g: 132, b: 252, a: 1.0 }, // Purple
        { r: 251, g: 146, b: 60, a: 1.0 },  // Orange
        { r: 251, g: 113, b: 133, a: 1.0 }  // Rose
    ];

    // Accordion Sections State
    property <bool> advanced-expanded: false;

    PreferenceGroup {
        VerticalLayout {
            spacing: Theme.spacingMd;
            Text {
                text: @tr("Preset Themes");
                font-size: Theme.modelTitle;
                color: Theme.textPrimary;
            }

            Text {
                text: @tr("Selecting a theme will instantly override your advanced styling configurations.");
                font-size: Theme.caption;
                color: Theme.textSecondary;
                wrap: word-wrap;
            }

            ScrollView {
                height: Theme.themeCardPreviewHeight + Theme.size6Xl;
                HorizontalLayout {
                    spacing: Theme.spacingMd;
                    padding-bottom: Theme.paddingLg;
                    for theme in ThemesPageProps.available_themes: ThemeCard {
                        config: theme;
                        is-active: ThemesPageProps.active_theme_id == theme.id;
                        clicked => {
                            AppCallbacks.select_preset_theme(theme.id);
                        }
                    }
                }
            }
        }
    }

    PreferenceGroup {
        HorizontalLayout {
            spacing: Theme.spacingMd;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: @tr("Quick Accent");
                    font-size: Theme.modelTitle;
                    color: Theme.textPrimary;
                }

                Text {
                    text: @tr("Instantly update the primary interactive color.");
                    font-size: Theme.caption;
                    color: Theme.textSecondary;
                }
            }

            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: Theme.spacingMd;
                    for swatch in quick-accents: TouchArea {
                        width: Theme.quickAccentSwatchSize;
                        height: Theme.quickAccentSwatchSize;
                        mouse-cursor: pointer;
                        clicked => {
                            let val-str = "rgba(" + round(swatch.r) + "," + round(swatch.g) + "," + round(swatch.b) + "," + swatch.a + ")";
                            AppCallbacks.theme_constant_changed("accent", val-str);
                        }
                        Rectangle {
                            border-radius: Theme.quickAccentSwatchSize / 2;
                            background: rgba(swatch.r, swatch.g, swatch.b, swatch.a);
                            border-width: root.active-accent.r == swatch.r && root.active-accent.g == swatch.g ? Theme.borderWidthLg : 0px;
                            border-color: Theme.textPrimary;
                        }
                    }
                }
            }
        }
    }

    PreferenceGroup {
        VerticalLayout {
            spacing: root.advanced-expanded ? Theme.spacingLg : 0px;

            // Accordion Header
            accordion_touch := TouchArea {
                height: Theme.advancedAccordionHeaderHeight;
                mouse-cursor: pointer;
                clicked => {
                    root.advanced-expanded = !root.advanced-expanded;
                }

                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: Theme.spacingXs;
                        Text {
                            text: @tr("Advanced Styling");
                            font-size: Theme.modelTitle;
                            color: Theme.textPrimary;
                        }

                        Text {
                            text: @tr("Fine-tune UI parameters. Modifying these clones/mutates the current active theme.");
                            font-size: Theme.caption;
                            color: Theme.textSecondary;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.advanced-expanded ? "▲" : "▼";
                            color: accordion_touch.has-hover ? Theme.accent : Theme.textSecondary;
                            font-size: Theme.subtitle;
                            animate color { duration: Theme.durationFast; }
                        }
                    }
                }
            }

            // Accordion Content Body
            if root.advanced-expanded: VerticalLayout {
                spacing: Theme.spacingLg;
                padding-top: Theme.paddingMd;

                for item in ThemesPageProps.theme_constants: VerticalLayout {
                    spacing: Theme.spacingMd;
                    if item.is-color: ColorTabCard {
                        title: item.name;
                        desc: @tr("Adjust the color for {}", item.name);
                        active-val: item.color-value;
                        changed(val) => {
                            let val-str = "rgba(" + round(val.r) + "," + round(val.g) + "," + round(val.b) + "," + val.a + ")";
                            AppCallbacks.theme_constant_changed(item.name, val-str);
                        }
                    }
                    if !item.is-color: NumberInputGroup {
                        title: item.name;
                        subtitle: @tr("Adjust the size for {}", item.name);
                        unit: "px";
                        value: item.value.to-float();
                        edited(v) => {
                            AppCallbacks.theme_constant_changed(item.name, v + "px");
                        }
                    }
                }
            }
        }
    }

    // SECTION 4: SAVE ACTION
    PreferenceGroup {
        VerticalLayout {
            spacing: Theme.spacingMd;
            Text {
                text: @tr("Export Theme");
                font-size: Theme.modelTitle;
                color: Theme.textPrimary;
            }

            Text {
                text: @tr("Save your current styling configuration as a new reusable preset.");
                font-size: Theme.caption;
                color: Theme.textSecondary;
                wrap: word-wrap;
            }

            ButtonGroup {
                buttons: [
                    {
                        id: "save_modal",
                        text: @tr("Save as New Theme"),
                        is-destructive: false,
                        is-neutral: false
                    }
                ];
                clicked(id) => {
                    SaveThemeState.show_modal = true;
                }
            }
        }
    }

    if (ThemesPageProps.static_preferences.length > 0): PreferenceList {
        items: ThemesPageProps.static_preferences;
    }
}
