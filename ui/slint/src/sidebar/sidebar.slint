import { SidebarHeader } from "sidebar_header.slint";
import { SidebarButton } from "sidebar_button.slint";
import { Pages, SettingsPages, Theme } from "../constants.slint";
import { WindowInfo } from "../window_info.slint";
import { AppProps } from "../props.slint";

export struct SidebarItem { text: string, icon: image, page: Pages }
export struct SettingsSidebarItem { text: string, icon: image, page: SettingsPages }

component SidebarBase inherits Rectangle {
    in property <length> sidebar_width: Theme.sidebarWidth;
    in-out property <bool> collapsed: false;

    width: root.collapsed ? Theme.sidebarCollapsedWidth : sidebar_width;
    background: @linear-gradient(180deg, Theme.secondary 0%, Theme.primary 100%);

    animate width {
        duration: 200ms;
        easing: ease-in-out;
    }

    // Border line on the right side
    Rectangle {
        x: parent.width - Theme.borderWidth;
        width: Theme.borderWidth;
        height: parent.height;
        background: Theme.divider;
    }

    VerticalLayout {
        alignment: start;
        spacing: Theme.spacingLg;

        SidebarHeader {
            collapsed: root.collapsed;
            toggle => {
                root.collapsed = !root.collapsed;
            }
        }

        VerticalLayout {
            padding-left: Theme.paddingSm;
            padding-right: Theme.paddingSm;
            spacing: Theme.spacingXxs;

            @children
        }
    }
}

export component Sidebar inherits SidebarBase {
    in property <[SidebarItem]> items: [
        { text: @tr("Songs"), icon: @image-url("../icons/songs.svg"), page: Pages.AllSongs },
        {
            text: @tr("Playlists"),
            icon: @image-url("../icons/playlists.svg"),
            page: Pages.Playlists
        },
        { text: @tr("Artists"), icon: @image-url("../icons/artists.svg"), page: Pages.Artists },
        { text: @tr("Albums"), icon: @image-url("../icons/albums.svg"), page: Pages.Albums },
        { text: @tr("Genres"), icon: @image-url("../icons/genres.svg"), page: Pages.Genres },
        { text: @tr("Explore"), icon: @image-url("../icons/explore.svg"), page: Pages.Explore },
    ];

    changed collapsed => {
        WindowInfo.sidebar-width = root.collapsed ? Theme.sidebarCollapsedWidth : Theme.sidebarWidth;
    }

    for item in root.items: SidebarButton {
        text: item.text;
        icon: item.icon;
        active: AppProps.active_page == item.page;
        collapsed: root.collapsed;
        clicked => {
            AppProps.active_page = item.page;
        }
    }
}

export component SettingsSidebar inherits SidebarBase {
    in-out property <SettingsPages> active_page: SettingsPages.Extensions;
    sidebar_width: Theme.settingsSidebarWidth;
    in property <[SettingsSidebarItem]> items: [];

    for item in root.items: SidebarButton {
        text: item.text;
        icon: item.icon;
        active: root.active_page == item.page;
        collapsed: root.collapsed;
        clicked => {
            root.active_page = item.page;
        }
    }
}
