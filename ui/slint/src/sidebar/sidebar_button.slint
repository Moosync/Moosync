import { Theme } from "../constants.slint";
import { Button } from "../common/button.slint";

export component SidebarButton inherits Button {
    in property <bool> active: false;

    has_custom_layout: true;
    height: Theme.sidebarButtonHeight;
    background: active ? Theme.accent.with-alpha(0.08) : (root.has_hover ? Theme.textPrimary.with-alpha(0.03) : transparent);
    border-radius: Theme.borderRadiusLg;

    property <color> current_color: active ? Theme.accent : (root.has_hover ? Theme.textPrimary : Theme.textSecondary);
    animate current_color {
        duration: 150ms;
        easing: ease-out;
    }

    Image {
        width: Theme.iconSizeLg;
        x: Theme.iconSizeLg;
        y: Theme.paddingMd;
        height: Theme.iconSizeLg;
        source: root.icon;
        colorize: current_color;
    }

    Text {
        text: root.text;
        color: current_color;
        font-size: Theme.subtitle;
        font-weight: active ? 600 : 500;
        vertical-alignment: center;
        x: Theme.iconSizeLg * 2 + Theme.spacingXl - Theme.borderWidth;
        y: Theme.paddingMd;
    }

    // Left indicator bar
    Rectangle {
        x: 0px;
        y: (parent.height - Theme.iconSizeXl) / 2;
        width: Theme.borderWidth * 3;
        height: active ? Theme.iconSizeXl : 0px;
        background: Theme.accent;
        border-radius: Theme.borderRadiusSm;

        animate height {
            duration: 200ms;
            easing: ease-out;
        }
    }
}
