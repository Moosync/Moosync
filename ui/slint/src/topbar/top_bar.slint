import { NavButtons } from "nav_buttons.slint";
import { SearchBar } from "search_bar.slint";
import { Theme } from "../constants.slint";
import { IconButton } from "../common/icon_button.slint";
import { AccountsPopup } from "../common/accounts_popup.slint";
import { AccountItem } from "../types/extension_view.slint";
import { AppCallbacks } from "../callbacks.slint";

export component TopBar inherits Rectangle {
    in property <bool> can_go_back: false;
    in property <bool> can_go_forward: false;
    callback settings_clicked();
    callback search-submitted(string);

    height: Theme.topbarHeight;
    background: Theme.primary; // Sampleed Topbar Background

    // Bottom border for the top bar
    Rectangle {
        y: parent.height - Theme.borderWidth;
        height: Theme.borderWidth;
        background: Theme.divider;
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            padding-left: Theme.paddingLg;
            padding-right: Theme.paddingLg;

            HorizontalLayout {
                horizontal-stretch: 1;

                NavButtons {
                    can_go_back: root.can_go_back;
                    can_go_forward: root.can_go_forward;
                    go_back => {
                        AppCallbacks.navigate_back();
                    }
                    go_forward => {
                        AppCallbacks.navigate_forward();
                    }
                }

                HorizontalLayout {
                    horizontal-stretch: 1;
                    alignment: stretch;
                    padding-right: Theme.paddingLg;
                    padding-left: Theme.paddingLg;
                    SearchBar {
                        horizontal-stretch: 1;
                        accepted(txt) => {
                            root.search-submitted(txt);
                        }
                    }
                }
            }

            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: Theme.spacingLg;

                // Profile Action
                Rectangle {
                    width: Theme.topbarIconSize;
                    height: Theme.topbarIconSize;

                    IconButton {
                        accessible-label: @tr("Accounts");
                        icon_source: @image-url("../icons/profile.svg");
                        icon_size: Theme.iconSizeLg;
                        clicked => {
                            accounts_popup.show();
                        }
                    }

                    accounts_popup := AccountsPopup {
                        x: -180px;
                        y: parent.height + 6px;
                    }
                }

                // Settings Action
                IconButton {
                    icon_source: @image-url("../icons/settings.svg");
                    icon_size: Theme.iconSizeLg;
                    clicked => {
                        root.settings_clicked();
                    }
                }
            }
        }
    }
}
