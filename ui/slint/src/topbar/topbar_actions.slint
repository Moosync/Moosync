import { Theme } from "../constants.slint";

export component TopbarAction inherits Rectangle {
    in property <string> icon-name;

    width: Theme.actionButtonSize;
    height: Theme.actionButtonSize;
    border-radius: Theme.borderRadiusMd;
    background: touch.has-hover ? Theme.textPrimary.with-alpha(0.05) : transparent;

    animate background { duration: 150ms; }

    property <color> current-color: touch.has-hover ? Theme.textPrimary : Theme.textSecondary;
    animate current-color { duration: 150ms; }

    touch := TouchArea { }

    Rectangle {
        width: Theme.iconSizeLg;
        height: Theme.iconSizeLg;

        // Profile Icon (from person_icon.rs)
        if (icon-name == "profile"): Path {
            width: Theme.iconSizeLg;
            height: Theme.iconSizeLg;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 17;
            viewbox-height: 17;
            fill: current-color;
            commands: "M1.41667 17C1.41667 17 0 17 0 15.5833C0 14.1667 1.41667 9.91667 8.5 9.91667C15.5833 9.91667 17 14.1667 17 15.5833C17 17 15.5833 17 15.5833 17H1.41667ZM8.5 8.5C9.62717 8.5 10.7082 8.05223 11.5052 7.2552C12.3022 6.45817 12.75 5.37717 12.75 4.25C12.75 3.12283 12.3022 2.04183 11.5052 1.2448C10.7082 0.447767 9.62717 0 8.5 0C7.37283 0 6.29183 0.447767 5.4948 1.2448C4.69777 2.04183 4.25 3.12283 4.25 4.25C4.25 5.37717 4.69777 6.45817 5.4948 7.2552C6.29183 8.05223 7.37283 8.5 8.5 8.5V8.5Z";
        }

        // Settings Icon (from settings_icon.rs)
        if (icon-name == "settings"): Path {
            width: Theme.iconSizeLg;
            height: Theme.iconSizeLg;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 19;
            viewbox-height: 18;
            fill: current-color;
            commands: "M17.5189 7.4481C17.4882 7.27368 17.4191 7.10836 17.3166 6.96425C17.2142 6.82013 17.0809 6.70087 16.9266 6.61519L15.4066 5.76739C15.3091 5.57744 15.2029 5.39218 15.0882 5.21219L15.1174 3.46406C15.1209 3.28718 15.0849 3.11176 15.012 2.95068C14.9392 2.78959 14.8314 2.64693 14.6966 2.53315C13.9489 1.90041 13.0953 1.40605 12.1757 1.07308C12.01 1.01253 11.8329 0.989981 11.6575 1.00708C11.482 1.02418 11.3125 1.08049 11.1615 1.1719L9.6708 2.07067C9.45832 2.0605 9.24548 2.06033 9.03298 2.07015L7.54092 1.17063C7.54092 1.17063 7.54092 1.17063 7.54092 1.17063C7.39017 1.07917 7.22095 1.02278 7.04568 1.0056C6.87041 0.988421 6.69354 1.01089 6.52804 1.07137C5.60879 1.40561 4.75589 1.90115 4.00903 2.53493C3.87402 2.64882 3.76607 2.79161 3.69309 2.95284C3.62011 3.11407 3.58395 3.28965 3.58725 3.46674L3.6165 5.21323C3.50153 5.39306 3.39496 5.57818 3.29715 5.76799L1.77591 6.61645C1.62141 6.70229 1.488 6.82179 1.38546 6.96619C1.28292 7.11058 1.21385 7.27621 1.18333 7.45093C1.01229 8.41707 1.01312 9.40603 1.18578 10.3719C1.21645 10.5463 1.28555 10.7116 1.38803 10.8557C1.49051 10.9999 1.62377 11.1191 1.77805 11.2048L3.29803 12.0526C3.39553 12.2425 3.50181 12.4278 3.6165 12.6077L3.58725 14.3558C3.58381 14.5327 3.61981 14.7081 3.69263 14.8692C3.76545 15.0303 3.87323 15.173 4.00807 15.2868C4.75577 15.9195 5.60932 16.4139 6.529 16.7469C6.69468 16.8075 6.87175 16.83 7.04722 16.8129C7.2227 16.7958 7.39214 16.7394 7.54314 16.648L9.03387 15.7493C9.24628 15.7595 9.45972 15.7597 9.67169 15.7498L11.1637 16.6493C11.3145 16.7408 11.4837 16.7972 11.659 16.8144C11.8342 16.8316 12.0111 16.8091 12.1766 16.7487C13.0959 16.4144 13.9488 15.9189 14.6956 15.2851C14.8306 15.1712 14.9386 15.0284 15.0116 14.8672C15.0846 14.706 15.1207 14.5304 15.1174 14.3533L15.0882 12.6068C15.2031 12.427 15.3097 12.2419 15.4075 12.0521L16.9288 11.2035C17.0833 11.1177 17.2167 10.9982 17.3192 10.8538C17.4217 10.7094 17.4908 10.5438 17.5213 10.3691C17.6924 9.40294 17.6915 8.414 17.5189 7.44817Z";
