export struct ContextSubMenuItem {
    action_id: string,
    title: string,
    icon: image,
}

export struct ContextMenuItem {
    action_id: string,
    title: string,
    icon: image,
    has_sub_menu: bool,
    sub_items: [ContextSubMenuItem],
}

export global ContextMenuItems {
    pure public function get_all_songs_items() -> [ContextMenuItem] {
        return [
            {
                action_id: "play_now",
                title: @tr("Play Now"),
                icon: @image-url("../icons/play.svg"),
                has_sub_menu: false,
                sub_items: [],
            },
            {
                action_id: "play_next",
                title: @tr("Play Next"),
                icon: @image-url(""),
                has_sub_menu: false,
                sub_items: [],
            },
            {
                action_id: "clear_queue_and_play",
                title: @tr("Clear queue and play"),
                icon: @image-url(""),
                has_sub_menu: false,
                sub_items: [],
            },
            {
                action_id: "add_to_queue",
                title: @tr("Add to Queue"),
                icon: @image-url("../icons/add_to_queue.svg"),
                has_sub_menu: false,
                sub_items: [],
            },
        ];
    }

    pure public function get_queue_items() -> [ContextMenuItem] {
