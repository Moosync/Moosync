export enum ProviderScope {
    search,
    playlists,
    playlist_songs,
    artist_songs,
    album_songs,
    recommendations,
    scrobble,
    playback_details,
    lyrics,
    song_context_menu,
    playlist_context_menu,
    accounts,
    database_song_events,
    database_playlist_events,
    player_ui_events,
    player_data_events,
    cover_art,
    player_provider,
}

export struct ExtensionPathPermission {
    source: string,
    target: string,
    justification: string,
}

export struct ExtensionHostPermission {
    host: string,
    justification: string,
}

export struct ExtensionBinaryPermission {
    name: string,
    hashes: string,
    justification: string,
}

export struct ExtensionScopePermission {
    scope: ProviderScope,
    justification: string,
}

export struct ExtensionItem {
    name: string,
    package_name: string,
    version: string,
    is_installed: bool,
    loading: bool,
    description: string,
    icon: image,
    has_started: bool,
    icon_url: string,
    registry: string,
    author: string,
    network_permissions: [ExtensionHostPermission],
    filesystem_permissions: [ExtensionPathPermission],
    binaries_permissions: [ExtensionBinaryPermission],
    scopes: [ExtensionScopePermission],
    error: string,
}

export struct ExtensionProviderItem {
    id: string,
    name: string,
    enabled: bool,
}

export struct AccountItem {
    id: string,
    package_name: string,
    name: string,
    bg_color: color,
    icon: image,
    logged_in: bool,
    username: string,
}
